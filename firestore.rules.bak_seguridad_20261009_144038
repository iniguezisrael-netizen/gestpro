rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.rol;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    // Solo cuentas con un rol válido asignado en roles/{uid} pueden usar la app.
    function hasValidRole() {
      return isSignedIn() && myRole() in ['admin', 'secretaria', 'auxiliar', 'almacen'];
    }
    // Roles con acceso a módulos comerciales y financieros
    function isComercial() {
      return isSignedIn() && myRole() in ['admin', 'secretaria', 'auxiliar'];
    }
    // Roles con acceso a gestión administrativa completa
    function isAdminOrSecretaria() {
      return isSignedIn() && myRole() in ['admin', 'secretaria'];
    }
    // Roles con acceso a editar inventario de materia prima (incluye almacenista)
    function isInventarioEdit() {
      return isSignedIn() && myRole() in ['admin', 'secretaria', 'auxiliar', 'almacen'];
    }

    // Roles: cada usuario solo puede leer su propio rol; el admin puede leer/escribir todos.
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Colección antigua (contenía contraseñas en texto plano) — bloqueada por completo.
    match /users/{doc} {
      allow read, write: if false;
    }

    // ── MÓDULOS FINANCIEROS Y COMERCIALES ───────────────────────────────────
    // Lectura: cualquier rol válido (para dashboard y reportes).
    // Escritura: solo roles comerciales (admin, secretaria, auxiliar).
    // almacen NO puede crear/editar ventas, pedidos, caja, facturas ni cobranza.
    match /ventas/{doc=**}       { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /cotizaciones/{doc=**} { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /cajas/{doc=**}        { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /cobranza/{doc=**}     { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /facturas/{doc=**}     { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /clientesCredito/{doc=**} { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /clientes/{doc=**}     { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /reparaciones/{doc=**} { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /entregas/{doc=**}     { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /agenda/{doc=**}       { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /ordenesCompra/{doc=**} { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /proveedores/{doc=**}  { allow read: if hasValidRole(); allow write: if isComercial(); }

    // Producción y vehículos: acceso comercial
    match /produccion/{doc=**}   { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /vehiculos/{doc=**}    { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /reportesEntrega/{doc=**}    { allow read: if hasValidRole(); allow write: if isComercial(); }
    match /reportesProduccion/{doc=**} { allow read: if hasValidRole(); allow write: if isComercial(); }

    // ── INVENTARIOS ──────────────────────────────────────────────────────────
    // Todos los roles pueden leer y escribir inventario, herramientas y checador.
    match /materia/{doc=**}              { allow read: if hasValidRole(); allow write: if isInventarioEdit(); }
    match /productos/{doc=**}            { allow read, write: if hasValidRole(); }
    match /consignacion/{doc=**}         { allow read, write: if hasValidRole(); }
    match /catConsig/{doc=**}            { allow read, write: if hasValidRole(); }
    match /bodegas/{doc=**}              { allow read, write: if hasValidRole(); }
    match /catalogoMateriales/{doc=**}   { allow read, write: if hasValidRole(); }
    match /herramientas/{doc=**}         { allow read, write: if hasValidRole(); }
    match /herramientasAsignadas/{doc=**} { allow read, write: if hasValidRole(); }
    match /herramientasHistorial/{doc=**} { allow read, write: if hasValidRole(); }
    match /checadas/{doc=**}             { allow read, write: if hasValidRole(); }
    match /checadorConfig/{doc=**}       { allow read, write: if hasValidRole(); }
    match /entregaInsumos/{doc=**}       { allow read, write: if hasValidRole(); }

    // ── META Y CONFIGURACIÓN ─────────────────────────────────────────────────
    // _meta/loginInfo: contiene adminEmail para el flujo de login. Público en lectura.
    match /_meta/loginInfo { allow read: if true; allow write: if isAdmin(); }
    // _meta/config y demás docs de _meta: protegidos, requieren rol válido.
    match /_meta/{doc}  { allow read: if hasValidRole(); allow write: if isAdmin(); }

    // Bitácora de actividad: cualquier rol válido puede escribir; solo admin puede leer.

    // Log de accesos (logins): cualquier sesión autenticada puede escribir; solo admin lee.
    match /_logs/{doc} { allow read: if isAdmin(); allow write: if isSignedIn(); }
    match /bitacora/{doc} { allow read: if isAdmin(); allow write: if hasValidRole(); }

    // Configuración de empresa (cuenta, tarjeta, CLABE): todos los roles la necesitan para generar PDFs.
    // Solo admin puede modificarla.
    match /_config/{doc} { allow read: if hasValidRole(); allow write: if isAdmin(); }

    // Respaldos automáticos: solo admin puede leer/escribir.
    match /_backups/{doc} { allow read, write: if isAdmin(); }

    // Cualquier otra colección no listada arriba: denegada por defecto.
  }
}
