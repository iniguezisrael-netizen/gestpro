rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Backups: solo el administrador puede leer o escribir.
    match /backups/{fileName} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.rol == 'admin';
    }
    // Fotos de ventas, cotizaciones, etc: cualquier usuario con sesión iniciada.
    // Límite de 10MB por archivo para evitar abuso de almacenamiento.
    match /fotos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size <= 10 * 1024 * 1024;
    }
    // Facturas (XML/PDF): cualquier usuario con sesión iniciada, máximo 10MB.
    match /facturas/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size <= 10 * 1024 * 1024;
    }
    // Cualquier otra ruta no listada: denegada por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
