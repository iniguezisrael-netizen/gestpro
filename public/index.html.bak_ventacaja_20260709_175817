async function _autorizarEliminarPago(id, idx) {
  const adminUser = document.getElementById('pago-admin-user')?.value || '';
  const adminPass = document.getElementById('pago-admin-pass')?.value || '';
  const errEl = document.getElementById('pago-pass-error');
  const btn = document.querySelector('#modal .btn-danger');
  if (btn) btn.disabled = true;
  const ok = await verificarPasswordAdmin(adminUser, adminPass);
  if (btn) btn.disabled = false;
  if (!ok) { if (errEl) errEl.style.display = 'block'; return; }
  _aplicarEliminarPago(id, idx);
}
