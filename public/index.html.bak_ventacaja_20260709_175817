// Colecciones de Firestore
const FS_COLLECTIONS = ['materia','productos','consignacion','ventas','cotizaciones','cajas','reparaciones','bodegas','entregas','facturas','cobranza','vehiculos','produccion','catalogoMateriales','clientesCredito','clientes'];
