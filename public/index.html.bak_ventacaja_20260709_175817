// Redimensiona y comprime imagen antes de guardar en la nube.
function comprimirImagen(file, callback) {
  const MAX_DIM = 1000; // px — suficiente para mostrar en pantalla y PDFs
  const CALIDAD = 0.75; // calidad JPEG — buen balance calidad/peso
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      let { width, height } = img;
      if (width > MAX_DIM || height > MAX_DIM) {
        if (width >= height) { height = Math.round(height * (MAX_DIM / width)); width = MAX_DIM; }
        else { width = Math.round(width * (MAX_DIM / height)); height = MAX_DIM; }
      }
      const canvas = document.createElement('canvas');
      canvas.width = width; canvas.height = height;
      canvas.getContext('2d').drawImage(img, 0, 0, width, height);
      try { callback(canvas.toDataURL('image/jpeg', CALIDAD)); }
      catch(err) { callback(e.target.result); }
    };
    img.onerror = () => callback(e.target.result);
    img.src = e.target.result;
  };
  reader.onerror = () => callback(null);
  reader.readAsDataURL(file);
}

// ===================== SUBIDA DE FOTOS A FIREBASE STORAGE =====================
// Convierte un data URL (base64) en un Blob para poder subirlo a Storage.
function _dataUrlABlob(dataUrl) {
  const partes = dataUrl.split(',');
  const mimeMatch = partes[0].match(/:(.*?);/);
  const mime = mimeMatch ? mimeMatch[1] : 'image/jpeg';
  const bstr = atob(partes[1]);
  let n = bstr.length;
  const u8arr = new Uint8Array(n);
  while (n--) u8arr[n] = bstr.charCodeAt(n);
  return new Blob([u8arr], { type: mime });
}

// Sube una imagen (ya comprimida, como data URL) a Firebase Storage y entrega
// la URL pública de descarga al callback. Si Storage no está disponible o algo
// Si hay internet sube a Storage; si no, guarda base64 localmente y sincroniza al reconectarse.
function subirFotoAStorage(dataUrl, carpeta, callback) {
  if (!storage || !navigator.onLine) { callback(dataUrl); return; }
  try {
    const blob = _dataUrlABlob(dataUrl);
    const nombre = 'foto_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8) + '.jpg';
    const ref = storage.ref().child('fotos/' + carpeta + '/' + nombre);
    ref.put(blob)
      .then(snap => snap.ref.getDownloadURL())
      .then(url => callback(url))
      .catch(err => { console.error('Error subiendo foto a Storage (se usa respaldo local):', err); callback(dataUrl); });
  } catch (err) {
    console.error('Error preparando la foto para subir (se usa respaldo local):', err);
    callback(dataUrl);
  }
}

// Sincronización automática de fotos offline (base64 → Storage) al reconectarse.
// Devuelve una Promise que resuelve cuando todas las fotos pendientes han sido procesadas.
const _COLS_CON_FOTOS = ['consignacion','productos','materia','ventas','cotizaciones'];
function sincronizarFotosPendientes() {
  if (!storage || !navigator.onLine) return Promise.resolve();
  const promesas = [];
  _COLS_CON_FOTOS.forEach(col => {
    const items = db[col] || [];
    items.forEach(item => {
      if (!item.fotos || !item.fotos.length) return;
      if (!item.fotos.some(f => f && f.startsWith('data:'))) return;
      const nuevasFotos = [...item.fotos];
      const uploadsDeEsteItem = nuevasFotos.map((f, i) => {
        if (!f || !f.startsWith('data:')) return Promise.resolve();
        return new Promise(resolve => {
          subirFotoAStorage(f, col, url => {
            nuevasFotos[i] = url;
            resolve();
          });
        });
      });
      const itemPromise = Promise.all(uploadsDeEsteItem).then(() => {
        item.fotos = nuevasFotos;
        saveDb(col);
        console.log(`Fotos sincronizadas para ${col} id=${item.id}`);
      });
      promesas.push(itemPromise);
    });
  });
  return Promise.all(promesas);
}
window.addEventListener('online', () => {
  setSyncStatus('syncing');
  // Espera 2s a que la conexión estabilice, luego sincroniza datos y fotos pendientes
  setTimeout(async () => {
    // SAFEGUARD: no subir si la app aún no cargó datos desde Firestore
    // Esto evita sobreescribir Firestore con datos vacíos durante la carga inicial
    if (!_appReady) {
      console.warn('[online] App no lista aún — omitiendo sync para no sobreescribir Firestore');
      setSyncStatus('ok');
      return;
    }
    let syncOk = true;
    // Reenviar datos a Firestore — solo colecciones que tienen datos (safeguard contra vacíos)
    if (FIREBASE_ENABLED && firestore) {
      try {
        // Solo subir colecciones con al menos 1 elemento, o donde _hasPendingSync es true
        const colsASubir = FS_COLLECTIONS.filter(c => _hasPendingSync || (db[c] && db[c].length > 0));
        if (colsASubir.length > 0) {
          await Promise.all(colsASubir.map(c => fsWriteCollection(c, db[c])));
        }
      } catch(e) {
        syncOk = false;
        setSyncStatus('error', e && e.message ? e.message : String(e));
      }
    }
    // Subir fotos que quedaron como base64
    await sincronizarFotosPendientes();
    // Verificar si aún quedan fotos base64 pendientes
    const hayFotosPendientes = _COLS_CON_FOTOS.some(col =>
      (db[col] || []).some(item => (item.fotos || []).some(f => f && f.startsWith('data:')))
    );
    if (syncOk && !hayFotosPendientes) {
      _hasPendingSync = false;
      setSyncStatus('ok');
    }
  }, 2000);
});

window.addEventListener('offline', () => {
  setSyncStatus('offline');
});

// Declaración del flag de sincronización pendiente
let _hasPendingSync = false;
// Flag: la app terminó de cargar datos desde Firestore — evita subir datos vacíos antes de tiempo
let _appReady = false;

// Notificación de sincronización completa (más visible que un toast)
function mostrarNotificacionSync(msg) {
  let el = document.getElementById('sync-notif');
  if (!el) {
    el = document.createElement('div');
    el.id = 'sync-notif';
    el.style.cssText = `
      position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
      background:#15803d; color:#fff; padding:14px 24px; border-radius:12px;
      font-size:0.95rem; font-weight:600; z-index:99999; box-shadow:0 4px 20px rgba(0,0,0,0.3);
      display:flex; align-items:center; gap:10px; max-width:90vw; text-align:center;
      animation: slideUp 0.3s ease;
    `;
    document.body.appendChild(el);
  }
  el.textContent = msg;
  el.style.display = 'flex';
  clearTimeout(el._timer);
  el._timer = setTimeout(() => { el.style.display = 'none'; }, 8000);
}
window['mostrarNotificacionSync'] = mostrarNotificacionSync;

let _fotosSubiendo = 0;
let _fotoSession = 0;

function handleFotoUpload(event) {
  const files = Array.from(event.target.files);
  event.target.value = '';
  const token = _fotoSession;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSession !== token) return;
      _fotosSubiendo++; renderFotosPreview();
      subirFotoAStorage(dataUrl, 'inventario', url => {
        if (_fotoSession !== token) return;
        _fotosSubiendo--; _tempFotos.push(url); renderFotosPreview();
      });
    });
  });
}

function handleFotoDrop(event) {
  event.preventDefault();
  event.currentTarget.classList.remove('drag-over');
  const files = Array.from(event.dataTransfer.files || []).filter(f => f.type.startsWith('image/'));
  if (!files.length) return;
  const token = _fotoSession;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSession !== token) return;
      _fotosSubiendo++; renderFotosPreview();
      subirFotoAStorage(dataUrl, 'inventario', url => {
        if (_fotoSession !== token) return;
        _fotosSubiendo--; _tempFotos.push(url); renderFotosPreview();
      });
    });
  });
}

function renderFotosPreview() {
  const c = document.getElementById('fotos-preview-list');
  if (!c) return;
  c.innerHTML = _tempFotos.map((src, idx) => `
    <div class="foto-prev-wrap">
      <img src="${src}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer" onclick="openLightboxSrc('${src}')" />
      <button class="foto-prev-del" onclick="_tempFotos.splice(${idx},1);renderFotosPreview()">✕</button>
    </div>`).join('') + (_fotosSubiendo > 0 ? `<div style="display:flex;align-items:center;color:#64748b;font-size:0.78rem;padding:8px">⏳ Subiendo ${_fotosSubiendo} foto(s)...</div>` : '');
}

function saveItem(tipo, id) {
  const codigo = v('m-codigo');
  const nombre = tipo === 'materia' ? v('m-nombre') : (v('m-nombre') || codigo);
  if (!codigo || !nombre) { alert('Código y nombre son obligatorios'); return; }
  if (tipo === 'productos' && id && session.rol !== 'admin') {
    const actual = db[tipo].find(i => i.id === id);
    const nuevaCantidad = +v('m-cantidad');
    if (actual && nuevaCantidad < actual.cantidad) {
      alert('Solo el administrador puede dar de baja productos terminados manualmente. Para reducir el inventario, el producto debe venderse.');
      return;
    }
  }
  const obj = {
    id: id || sid(), codigo, nombre,
    barcode: tipo === 'materia' ? v('m-barcode').trim() : codigo,
    clienteNombre: v('m-cnombre'),
    clienteApellido: v('m-capellido'),
    clienteEmpresa: v('m-cempresa'),
    categoria: v('m-categoria'),
    ubicacion: tipo === 'materia' ? v('m-ubicacion') : (id ? db[tipo].find(i=>i.id===id)?.ubicacion : ''),
    cantidad: +v('m-cantidad'),
    unidad: v('m-unidad') || 'pza',
    // Costo y precio público solo los puede definir el administrador; si el campo no
    // se renderizó (otros roles), conservamos el valor que ya tenía el artículo.
    precio: session.rol === 'admin' ? round2(v('m-precio')) : round2(id ? (db[tipo].find(i=>i.id===id)?.precio || 0) : 0),
    precioPublico: session.rol === 'admin' ? round2(v('m-precio-pub')) : round2(id ? (db[tipo].find(i=>i.id===id)?.precioPublico || 0) : 0),
    minimo: +v('m-minimo') || 5,
    sinMinimo: document.getElementById('m-sinminimo')?.checked || false,
    desc: v('m-desc'),
    ...(tipo === 'productos' ? {
      especUnidad: v('m-eunidad'), especTipo: v('m-etipo'),
      especForro: v('m-eforro'), especColor: v('m-ecolor'),
      especObservaciones: v('m-eobs')
    } : (id ? (({especUnidad,especTipo,especForro,especColor,especObservaciones}) => ({especUnidad,especTipo,especForro,especColor,especObservaciones}))(db[tipo].find(i=>i.id===id)||{}) : {})),
    fotos: [..._tempFotos],
    ...(tipo === 'materia' && session.rol === 'admin' ? {
      empresa: v('m-empresa') || '',
      vendedor: v('m-vendedor') || '',
      tel: v('m-tel') || '',
      cel: v('m-cel') || ''
    } : (id && tipo === 'materia' ? (({empresa,vendedor,tel,cel}) => ({empresa:empresa||'',vendedor:vendedor||'',tel:tel||'',cel:cel||''}))(db[tipo].find(i=>i.id===id)||{}) : {}))
  };
  if (id) { const idx = db[tipo].findIndex(i => i.id === id); db[tipo][idx] = obj; }
  else db[tipo].push(obj);
  saveDb(tipo); closeModal(); renderInventario(tipo);
}

function delItem(tipo, id) {
  if (!confirm('¿Eliminar este registro?')) return;
  db[tipo] = db[tipo].filter(i => i.id !== id);
  saveDb(tipo); renderInventario(tipo);
}

