function agregarProduccionManual() {
  if (!can(ROLES_PRODUCCION)) return;
  const yaEnSeguimiento = new Set((db.produccion||[]).map(p => String(p.ventaId)));
  const pedidos = (db.ventas||[]).filter(v => v.esPedido && v.estado !== 'Cancelada' && !yaEnSeguimiento.has(String(v.id)));
