          <input id="oc-tel" placeholder="378-100-0000" />
        </div>
      </div>
      <div class="form-group" style="margin-bottom:8px">
        <label>Número de pedido o factura</label>
        <input id="oc-pedido" value="${esc(folio)}" placeholder="Ej. F-1024 / PED-203" />
      </div>
      <div class="form-group" style="margin-bottom:${requierePass?'8px':'0'}">
        <label>Tiempo del crédito</label>
        <input id="oc-credito" placeholder="Ej. 30 días, 2 quincenas, contado..." />
      </div>
      ${requierePass ? `
      <p style="font-size:0.85rem;color:#475569;margin:10px 0 8px">
        Solo un <strong>administrador</strong> puede otorgar crédito a este cliente por primera vez.
        Solicita a un administrador que escriba aquí su usuario y contraseña para autorizarlo.
      </p>
      <div class="form-group" style="margin-bottom:8px">
        <label>Usuario administrador</label>
        <input id="oc-admin-user" type="text" placeholder="usuario..." autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" />
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label>Contraseña de administrador</label>
        <div style="position:relative">
        <input id="oc-admin-pass" type="text" placeholder="Contraseña..." autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" style="padding-right:38px;-webkit-text-security:disc;text-security:disc"
          onkeydown="if(event.key==='Enter')_autorizarCredito(${id})" />
        <button type="button" onclick="toggleVerPass('oc-admin-pass',this)" title="Mostrar/ocultar contraseña" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:1rem;padding:4px">👁️</button>
        </div>
      </div>
      <p id="oc-pass-error" style="color:#dc2626;font-size:0.82rem;margin-top:8px;display:none">Usuario o contraseña incorrectos, o el usuario no es administrador</p>
      ` : ''}
    </div>
  `, [
    requierePass
      ? { label:'🔒 Autorizar y otorgar crédito', cls:'btn-danger', action:()=>_autorizarCredito(id) }
      : { label:'🏦 Otorgar crédito', cls:'btn-primary', action:()=>_aplicarCredito(id) },
