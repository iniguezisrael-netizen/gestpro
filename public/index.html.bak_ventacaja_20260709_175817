        <label>Hora del pago</label>
        <input id="pago-hora" type="text" value="${esc(horaAhora)}" readonly disabled style="background:#f1f5f9;color:#64748b" />
      </div>
      <div class="form-group">
        <label>Forma de pago</label>
        <select id="pago-forma" onchange="document.getElementById('pago-forma-hint').style.display = this.value==='efectivo' ? '' : 'none'">${_optionsFormaPago('efectivo')}</select>
        <small id="pago-forma-hint" style="color:#94a3b8">Solo el efectivo se refleja en tu caja chica; cheque, transferencia o tarjeta no, porque el usuario no recibe el dinero físicamente.</small>
      </div>
      <div class="form-group">
        <label>Nota (opcional)</label>
