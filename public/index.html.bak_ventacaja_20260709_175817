// Muestra en un modal todas las compras (ventas/pedidos) y cotizaciones de un
// cliente, junto con la nota/descripción de lo que pidió en cada una.
function verComprasCliente(id) {
  const c = findById(db.clientes, id);
  if (!c) { alert('Cliente no encontrado.'); return; }
  const cel = _limpiarTel(c.celular), tel = _limpiarTel(c.telfijo);
  const mail = (c.correo||'').trim().toLowerCase();
  const coincide = (vCel, vTel, vMail) => {
    const cv = _limpiarTel(vCel), tv = _limpiarTel(vTel), mv = (vMail||'').trim().toLowerCase();
    return (cel && cel.length>=8 && cv===cel) || (tel && tel.length>=8 && tv===tel) || (mail && mv===mail);
  };
  const ventas = (db.ventas||[]).filter(vt => coincide(vt.ctCelular||vt.celular, vt.ctTelFijo||vt.telefono, vt.ctCorreo||vt.correo));
  const cotiz = (db.cotizaciones||[]).filter(cz => coincide(cz.ctCelular, cz.ctTelFijo, cz.ctCorreo));
  const notaDe = (it) => {
    if (it.observaciones) return it.observaciones.replace(/\n/g,'<br>');
    if (it.items && it.items.length) return it.items.map(i=>i.producto||i.descripcion||i.desc||i.nombre||i.concepto||'').filter(Boolean).join('<br>');
    return '—';
  };
  const filas = (arr, tipo) => arr.slice().sort((a,b)=>(b.fecha||'').localeCompare(a.fecha||'')).map(it => `
    <tr>
      <td><span class="badge ${tipo==='Pedido/Venta'?'badge-green':'badge-blue'}">${tipo}</span></td>
      <td>${it.fecha?fechaLarga(it.fecha):'-'}</td>
      <td>#${esc(it.folioPedido || it.id || '-')}</td>
      <td style="max-width:320px">${notaDe(it)}</td>
      <td><strong>${it.total!=null?('$'+fmt(it.total)):'-'}</strong></td>
    </tr>`).join('');
  const filasTotal = filas(ventas, 'Pedido/Venta') + filas(cotiz, 'Cotización');
  showModal(`📝 Compras de ${[c.nombre,c.apellido].filter(Boolean).join(' ')}`, `
    <div class="table-wrap"><table>
      <tr><th>Tipo</th><th>Fecha</th><th>Folio</th><th>Nota / Productos</th><th>Total</th></tr>
      ${filasTotal || '<tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:16px">Sin compras o cotizaciones registradas para este cliente.</td></tr>'}
    </table></div>
  `, [{ label:'Cerrar', cls:'btn-secondary', action: closeModal }]);
}
