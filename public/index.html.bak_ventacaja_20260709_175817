  const opciones = pedidos.map(v => `<option value="${esc(v.id)}">${esc(v.folioPedido||('#'+v.id))} — ${esc(v.cliente||'')}</option>`).join('');
  showModal('+ Agregar Pedido a Producción', `
    <div class="form-group">
      <label>Número de pedido</label>
      <select id="ap-pedido" class="form-control">
        <option value="">-- Selecciona un pedido --</option>
        ${opciones}
      </select>
    </div>
  `, [
    { label:'✅ Agregar', cls:'btn-primary', action: _guardarProduccionManual },
    { label:'Cancelar', cls:'btn-secondary', action:closeModal }
  ]);
}
window['agregarProduccionManual'] = agregarProduccionManual;

