// Cargar todos los datos desde Firestore al iniciar sesión
async function loadFromFirebase() {
  if (!FIREBASE_ENABLED || !firestore) return;
  setSyncStatus('syncing');
  try {
    const results = await Promise.all(FS_COLLECTIONS.map(c => fsReadCollection(c)));
    const pendingUploads = []; // colecciones con datos locales no subidos
    FS_COLLECTIONS.forEach((c, i) => {
      if (results[i] !== null) {
        const serverItems = results[i];
        const localItems = db[c] || [];
        // Fusionar: conservar items locales que el servidor no tiene (capturados offline)
        const serverIds = new Set(serverItems.map(x => x && x.id).filter(Boolean));
        const soloLocales = localItems.filter(x => x && x.id && !serverIds.has(x.id));
        if (soloLocales.length > 0) {
          console.log(`[offline-merge] ${c}: ${soloLocales.length} item(s) locales no subidos — fusionando`);
          db[c] = [...serverItems, ...soloLocales];
          pendingUploads.push(c);
        } else {
          db[c] = serverItems;
        }
        save('gp_' + c, db[c]);
      }
    });
    // Subir colecciones con datos pendientes de sync
    if (pendingUploads.length > 0) {
      console.log('[offline-merge] Subiendo datos pendientes:', pendingUploads);
      await Promise.all(pendingUploads.map(c => fsWriteCollection(c, db[c])));
    }
    const remoteNextId = await fsReadNextId();
    if (remoteNextId !== null && remoteNextId > nextId) {
      nextId = remoteNextId;
      save('gp_nextid', nextId);
    }
    // Llenar el pool de IDs al inicio (lo hace en background sin bloquear)
    _refillIdPool().catch(() => {});
    // Si hay fotos guardadas como base64 (capturadas offline), subirlas ahora
    const hayFotosBase64 = _COLS_CON_FOTOS.some(col =>
      (db[col] || []).some(item => (item.fotos || []).some(f => f && f.startsWith('data:')))
    );
    if (hayFotosBase64) {
      console.log('[offline-merge] Sincronizando fotos pendientes...');
      await sincronizarFotosPendientes();
    }
    _appReady = true; // la app ya cargó — ahora sí se puede sincronizar de regreso
    setSyncStatus('ok');
    console.log('Datos cargados desde Firebase ✓');
    _iniciarRespaldoAutomatico();
  } catch(e) {
    _appReady = true; // aun con error, permitir sync posterior
    console.error('Error cargando Firebase:', e);
    setSyncStatus('error');
    _iniciarRespaldoAutomatico();
  }
}

// ── RESPALDO AUTOMÁTICO CADA 6 HORAS ──
let _respaldoTimer = null;
function _iniciarRespaldoAutomatico() {
  if (_respaldoTimer) return; // ya corriendo
  const INTERVALO = 6 * 60 * 60 * 1000; // 6 horas en ms
  function _hacerRespaldo() {
    try {
      const FS_COL_KEYS = ['users','materia','productos','consignacion','ventas','cotizaciones',
        'cajas','reparaciones','produccion','catalogoMateriales','cobranza','clientesCredito',
        'clientes','bodegas','entregas','facturas','vehiculos'];
      const exportData = {};
      FS_COL_KEYS.forEach(k => { exportData[k] = db[k] || []; });
      exportData._exportadoEn = new Date().toISOString();
      const blob = new Blob([JSON.stringify(exportData)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      const ts = new Date().toISOString().slice(0,16).replace('T','_').replace(':','-');
      a.download = `gestpro-backup-${ts}.json`;
      a.click();
      URL.revokeObjectURL(url);
      console.log('[AutoBackup] Respaldo automático generado:', a.download);
    } catch(e) { console.error('[AutoBackup] Error:', e); }
  }
  // Primera vez: a los 5 minutos de cargar (no molestar al inicio)
  setTimeout(() => {
    _hacerRespaldo();
    _respaldoTimer = setInterval(_hacerRespaldo, INTERVALO);
  }, 5 * 60 * 1000);
  console.log('[AutoBackup] Respaldo automático activado — cada 6 horas');
}

// Listener en tiempo real — detecta cambios de otras sesiones
function startRealtimeSync() {
  if (!FIREBASE_ENABLED || !firestore) return;
  // Desuscribir listeners anteriores
  _syncUnsubscribers.forEach(u => u());
  _syncUnsubscribers = [];
  FS_COLLECTIONS.forEach(colName => {
    const unsub = firestore.collection(colName).doc('data').onSnapshot(snap => {
      if (!snap.exists) return;
      const remote = snap.data();
      const esEscritoraPropia = remote.writerId && remote.writerId === _mySessionId;
      // Siempre actualizar db local con el estado real de Firestore.
      // Antes se hacía early-return si era escritura propia, pero eso causaba que
      // un snapshot intermedio dejara el db local desactualizado (race condition).
      db[colName] = remote.items || [];
      save('gp_' + colName, db[colName]);
      // Actualizar nextId si hay registros con id mayor (evita IDs duplicados entre dispositivos)
      const maxRemoteId = Math.max(0, ...db[colName].map(x => (typeof x.id === 'number' ? x.id : 0)));
      if (maxRemoteId >= nextId) {
        nextId = maxRemoteId + 1;
        save('gp_nextid', nextId);
      }
      // Toast inteligente: solo avisar si el cambio viene de OTRA sesión
      if (!esEscritoraPropia) {
        const modalAbierto = document.getElementById('modal-overlay')?.classList.contains('open');
        if (modalAbierto && _modalEditingCol === colName) {
          let afecta = false;
          if (_modalEditingId) {
            const remoteItem = (remote.items||[]).find(x => x.id == _modalEditingId);
            const localItem  = (db[colName]||[]).find(x => x.id == _modalEditingId);
            afecta = remoteItem && JSON.stringify(remoteItem) !== JSON.stringify(localItem);
          } else {
            afecta = true;
          }
          if (afecta) _mostrarToastSync();
        }
      }
      // Re-renderizar página actual si corresponde
      if (currentPage) renderPage(currentPage);
    }, err => { console.warn('Sync listener error:', colName, err); });
    _syncUnsubscribers.push(unsub);
  });
  console.log('Sync en tiempo real activo ✓');
}

let _syncToastTimer = null;
function _mostrarToastSync() {
  const toast = document.getElementById('sync-toast');
  if (!toast) return;
  toast.classList.add('show');
  clearTimeout(_syncToastTimer);
  _syncToastTimer = setTimeout(() => toast.classList.remove('show'), 7000);
}

