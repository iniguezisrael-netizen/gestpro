function marcarCobranzaRecHecho(id) {
  const c = db.cobranza.find(x=>x.id===id);
  if (!c) return;
  c.recHecho = true;
  saveDb('cobranza');
  renderCobranza();
}

function delCobranza(id) {
  const c = db.cobranza.find(x=>x.id===id);
  if (!c) return;
  if (c.estado !== 'Pagado') {
    alert('Este registro no se puede cancelar todavía.\n\nLa cuenta de "' + c.cliente + '" debe quedar marcada como "Pagado" antes de poder eliminarse.');
    return;
  }
  if (!confirm('¿Eliminar el registro de cobranza de "' + c.cliente + '"? Esta cuenta ya está marcada como pagada.')) return;
  db.cobranza = db.cobranza.filter(x=>x.id!==id);
  save('gp_cobranza', db.cobranza); // localStorage
  if (FIREBASE_ENABLED) fsDeleteFromCollection('cobranza', id); // Firestore directo, sin merge
  renderCobranza();
}

// ===================== CONTROL DE VEHÍCULOS =====================
// Acceso: solo lo ven Administrador, Secretaria Administrativa y Auxiliar Administrativo.
// Modificar (agregar/editar/eliminar): solo Administrador y Secretaria Administrativa.
// El Auxiliar Administrativo solo puede consultarlo (sin botones de edición).
function canVerVehiculos() { return can(['admin','secretaria','auxiliar']); }
function canEditarVehiculos() { return can(['admin','secretaria']); }

function renderVehiculos() {
  const el = document.getElementById('page-vehiculos');
  if (!canVerVehiculos()) {
    el.innerHTML = '<p style="padding:20px;color:#94a3b8">Acceso restringido. Esta sección solo está disponible para Administrador, Secretaria Administrativa y Auxiliar Administrativo.</p>';
    return;
  }
  const puedeEditar = canEditarVehiculos();
  const vs = db.vehiculos.slice().reverse();

  el.innerHTML = `
    <div class="card">
      <div class="card-header">
        <span class="card-title">🚐 Control de Vehículos</span>
        ${puedeEditar ? `<button class="btn btn-primary btn-sm" onclick="openVehiculoModal()">+ Agregar Vehículo</button>` : `<span style="font-size:0.78rem;color:#94a3b8">Solo lectura — el Auxiliar Administrativo no puede modificar este módulo</span>`}
      </div>
      <div class="search-bar"><input type="text" placeholder="Buscar por nombre del vehículo o número de póliza..." oninput="filterTable(this,'tbl-veh')" /></div>
      <div class="table-wrap"><table id="tbl-veh">
        <tr><th>Vehículo</th><th>Última Afinación</th><th>Kilometraje</th><th>Recordatorio Afinación</th><th>Núm. de Póliza</th><th>Vencimiento de Póliza</th><th>Recordatorio Póliza</th>${puedeEditar?'<th>Acc.</th>':''}</tr>
        ${vs.length ? vs.map(ve => {
          const afHoy = ve.recAfinacion && ve.recAfinacionFecha && !ve.recAfinacionHecho && ve.recAfinacionFecha === today();
          const afVencido = ve.recAfinacion && ve.recAfinacionFecha && !ve.recAfinacionHecho && ve.recAfinacionFecha < today();
          const polHoy = ve.recPoliza && ve.vencimiento && !ve.recPolizaHecho && ve.vencimiento === today();
          const polVencido = ve.recPoliza && ve.vencimiento && !ve.recPolizaHecho && ve.vencimiento < today();
          return `<tr data-search="${esc((ve.nombre+' '+(ve.poliza||'')).toLowerCase())}">
          <td><strong>${esc(ve.nombre)}</strong></td>
          <td>${ve.afinacionFecha || '-'}</td>
          <td>${ve.kilometraje ? fmt(ve.kilometraje) + ' km' : '-'}</td>
          <td style="min-width:150px">${ve.recAfinacion && ve.recAfinacionFecha ? `
            <div>
              <span class="badge ${ve.recAfinacionHecho?'badge-gray':afVencido?'badge-red':afHoy?'badge-yellow':'badge-blue'}">${ve.recAfinacionHecho?'✓ Atendido':afVencido?'⚠️ Vencido '+ve.recAfinacionFecha:afHoy?'📅 Hoy':'🔔 '+ve.recAfinacionFecha}</span>
              ${!ve.recAfinacionHecho && puedeEditar ? `<button onclick="marcarVehiculoRec(${ve.id},'recAfinacionHecho')" style="margin-top:4px;display:block;background:#16a34a;color:white;border:none;border-radius:6px;padding:2px 8px;font-size:0.72rem;cursor:pointer">✓ Marcar hecho</button>`:''}
            </div>` : '<span style="color:#94a3b8;font-size:0.78rem">Sin recordatorio</span>'}
          </td>
          <td>${esc(ve.poliza || '-')}</td>
          <td>${esc(ve.vencimiento || '-')}</td>
          <td style="min-width:150px">${ve.recPoliza && ve.vencimiento ? `
            <div>
              <span class="badge ${ve.recPolizaHecho?'badge-gray':polVencido?'badge-red':polHoy?'badge-yellow':'badge-blue'}">${ve.recPolizaHecho?'✓ Atendido':polVencido?'⚠️ Vencida '+ve.vencimiento:polHoy?'📅 Hoy':'🔔 '+ve.vencimiento}</span>
              ${!ve.recPolizaHecho && puedeEditar ? `<button onclick="marcarVehiculoRec(${ve.id},'recPolizaHecho')" style="margin-top:4px;display:block;background:#16a34a;color:white;border:none;border-radius:6px;padding:2px 8px;font-size:0.72rem;cursor:pointer">✓ Marcar hecho</button>`:''}
            </div>` : '<span style="color:#94a3b8;font-size:0.78rem">Sin recordatorio</span>'}
          </td>
          ${puedeEditar ? `<td style="display:flex;gap:4px">
            <button class="btn btn-outline btn-sm" onclick="openVehiculoModal(${ve.id})">✏️</button>
