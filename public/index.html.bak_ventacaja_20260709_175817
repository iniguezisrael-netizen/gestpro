async function _autorizarCredito(id) {
  const adminUser = document.getElementById('oc-admin-user')?.value || '';
  const adminPass = document.getElementById('oc-admin-pass')?.value || '';
  const errEl = document.getElementById('oc-pass-error');
  const btn = document.querySelector('#modal .btn-danger');
  if (btn) btn.disabled = true;
  const ok = await verificarPasswordAdmin(adminUser, adminPass);
  if (btn) btn.disabled = false;
  if (!ok) { if (errEl) errEl.style.display = 'block'; return; }
  _aplicarCredito(id);
}
window['_autorizarCredito'] = _autorizarCredito;

function _aplicarCredito(id) {
  const vt = findById(db.ventas, id);
  if (!vt) return;
  const saldo = vt.saldo != null ? vt.saldo : Math.max(0, vt.total - (vt.anticipo||0));
  const yaPagado = Math.max(0, vt.total - saldo);
  const credito = document.getElementById('oc-credito')?.value.trim() || '';
  const encargado = document.getElementById('oc-encargado')?.value.trim() || '';
  const tel = document.getElementById('oc-tel')?.value.trim() || '';
  const folioDefault = vt.folioPedido || 'PED-' + String(vt.id).padStart(5,'0');
  const pedido = document.getElementById('oc-pedido')?.value.trim() || folioDefault;

  const cobId = sid();
  db.cobranza.push({
    id: cobId,
    cliente: vt.cliente,
    encargado: encargado || vt.usuario || session.nombre,
    tel,
    pedido,
    fecha: today(),
    total: vt.total,
    credito,
    estado: 'Pendiente',
    recFecha: '',
    recNota: '',
    recHecho: false,
    abonos: yaPagado > 0 ? [{ monto: yaPagado, fecha: today(), nota: 'Anticipo del pedido (previo a cobranza)' }] : [],
    usuario: session.nombre
  });
  vt.cobranzaId = cobId;
  vt.estado = 'Entregado';
  autorizarCreditoCliente(vt.cliente);
  saveDb(['ventas','cobranza','clientesCredito']); closeModal(); renderVentas();
  alert('✅ Crédito otorgado. El pedido ' + folio + ' se marcó como Entregado y se envió a Cobranza.');
}
window['_aplicarCredito'] = _aplicarCredito;


// Opciones de forma de pago reutilizadas en los modales de cobro/abono.
// Solo "efectivo" se refleja en la caja chica del usuario que cobra, porque en las demás
// formas el dinero no lo recibe físicamente el usuario (va directo a banco/terminal).
function _optionsFormaPago(selected) {
  const opciones = [
    ['efectivo', '💵 Efectivo'],
    ['transferencia', '🏦 Transferencia'],
    ['cheque', '📝 Cheque'],
    ['tarjeta_credito', '💳 Tarjeta de crédito'],
    ['tarjeta_debito', '💳 Tarjeta de débito']
  ];
  return opciones.map(([v,l]) => `<option value="${v}" ${selected===v?'selected':''}>${l}</option>`).join('');
}
function _formaPagoLabel(v) {
  const map = { efectivo:'💵 Efectivo', transferencia:'🏦 Transferencia', cheque:'📝 Cheque', tarjeta_credito:'💳 Tarjeta de crédito', tarjeta_debito:'💳 Tarjeta de débito' };
  return map[v] || (v || '💵 Efectivo');
}
window['_formaPagoLabel'] = _formaPagoLabel;

