// ── IMPORTAR DATOS DESDE JSON (restaurar respaldo) ──
async function importarDatosJSON(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = async (e) => {
    try {
      const datos = JSON.parse(e.target.result);
      const ok = confirm(
        `Se va a restaurar un respaldo del ${datos._exportadoEn ? new Date(datos._exportadoEn).toLocaleString('es-MX') : 'fecha desconocida'}.\n\n` +
        `Esto REEMPLAZARÁ todos los datos actuales.\n\n¿Deseas continuar?`
      );
      if (!ok) return;
      const FS_COL_KEYS = ['users','materia','productos','consignacion','ventas','cotizaciones',
        'cajas','reparaciones','produccion','catalogoMateriales','cobranza','clientesCredito',
        'clientes','bodegas','entregas','facturas','vehiculos'];
      FS_COL_KEYS.forEach(k => {
        if (datos[k] !== undefined) {
          db[k] = datos[k];
          save('gp_' + k, db[k]);
        }
      });
      if (datos._nextId) { nextId = datos._nextId; save('gp_nextid', nextId); }
      // Subir todo a Firestore
      if (FIREBASE_ENABLED && firestore) {
        setSyncStatus('syncing');
        await Promise.all(FS_COL_KEYS.map(k => fsWriteCollection(k, db[k])));
        setSyncStatus('ok');
      }
      alert('✅ Datos restaurados correctamente.');
      if (currentPage) renderPage(currentPage);
    } catch(err) {
      alert('❌ Error al importar: ' + err.message);
    }
    event.target.value = '';
  };
  reader.readAsText(file);
}

