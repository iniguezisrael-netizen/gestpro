// Colecciones con historial de versiones (materia excluida por su tamaño)
const VERSION_COLS = ['productos','consignacion','ventas','cotizaciones','clientes','vehiculos','cajas','cobranza'];
const MAX_VERSIONS = 7;

// Guardar una colección entera en Firestore
// Usa transacción para que el merge multi-usuario sea atómico:
// si dos usuarios escriben al mismo tiempo, Firestore reintenta y ninguno pierde datos.
async function fsWriteCollection(colName, arr) {
  if (!firestore) return;
  const col = firestore.collection(colName);
  const docRef = col.doc('data');
  // Sanitizar: Firestore rechaza valores undefined — JSON round-trip los elimina
  const clean = JSON.parse(JSON.stringify(arr == null ? [] : arr));

  let finalItems = clean;
  try {
    await firestore.runTransaction(async (tx) => {
      const snap = await tx.get(docRef);
      let merged = clean;
      if (snap.exists) {
        const serverItems = snap.data().items || [];
        // Guardar versión anterior (fire-and-forget fuera de la transacción)
        if (VERSION_COLS.includes(colName) && serverItems.length) {
          fsSaveVersion(colName, serverItems);
        }
        const localIds = new Set(clean.map(i => i.id));
        // Preservar ítems del servidor que esta sesión no conoce (agregados por otra sesión)
        const extraItems = serverItems.filter(s => !localIds.has(s.id));
        if (extraItems.length > 0) {
          merged = [...clean, ...extraItems];
        }
      }
      tx.set(docRef, { items: merged, updatedAt: Date.now(), writerId: _mySessionId });
      finalItems = merged;
    });
    // Actualizar caché local con el resultado del merge
    if (colName !== 'facturas') {
      try { db[colName] = JSON.parse(JSON.stringify(finalItems)); save('gp_' + colName, db[colName]); } catch(e) {}
    }
  } catch(e) {
    console.warn('fsWriteCollection transaction fallback:', colName, e);
    // Fallback: escritura directa si la transacción falla
    await docRef.set({ items: clean, updatedAt: Date.now(), writerId: _mySessionId });
  }
}

// ── Historial de versiones ────────────────────────────────────────────────
async function fsSaveVersion(colName, items) {
  if (!firestore || !items || !items.length) return;
  try {
    const versRef = firestore.collection(colName).doc('data').collection('_v');
    const ts = Date.now().toString();
    await versRef.doc(ts).set({ items, ts: Date.now(), by: _mySessionId });
    // Limpiar versiones más antiguas que MAX_VERSIONS
    const all = await versRef.orderBy('ts').get();
    if (all.size > MAX_VERSIONS) {
      const extras = all.docs.slice(0, all.size - MAX_VERSIONS);
      for (const d of extras) d.ref.delete().catch(()=>{});
    }
  } catch(e) { console.warn('[version] Error:', colName, e); }
}

