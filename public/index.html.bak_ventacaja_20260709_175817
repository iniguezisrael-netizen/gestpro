let _tempFotosEp = [];
let _fotoSessionEp = 0;
let _fotosSubiendoEp = 0;

function handleFotoUploadEp(event) {
  const files = [...event.target.files];
  event.target.value = '';
  const token = _fotoSessionEp;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionEp !== token) return;
      _fotosSubiendoEp++; renderFotosPreviewEp();
      subirFotoAStorage(dataUrl, 'ventas', url => {
        if (_fotoSessionEp !== token) return;
        _fotosSubiendoEp--; _tempFotosEp.push(url); renderFotosPreviewEp();
      });
    });
  });
}
function handleFotoDropEp(event) {
  event.preventDefault();
  event.currentTarget.classList.remove('drag-over');
  const files = Array.from(event.dataTransfer.files || []).filter(f => f.type.startsWith('image/'));
  if (!files.length) return;
  const token = _fotoSessionEp;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionEp !== token) return;
      _fotosSubiendoEp++; renderFotosPreviewEp();
      subirFotoAStorage(dataUrl, 'ventas', url => {
        if (_fotoSessionEp !== token) return;
        _fotosSubiendoEp--; _tempFotosEp.push(url); renderFotosPreviewEp();
      });
    });
  });
}
function renderFotosPreviewEp() {
  const cont = document.getElementById('fotos-preview-ep');
  if (!cont) return;
  cont.innerHTML = _tempFotosEp.map((src, idx) => `
    <div class="foto-prev-wrap">
      <img src="${src}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer" onclick="openLightboxSrc('${src}')" />
      <button class="foto-prev-del" onclick="_tempFotosEp.splice(${idx},1);renderFotosPreviewEp()">✕</button>
    </div>`).join('') + (_fotosSubiendoEp > 0 ? `<div style="display:flex;align-items:center;color:#64748b;font-size:0.78rem;padding:8px">⏳ Subiendo ${_fotosSubiendoEp} foto(s)...</div>` : '');
}
window['handleFotoUploadEp'] = handleFotoUploadEp;
window['handleFotoDropEp'] = handleFotoDropEp;
window['renderFotosPreviewEp'] = renderFotosPreviewEp;

