  const ifr = document.createElement('iframe');
  ifr.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0';
  document.body.appendChild(ifr);
  const doc2 = ifr.contentWindow.document;
  doc2.open();
  doc2.write('<!DOCTYPE html><html><head><title>Recibo de pago</title><meta charset="utf-8"><style>body{padding:24px;font-family:Arial,Helvetica,sans-serif}</style></head><body>' + el.outerHTML + '</body></html>');
