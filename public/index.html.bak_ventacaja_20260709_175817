let _respaldoDebounce = null;

function _programarRespaldo() {
  // Espera 3s después del último cambio antes de guardar respaldo
  clearTimeout(_respaldoDebounce);
  _respaldoDebounce = setTimeout(_ejecutarRespaldo, 3000);
}

async function _ejecutarRespaldo() {
  if (!_appReady) return;
  const ts = new Date().toISOString();
  const tsCorto = ts.slice(0, 19).replace('T', '_').replace(/:/g, '-'); // 2026-07-08_14-30-00
  const FS_COL_KEYS = ['materia','productos','consignacion','ventas','cotizaciones',
    'cajas','reparaciones','produccion','catalogoMateriales','cobranza','clientesCredito',
    'clientes','bodegas','entregas','facturas','vehiculos'];
  const snapshot = { _timestamp: ts, _version: 2 };
  FS_COL_KEYS.forEach(k => { snapshot[k] = db[k] || []; });
  const json = JSON.stringify(snapshot);

  // ── 1. NUBE: Firebase Storage ──
  if (FIREBASE_ENABLED && navigator.onLine) {
    try {
      const storage = firebase.storage();
      const blob = new Blob([json], { type: 'application/json' });
      // Siempre sobreescribe latest — fácil de encontrar
      await storage.ref('backups/latest.json').put(blob, { contentType: 'application/json' });
      // Copia con timestamp para historial
      await storage.ref(`backups/${tsCorto}.json`).put(blob, { contentType: 'application/json' });
      console.log('[Backup] ✅ Nube (Storage) actualizada:', tsCorto);
    } catch(e) { console.warn('[Backup] Error nube Storage:', e.message); }
  }

  // ── 2. LOCAL: File System Access API ──
  try {
    const dirHandle = await _obtenerCarpetaRespaldo();
    if (dirHandle) {
      const fileHandle = await dirHandle.getFileHandle('gestpro-latest.json', { create: true });
      const writable = await fileHandle.createWritable();
      await writable.write(json);
      await writable.close();
      console.log('[Backup] ✅ Local actualizado: gestpro-latest.json');
    }
  } catch(e) { console.warn('[Backup] Error local:', e.message); }
}

// IndexedDB para guardar el handle de la carpeta local
function _idbRespaldo(modo, valor) {
  return new Promise((resolve) => {
    const req = indexedDB.open('gp_respaldo_v1', 1);
    req.onupgradeneeded = e => e.target.result.createObjectStore('cfg');
    req.onsuccess = e => {
      const idb = e.target.result;
      const tx = idb.transaction('cfg', modo === 'get' ? 'readonly' : 'readwrite');
      const store = tx.objectStore('cfg');
      const op = modo === 'get' ? store.get('dirHandle') : store.put(valor, 'dirHandle');
      op.onsuccess = () => resolve(op.result || null);
      op.onerror = () => resolve(null);
    };
    req.onerror = () => resolve(null);
  });
}

async function _obtenerCarpetaRespaldo() {
  try {
    const handle = await _idbRespaldo('get');
    if (!handle) return null;
    // Verificar/solicitar permiso (requerido en cada sesión del navegador)
    const perm = await handle.queryPermission({ mode: 'readwrite' });
    if (perm === 'granted') return handle;
    const req = await handle.requestPermission({ mode: 'readwrite' });
    return req === 'granted' ? handle : null;
  } catch(e) { return null; }
}

