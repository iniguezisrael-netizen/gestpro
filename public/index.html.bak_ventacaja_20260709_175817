  const prod = { id:String(sid()), ventaId, fechaInicio: today(), horaInicio:'', fechaFin:'', horaFin:'', notas:'', estadoProd:'Pendiente', trabajadores:[], materiales:[], gastos:[] };
  db.produccion.push(prod);
  saveDb('produccion'); closeModal(); renderProduccion();
}
window['_guardarProduccionManual'] = _guardarProduccionManual;

