  // ── GENERAR PDF ──
  function _entregarPDF(fname, pdfBlob) {
    const blobUrl = URL.createObjectURL(pdfBlob);
    if (autoDescargar) {
      // Dispara la descarga real del archivo (sin abrir pestaña/overlay), para
      // que el navegador lo guarde directamente en la carpeta de Descargas.
      const a = document.createElement('a');
      a.href = blobUrl;
      a.download = fname;
      document.body.appendChild(a);
      a.click();
      a.remove();
    } else {
      _mostrarPDFOverlay(blobUrl, fname);
    }
    setTimeout(() => URL.revokeObjectURL(blobUrl), 120000);
  }

  if (_ventaPedido) {
    buildPage('cliente');
    doc.addPage();
    buildPage('empresa');
    doc.addPage();
    buildPage('produccion');
    const pedidoLabel = _ventaPedido.folioPedido || `PED-${String(_ventaPedido.id).padStart(5,'0')}`;
    const fname = `Pedido_${pedidoLabel}_${c.cliente.replace(/\s+/g,'_')}.pdf`;
    _entregarPDF(fname, doc.output('blob'));
  } else {
    try {
      buildPage('cotizacion');
    } catch(e) {
      console.error('[PDF] Error en buildPage cotizacion:', e);
      alert('Error al generar el PDF: ' + e.message + '\n\nRevisa la consola (F12) para más detalles.');
      return;
    }
    const _clienteNom = (c.cliente || ((c.ctNombre||'') + (c.ctApellido?' '+c.ctApellido:'')).trim() || 'cliente');
    const fname = `Cotizacion_${folio}_${_clienteNom.replace(/\s+/g,'_')}.pdf`;
    _entregarPDF(fname, doc.output('blob'));
  }
}


