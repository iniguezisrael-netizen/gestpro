  if (session.rol === 'admin' && !cajaVistaAdmin) { alert('Selecciona primero de quién es la caja que quieres abrir.'); return; }
  const fondo = +document.getElementById('caja-fondo').value || 0;
  const ahora = new Date();
  const usuarioObjetivo = session.rol === 'admin' ? cajaVistaAdmin : session.nombre;
  const nueva = {
    id: sid(),
    usuario: usuarioObjetivo,
    fecha: today(),
    hora: ahora.toTimeString().slice(0,5),
    fondo,
    movimientos: [],
    cerrada: false
  };
  db.cajas.push(nueva);
  saveDb('cajas');
  renderCaja();
}

