function _generarCodigoUnicoQR(prefix) {
  const todos = [...(db.materia||[]), ...(db.productos||[]), ...(db.consignacion||[])];
  const usados = new Set(todos.flatMap(i => [String(i.codigo||''), String(i.barcode||'')]));
  let n = 1;
  let codigo;
  do {
    codigo = `${prefix}-${String(n).padStart(5,'0')}`;
    n++;
  } while (usados.has(codigo));
  return codigo;
}

