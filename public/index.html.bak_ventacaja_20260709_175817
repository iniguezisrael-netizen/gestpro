// Busca el ÚLTIMO registro con ese id (más reciente) y acepta número o string.
// Previene abrir el registro equivocado cuando existen IDs duplicados por sync multi-dispositivo.
function findById(arr, id) {
  if (!Array.isArray(arr) || id == null) return undefined;
  // Buscar de atrás hacia adelante: el más reciente gana
  for (let i = arr.length - 1; i >= 0; i--) {
    if (arr[i].id === id || arr[i].id == id) return arr[i];
  }
  return undefined;
}

