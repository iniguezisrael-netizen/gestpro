let _lbFotos = [], _lbIdx = 0;
function openLightboxItem(itemId, tipo) {
  const item = db[tipo].find(i => i.id === itemId);
  if (!item || !item.fotos || !item.fotos.length) return;
  _lbFotos = item.fotos; _lbIdx = 0; showLightbox();
}
function openLightboxSrc(src) { _lbFotos = [src]; _lbIdx = 0; showLightbox(); }
function openLightboxCotiz(id, idx) {
  const c = findById(db.cotizaciones, id);
  if (!c || !c.fotos || !c.fotos.length) return;
  _lbFotos = c.fotos; _lbIdx = idx || 0; showLightbox();
