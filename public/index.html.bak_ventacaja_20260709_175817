function vSelRenderPicker() {
  const tipo = v('vsel-tipo');
  const cont = document.getElementById('vsel-picker');
  if (!cont) return;
  if (!tipo) { cont.innerHTML = ''; return; }
  const items = db[tipo]||[];
  cont.innerHTML = `
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px">
      <div style="position:relative;flex:2;min-width:140px">
        <input id="vsel-item" autocomplete="new-password" placeholder="${tipo==='materia' ? 'Escribe para buscar o agrega uno nuevo...' : (items.length ? 'Escribe para buscar...' : 'Sin artículos disponibles')}" style="width:100%;box-sizing:border-box;padding:8px;border:1.5px solid var(--border);border-radius:8px" oninput="vSelItemChange()" onfocus="vSelItemChange()" onblur="vSelHideSugsLater()" />
        <div id="vsel-item-sugs" style="display:none;position:absolute;top:100%;left:0;min-width:100%;width:max-content;max-width:min(480px,90vw);z-index:50;background:#fff;border:1.5px solid var(--border);border-radius:8px;margin-top:2px;max-height:280px;overflow-y:auto;box-shadow:0 4px 14px rgba(0,0,0,.15)"></div>
      </div>
      <input id="vsel-qty" type="number" placeholder="Cant." min="1" value="1" style="width:70px;padding:8px;border:1.5px solid var(--border);border-radius:8px" />
      <input id="vsel-price" type="number" placeholder="Precio" min="0" step="0.01" style="width:100px;padding:8px;border:1.5px solid var(--border);border-radius:8px" />
      <button class="btn btn-success btn-sm" onclick="vSelAddItem()">+ Añadir</button>
    </div>`;
  vSelItemChange();
}
window['vSelRenderPicker'] = vSelRenderPicker;

// Busca el artículo del tipo dado por nombre exacto (al seleccionar una
// sugerencia de la lista queda el nombre completo en el campo).
function _vSelFindItem(tipo, nombre) {
  const n = (nombre||'').trim().toLowerCase();
  if (!n) return null;
  return (db[tipo]||[]).find(i => ((tipo==='consignacion'?i.producto:i.nombre)||'').trim().toLowerCase() === n) || null;
}

// Lista de sugerencias propia (no depende del <datalist> nativo, que no se
// muestra de forma confiable dentro de la app). Se actualiza en cada tecleo
// y al enfocar el campo, mostrando los artículos importados de Excel/inventario
// que coincidan con lo escrito.
function vSelItemChange() {
  const tipo = v('vsel-tipo');
  const txt = (v('vsel-item')||'').trim().toLowerCase();
  const sugs = document.getElementById('vsel-item-sugs');
  if (sugs) {
    const all = db[tipo]||[];
    const matches = txt ? all.filter(i => ((tipo==='consignacion'?i.producto:i.nombre)||'').toLowerCase().includes(txt)) : all;
    if (!all.length) {
      sugs.style.display = 'none';
    } else if (!matches.length) {
      sugs.innerHTML = `<div style="padding:8px 10px;color:#94a3b8;font-size:0.85rem">Sin coincidencias</div>`;
      sugs.style.display = 'block';
    } else {
      sugs.innerHTML = matches.slice(0,50).map(i => {
        const nom = (tipo==='consignacion'?i.producto:i.nombre)||'';
        const stk = i.cantidad||0;
        const foto = i.fotos && i.fotos[0] ? `<img src="${i.fotos[0]}" style="width:38px;height:32px;object-fit:cover;border-radius:5px;margin-right:8px;flex-shrink:0;border:1px solid #e2e8f0" />` : '';
        return `<div class="vsel-sug" data-nombre="${esc(nom)}" style="padding:7px 10px;cursor:pointer;font-size:0.9rem;border-bottom:1px solid #f1f5f9;display:flex;align-items:center" onmousedown="event.preventDefault()">${foto}<span>${esc(nom)} <span style="color:${stk>0?'#94a3b8':'#dc2626'};font-size:0.8rem">· stock: ${stk}</span></span></div>`;
      }).join('');
      sugs.style.display = 'block';
    }
  }
  const item = _vSelFindItem(tipo, v('vsel-item'));
  const priceInput = document.getElementById('vsel-price');
  if (item && priceInput) priceInput.value = round2(item.precioPublico||0);
}
window['vSelItemChange'] = vSelItemChange;

// Click en una sugerencia: completa el campo con ese artículo.
document.addEventListener('click', e => {
  const sug = e.target.closest && e.target.closest('.vsel-sug');
  if (!sug) return;
  const inp = document.getElementById('vsel-item');
  if (inp) inp.value = sug.getAttribute('data-nombre') || '';
  vSelItemChange();
  const sugs = document.getElementById('vsel-item-sugs');
  if (sugs) sugs.style.display = 'none';
});

// Oculta la lista de sugerencias al salir del campo (con un pequeño retraso
// para permitir que el click sobre una sugerencia se registre primero).
function vSelHideSugsLater() {
  setTimeout(() => {
    const sugs = document.getElementById('vsel-item-sugs');
    if (sugs) sugs.style.display = 'none';
  }, 180);
}
window['vSelHideSugsLater'] = vSelHideSugsLater;

function vSelAddItem() {
  const tipo = v('vsel-tipo');
  const nombre = v('vsel-item').trim();
  if (!nombre) { alert('Escribe el nombre del artículo'); return; }
  const item = _vSelFindItem(tipo, nombre);
  const qty = +v('vsel-qty');
  const price = +v('vsel-price');
  if (!qty || qty <= 0) { alert('Ingresa una cantidad válida'); return; }
  if (price === '' || price < 0 || isNaN(price)) { alert('Ingresa un precio válido'); return; }
  if (item) {
    if (qty > (item.cantidad||0)) { alert('⚠️ No hay suficiente stock ('+(item.cantidad||0)+' disponible). Se agregará el artículo de cualquier forma.'); }
    ventaItems.push({
      producto: tipo==='consignacion'?item.producto:item.nombre,
      cantidad: qty, precio: price,
      _tipo: tipo, _itemId: item.id
    });
  } else if (tipo === 'materia') {
    // Materia Prima: si no existe en inventario, se agrega como artículo libre, sin descontar stock.
    ventaItems.push({ producto: nombre, cantidad: qty, precio: price });
  } else {
    alert('Escribe y selecciona un artículo válido de la lista (Producto Terminado / Consignación deben estar dados de alta en inventario)');
    return;
  }
  updateVentaItems();
  vSelRenderPicker();
}
window['vSelAddItem'] = vSelAddItem;

// Abre 'Nueva Venta' ya en la página de Ventas y Pedidos, con un artículo de
// Materia Prima / Productos Terminados / Consignación precargado.
function nuevaVentaDesdeItem(tipo, id) {
  navigate('ventas');
  setTimeout(() => {
    openVentaModal();
    setTimeout(() => {
      const selTipo = document.getElementById('vsel-tipo');
      if (!selTipo) return;
      selTipo.value = tipo;
      vSelRenderPicker();
      setTimeout(() => {
        const item = (db[tipo]||[]).find(i=>i.id===id);
        const selItem = document.getElementById('vsel-item');
        if (selItem && item) selItem.value = (tipo==='consignacion'?item.producto:item.nombre);
        vSelItemChange();
        vSelAddItem();
      }, 30);
    }, 30);
  }, 30);
}
window['nuevaVentaDesdeItem'] = nuevaVentaDesdeItem;

function handleFotoUploadVt(event) {
  const files = [...event.target.files];
  event.target.value = '';
  const token = _fotoSessionVt;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionVt !== token) return;
      _fotosSubiendoVt++; renderFotosPreviewVt();
      subirFotoAStorage(dataUrl, 'ventas', url => {
        if (_fotoSessionVt !== token) return;
        _fotosSubiendoVt--; _tempFotosVt.push(url); renderFotosPreviewVt();
      });
    });
  });
}
window['handleFotoUploadVt'] = handleFotoUploadVt;
function handleFotoDropVt(event) {
  event.preventDefault();
  event.currentTarget.classList.remove('drag-over');
  const files = Array.from(event.dataTransfer.files || []).filter(f => f.type.startsWith('image/'));
  if (!files.length) return;
  const token = _fotoSessionVt;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionVt !== token) return;
      _fotosSubiendoVt++; renderFotosPreviewVt();
      subirFotoAStorage(dataUrl, 'ventas', url => {
        if (_fotoSessionVt !== token) return;
        _fotosSubiendoVt--; _tempFotosVt.push(url); renderFotosPreviewVt();
      });
    });
  });
}
window['handleFotoDropVt'] = handleFotoDropVt;
function renderFotosPreviewVt() {
  const cont = document.getElementById('fotos-preview-vt');
  if (!cont) return;
  cont.innerHTML = _tempFotosVt.map((src, idx) => `
    <div class="foto-prev-wrap">
      <img src="${src}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer" onclick="openLightboxSrc('${src}')" />
      <button class="foto-prev-del" onclick="_tempFotosVt.splice(${idx},1);renderFotosPreviewVt()">✕</button>
    </div>`).join('') + (_fotosSubiendoVt > 0 ? `<div style="display:flex;align-items:center;color:#64748b;font-size:0.78rem;padding:8px">⏳ Subiendo ${_fotosSubiendoVt} foto(s)...</div>` : '');
}
window['renderFotosPreviewVt'] = renderFotosPreviewVt;

function addVentaItem() {
  const prod = document.getElementById('vi-prod').value.trim();
  const qty = +document.getElementById('vi-qty').value;
  const price = +document.getElementById('vi-price').value;
  if (!prod || qty <= 0 || price <= 0) { alert('Completa producto, cantidad y precio'); return; }
  ventaItems.push({ producto:prod, cantidad:qty, precio:price });
  document.getElementById('vi-prod').value='';
  document.getElementById('vi-qty').value=1;
  document.getElementById('vi-price').value='';
  updateVentaItems();
}

function updateVentaItems() {
  const list = document.getElementById('venta-items-list');
  if (!list) return;
  list.innerHTML = ventaItems.length ? `<table style="width:100%;font-size:0.85rem;border-collapse:collapse">
    <tr style="background:var(--bg)"><th style="padding:6px">Producto / Concepto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th><th></th></tr>
    ${ventaItems.map((i,idx) => `<tr style="border-top:1px solid var(--border)">
      <td style="padding:4px 6px"><input type="text" value="${esc(i.producto)}" style="width:100%;padding:2px 4px;border:1px solid var(--border);border-radius:4px;font-size:0.85rem" onchange="ventaItems[${idx}].producto=this.value" /></td>
      <td><input type="number" min="0.01" step="any" value="${i.cantidad}" style="width:60px;padding:2px 4px;border:1px solid var(--border);border-radius:4px;font-size:0.85rem" onchange="ventaItems[${idx}].cantidad=+this.value||1;updateVentaItems()" /></td>
      <td style="padding:6px;color:#64748b">$${fmt(i.precio)}</td>
      <td style="padding:6px;font-weight:600">$${fmt(i.cantidad*i.precio)}</td>
      <td><button onclick="ventaItems.splice(${idx},1);updateVentaItems()" style="background:none;border:none;cursor:pointer;color:var(--danger)">✕</button></td>
    </tr>`).join('')}
  </table>` : '<p style="color:#94a3b8;font-size:0.85rem">Sin items. Agrega productos arriba.</p>';
  const subtotalVt = ventaItems.reduce((s, i) => s + i.cantidad * i.precio, 0);
  const ivaElVt = document.querySelector('input[name="vt-iva"]:checked');
  const masIvaVt = ivaElVt && ivaElVt.value === 'mas';
  const ivaAmtVt = masIvaVt ? subtotalVt * 0.16 : 0;
  const total = subtotalVt + ivaAmtVt;
  const tv = document.getElementById('venta-total');
  if (tv) {
    if (!ventaItems.length) { tv.innerHTML = ''; }
    else if (masIvaVt) {
      tv.innerHTML = `<div style="font-size:0.85rem;color:var(--text-light)">Subtotal: $${fmt(subtotalVt)}</div><div style="font-size:0.85rem;color:var(--text-light)">IVA (16%): $${fmt(ivaAmtVt)}</div><div style="font-weight:700;font-size:1.1rem;color:var(--primary)">Total: $${fmt(total)}</div>`;
    } else {
      tv.textContent = `Total: $${fmt(total)}`;
    }
  }
  calcSaldoVenta();
}

function calcSaldoVenta() {
  const subtotalVt2 = ventaItems.reduce((s, i) => s + i.cantidad * i.precio, 0);
  const ivaElVt2 = document.querySelector('input[name="vt-iva"]:checked');
  const masIvaVt2 = ivaElVt2 && ivaElVt2.value === 'mas';
  const total = subtotalVt2 + (masIvaVt2 ? subtotalVt2 * 0.16 : 0);
  const anticipo = +document.getElementById('v-anticipo')?.value || 0;
  const saldo = Math.max(0, total - anticipo);
  const sEl = document.getElementById('v-saldo');
  if (sEl) sEl.value = saldo.toFixed(2);
}
window['calcSaldoVenta'] = calcSaldoVenta;

// Genera el siguiente folio automático en formato "NOTA DE VENTA-001", "NOTA
// DE VENTA-002"... cuando el usuario deja el campo de Número de Pedido vacío.
// Busca el número más alto ya usado con ese formato y le suma 1.
function _siguienteNotaVenta() {
  let max = 0;
  (db.ventas||[]).forEach(x => {
    const m = /^NOTA DE VENTA-(\d+)$/i.exec((x.folioPedido||'').trim());
    if (m) { const n = parseInt(m[1], 10); if (n > max) max = n; }
  });
  return `NOTA DE VENTA-${String(max + 1).padStart(3,'0')}`;
}
window['_siguienteNotaVenta'] = _siguienteNotaVenta;

function saveVenta() {
  const nombre = v('v-nombre');
  const apellido = v('v-apellido');
  const cliente = [nombre, apellido].filter(Boolean).join(' ');
  if (!cliente) { alert('Ingresa el nombre del cliente'); return; }
  if (!ventaItems.length) { alert('Agrega al menos un producto'); return; }
  const folioManual = v('v-folio').trim();
  if (folioManual && db.ventas.find(x=>x.folioPedido===folioManual && x.estado!=='Cancelada')) {
    alert(`❌ Ya existe un pedido activo con el folio "${folioManual}". Asigna un número diferente (solo se puede reutilizar si ese pedido está cancelado).`);
    return;
  }
  const nuevoId = sid();
  const folioPedido = folioManual || _siguienteNotaVenta();
  const ivaElSv = document.querySelector('input[name="vt-iva"]:checked');
  const masIvaSv = ivaElSv && ivaElSv.value === 'mas';
  const subtotalSv = ventaItems.reduce((s, i) => s + i.cantidad * i.precio, 0);
  const ivaAmtSv = masIvaSv ? subtotalSv * 0.16 : 0;
  const total = subtotalSv + ivaAmtSv;
  const anticipo = +v('v-anticipo') || 0;
  const saldo = Math.max(0, total - anticipo);
  const formaPagoAnticipo = anticipo > 0 ? (document.getElementById('v-forma-pago')?.value || 'efectivo') : null;
  const pagosIniciales = anticipo > 0
    ? [{ monto: anticipo, fecha: v('v-fecha'), hora: new Date().toTimeString().slice(0,5), nota: 'Anticipo inicial', recibidoPor: session.nombre, formaPago: formaPagoAnticipo }]
    : [];
  db.ventas.push({
    id:nuevoId, folioPedido, esPedido:true, fecha:v('v-fecha'), cliente,
    ctNombre:nombre, ctApellido:apellido,
    ctCiudad:v('v-ciudad'), ctEstado:v('v-estado'), ctEmpresa:v('v-empresa'),
    ctTelFijo:v('v-telfijo'), ctCelular:v('v-celular'), ctCorreo:v('v-correo'),
    unidad:v('v-unidad'), tipo:v('v-tipo'), forro:v('v-forro'), color:v('v-color'),
    observaciones:v('v-observaciones'),
    fotos:[..._tempFotosVt],
    items:ventaItems, total, anticipo, saldo, pagos: pagosIniciales,
    iva: masIvaSv, subtotal: subtotalSv, ivaAmount: ivaAmtSv,
    estado:v('v-estado-form'), fechaEntrega:v('v-fecha-entrega'), usuario:session.nombre
  });
  // Descontar stock de los artículos agregados desde inventario (materia/productos/consignación).
  ventaItems.forEach(i => {
    if (i._itemId != null) {
      const item = (db[i._tipo]||[]).find(x=>x.id===i._itemId);
      if (item && item.cantidad != null) item.cantidad = Math.max(0, item.cantidad - i.cantidad);
    }
  });
  // Si el anticipo fue en efectivo y quien registra es secretaria/auxiliar, afectar su caja chica.
  // Si no hay caja abierta se crea una automáticamente para que el efectivo siempre quede registrado.
  if (anticipo > 0 && formaPagoAnticipo === 'efectivo' && (session.rol === 'secretaria' || session.rol === 'auxiliar')) {
    const caja = cajaActivaOCrear();
    if (caja) {
      const movId = sid();
      caja.movimientos = caja.movimientos || [];
      caja.movimientos.push({ id: movId, tipo: 'entrada', monto: anticipo, concepto: `Anticipo pedido ${folioPedido} — ${cliente}`, fecha: v('v-fecha'), hora: new Date().toTimeString().slice(0,5) });
      caja.saldo = (caja.saldo || 0) + anticipo;
      if (pagosIniciales[0]) { pagosIniciales[0].cajaMovId = movId; pagosIniciales[0].cajaUsuario = session.nombre; }
    }
  }
  upsertCliente({ nombre, apellido, ciudad: v('v-ciudad'), estado: v('v-estado'), empresa: v('v-empresa'), telfijo: v('v-telfijo'), celular: v('v-celular'), correo: v('v-correo') });
  saveDb(['ventas','cajas','clientes']); closeModal(); renderVentas();
}

