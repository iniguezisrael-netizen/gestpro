async function confirmarCambiarEmail(uid) {
  const newEmail = v('np-email').trim();
  if (!newEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) { alert('Escribe un correo válido'); return; }
  if (!functions) { alert('No se pudo conectar con el servidor de funciones.'); return; }
  try {
    const call = functions.httpsCallable('actualizarEmailUsuario');
    await call({ targetUid: uid, newEmail });
    closeModal();
    alert('Correo de recuperación actualizado correctamente.');
