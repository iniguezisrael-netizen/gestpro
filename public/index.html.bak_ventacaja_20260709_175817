          </td>` : ''}
        </tr>`;}).join('') : `<tr><td colspan="${puedeEditar?8:7}" style="text-align:center;color:#94a3b8;padding:24px">Sin vehículos registrados.</td></tr>`}
      </table></div>
    </div>`;
}

