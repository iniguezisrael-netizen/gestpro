let _tempFotosCz = [];
let _fotoSessionCz = 0;
let _fotosSubiendoCz = 0;

function handleFotoUploadCz(event) {
  const files = [...event.target.files];
  event.target.value = '';
  const token = _fotoSessionCz;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionCz !== token) return;
      _fotosSubiendoCz++; renderFotosPreviewCz();
      subirFotoAStorage(dataUrl, 'cotizaciones', url => {
        if (_fotoSessionCz !== token) return;
        _fotosSubiendoCz--; _tempFotosCz.push(url); renderFotosPreviewCz();
      });
    });
  });
}
function handleFotoDropCz(event) {
  event.preventDefault();
  event.currentTarget.classList.remove('drag-over');
  const files = Array.from(event.dataTransfer.files || []).filter(f => f.type.startsWith('image/'));
  if (!files.length) return;
  const token = _fotoSessionCz;
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionCz !== token) return;
      _fotosSubiendoCz++; renderFotosPreviewCz();
      subirFotoAStorage(dataUrl, 'cotizaciones', url => {
        if (_fotoSessionCz !== token) return;
        _fotosSubiendoCz--; _tempFotosCz.push(url); renderFotosPreviewCz();
      });
    });
  });
}
function renderFotosPreviewCz() {
  const cont = document.getElementById('fotos-preview-cz');
  if (!cont) return;
  cont.innerHTML = _tempFotosCz.map((src, idx) => `
    <div class="foto-prev-wrap">
      <img src="${src}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer" onclick="openLightboxSrc('${src}')" />
      <button class="foto-prev-del" onclick="_tempFotosCz.splice(${idx},1);renderFotosPreviewCz()">✕</button>
    </div>`).join('') + (_fotosSubiendoCz > 0 ? `<div style="display:flex;align-items:center;color:#64748b;font-size:0.78rem;padding:8px">⏳ Subiendo ${_fotosSubiendoCz} foto(s)...</div>` : '');
}

function addCotizItem() {
  const prod = document.getElementById('czi-prod').value.trim();
  const qty = +document.getElementById('czi-qty').value;
  const price = +document.getElementById('czi-price').value;
  if (!prod || qty <= 0 || price <= 0) { alert('Completa todos los campos del item'); return; }
  cotizItems.push({ producto:prod, cantidad:qty, precio:price });
  document.getElementById('czi-prod').value='';
  document.getElementById('czi-qty').value=1;
  document.getElementById('czi-price').value='';
  updateCotizItems();
}

function updateCotizItems() {
  const list = document.getElementById('cotiz-items-list');
  if (!list) return;
  list.innerHTML = cotizItems.length ? `<table style="width:100%;font-size:0.85rem;border-collapse:collapse">
    <tr style="background:var(--bg)"><th style="padding:6px">Producto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th><th></th></tr>
    ${cotizItems.map((i,idx) => `<tr style="border-top:1px solid var(--border)">
      <td style="padding:6px">${esc(i.producto)}</td>
      <td><input type="number" min="0.01" step="any" value="${i.cantidad}" style="width:60px;padding:2px 4px;border:1px solid var(--border);border-radius:4px;font-size:0.85rem" onchange="cotizItems[${idx}].cantidad=+this.value||1;updateCotizItems()" /></td>
      <td><input type="number" min="0" step="any" value="${i.precio}" style="width:80px;padding:2px 4px;border:1px solid var(--border);border-radius:4px;font-size:0.85rem" onchange="cotizItems[${idx}].precio=+this.value||0;updateCotizItems()" /></td>
      <td style="padding:6px;font-weight:600">$${fmt(i.cantidad*i.precio)}</td>
      <td><button onclick="cotizItems.splice(${idx},1);updateCotizItems()" style="background:none;border:none;cursor:pointer;color:var(--danger)">✕</button></td>
    </tr>`).join('')}
  </table>` : '<p style="color:#94a3b8;font-size:0.85rem">Sin items.</p>';
  const subtotal = cotizItems.reduce((s,i) => s + i.cantidad*i.precio, 0);
  const ivaEl = document.querySelector('input[name="cz-iva"]:checked');
  const masIva = ivaEl && ivaEl.value === 'mas';
  const ivaAmt = masIva ? subtotal * 0.16 : 0;
  const total = subtotal + ivaAmt;
  const tv = document.getElementById('cotiz-total');
  if (tv) {
    if (!cotizItems.length) { tv.innerHTML = ''; }
    else if (masIva) {
      tv.innerHTML = `<div style="font-size:0.85rem;color:var(--text-light)">Subtotal: $${fmt(subtotal)}</div><div style="font-size:0.85rem;color:var(--text-light)">IVA (16%): $${fmt(ivaAmt)}</div><div style="font-weight:700;font-size:1.1rem;color:var(--primary)">Total: $${fmt(total)}</div>`;
    } else {
      tv.textContent = `Total: $${fmt(total)}`;
    }
  }
}

function saveCotiz(id) {
  const nombre = czVal('nombre'), apellido = czVal('apellido');
  if (!nombre || nombre === 'No aplica') { alert('El nombre del cliente es obligatorio'); return; }
  if (!cotizItems.length) { alert('Agrega al menos un item'); return; }
  const ivaElS = document.querySelector('input[name="cz-iva"]:checked');
  const masIvaS = ivaElS && ivaElS.value === 'mas';
  const subtotalCz = cotizItems.reduce((s,i)=>s+i.cantidad*i.precio,0);
  const ivaAmtCz = masIvaS ? subtotalCz * 0.16 : 0;
  const total = subtotalCz + ivaAmtCz;
  const cliente = [nombre, apellido !== 'No aplica' ? apellido : ''].filter(Boolean).join(' ');
  const obj = {
    id: id || sid(),
    fecha: v('cz-fecha'), fechaEntrega: v('cz-entrega'), validez: parseInt(document.getElementById('cz-validez').value)||0, cliente,
    ctNombre: nombre, ctApellido: czVal('apellido'),
    ctCiudad: czVal('ciudad'), ctEstado: czVal('estado'), ctEmpresa: czVal('empresa'),
    ctTelFijo: czVal('telfijo'), ctCelular: czVal('celular'),
    ctCorreo: czVal('correo'),
    estado: v('cz-estado-form') || (id ? db.cotizaciones.find(x=>x.id===id).estado : 'Pendiente'),
    unidad: v('cz-unidad'), tipo: v('cz-tipo'),
    forro: v('cz-forro'), color: v('cz-color'),
    observaciones: v('cz-observaciones'),
    notas: v('cz-notas'),
    recFecha: v('cz-rec-fecha'),
    recHora: document.getElementById('cz-rec-todoeldia')?.checked ? 'Todo el día' : v('cz-rec-hora'),
    recNota: v('cz-rec-nota'),
    recHecho: id ? (db.cotizaciones.find(x=>x.id===id)?.recHecho || false) : false,
    items: cotizItems, total,
    iva: masIvaS, subtotal: subtotalCz, ivaAmount: ivaAmtCz,
    fotos: [..._tempFotosCz],
    usuario: id ? (db.cotizaciones.find(x=>x.id===id)?.usuario || session.nombre) : session.nombre,
    usuarioRol: id ? (db.cotizaciones.find(x=>x.id===id)?.usuarioRol || session.rol) : session.rol
  };
  if (id) { const idx = db.cotizaciones.findIndex(x=>x.id===id); db.cotizaciones[idx] = obj; }
  else db.cotizaciones.push(obj);
  upsertCliente({ nombre: obj.ctNombre, apellido: obj.ctApellido, ciudad: obj.ctCiudad, estado: obj.ctEstado, empresa: obj.ctEmpresa, telfijo: obj.ctTelFijo, celular: obj.ctCelular, correo: obj.ctCorreo });
  saveDb(['cotizaciones','clientes']); closeModal(); renderCotizaciones();
}

