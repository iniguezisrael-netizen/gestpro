// ── BLOQUEAR PULL-TO-REFRESH EN MÓVIL Y PEDIR CONFIRMACIÓN ──
(function() {
  let _ptStartY = 0;
  let _ptPulling = false;
  let _ptBar = null;

  function _ptGetBar() {
    if (!_ptBar) {
      _ptBar = document.createElement('div');
      _ptBar.style.cssText = [
        'position:fixed','top:0','left:0','right:0','z-index:999999',
        'background:#1e293b','color:#f8fafc','text-align:center',
        'padding:10px 16px','font-size:0.88rem','font-weight:600',
        'transform:translateY(-100%)','transition:transform 0.15s',
        'pointer-events:none'
      ].join(';');
      document.body.appendChild(_ptBar);
    }
    return _ptBar;
  }

  document.addEventListener('touchstart', (e) => {
    const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
    if (scrollTop === 0) {
      _ptStartY = e.touches[0].pageY;
      _ptPulling = true;
    }
  }, { passive: true });

  document.addEventListener('touchmove', (e) => {
    if (!_ptPulling) return;
    const dist = e.touches[0].pageY - _ptStartY;
    if (dist > 8) {
      e.preventDefault(); // bloquea el pull-to-refresh nativo del navegador
      const pct = Math.min(100, dist * 1.2);
      const bar = _ptGetBar();
      bar.textContent = pct >= 80 ? '🔄 Suelta para actualizar' : '↓ Baja para actualizar';
      bar.style.transform = `translateY(${-100 + pct}%)`;
    }
  }, { passive: false });

  document.addEventListener('touchend', (e) => {
    if (!_ptPulling) return;
    _ptPulling = false;
    const dist = (e.changedTouches[0] ? e.changedTouches[0].pageY : _ptStartY) - _ptStartY;
    const bar = _ptGetBar();
    bar.style.transform = 'translateY(-100%)';
    if (dist > 80) {
      // Mostrar confirmación antes de recargar
      setTimeout(() => {
        const ok = confirm('Si actualizas la aplicación se perderá lo que llevas capturado.\n\n¿Deseas actualizar de todas formas?');
        if (ok) location.reload();
      }, 200);
    }
  }, { passive: true });
})();

// ── IndexedDB helpers (para guardar el handle de carpeta) ──
function _idbOpen() {
  return new Promise((res, rej) => {
    const r = indexedDB.open('gestpro-prefs', 1);
    r.onupgradeneeded = e => e.target.result.createObjectStore('prefs');
    r.onsuccess = e => res(e.target.result);
    r.onerror   = e => rej(e.target.error);
  });
}
async function _idbGet(key) {
  const db = await _idbOpen();
  return new Promise((res, rej) => {
    const req = db.transaction('prefs','readonly').objectStore('prefs').get(key);
    req.onsuccess = () => res(req.result);
    req.onerror   = () => rej(req.error);
  });
}
async function _idbSet(key, val) {
  const db = await _idbOpen();
  return new Promise((res, rej) => {
    const req = db.transaction('prefs','readwrite').objectStore('prefs').put(val, key);
    req.onsuccess = () => res();
    req.onerror   = () => rej(req.error);
  });
}

async function _getRespaldoDir() {
  let handle = await _idbGet('respaldo-dir-handle');
  if (handle) {
    try {
      let perm = await handle.queryPermission({ mode: 'readwrite' });
      if (perm !== 'granted') perm = await handle.requestPermission({ mode: 'readwrite' });
      if (perm === 'granted') return handle;
    } catch(e) { /* handle inválido, pedir de nuevo */ }
  }
  // Primera vez: pedir al usuario que seleccione la carpeta
  handle = await window.showDirectoryPicker({ mode: 'readwrite', startIn: 'documents' });
  await _idbSet('respaldo-dir-handle', handle);
  return handle;
}

