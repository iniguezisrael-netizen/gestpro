// Redimensiona y comprime imagen antes de guardar en la nube.
const MAX_FOTOS = 8; // máximo de fotos por ítem (reduce almacenamiento en la nube)
function comprimirImagen(file, callback) {
  const MAX_DIM = 800; // px — reducido de 1000 para menor peso en Storage
  const CALIDAD = 0.60; // calidad JPEG — reducido de 0.75 para menor peso
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      let { width, height } = img;
      if (width > MAX_DIM || height > MAX_DIM) {
        if (width >= height) { height = Math.round(height * (MAX_DIM / width)); width = MAX_DIM; }
        else { width = Math.round(width * (MAX_DIM / height)); height = MAX_DIM; }
      }
      const canvas = document.createElement('canvas');
      canvas.width = width; canvas.height = height;
      canvas.getContext('2d').drawImage(img, 0, 0, width, height);
      try { callback(canvas.toDataURL('image/jpeg', CALIDAD)); }
      catch(err) { callback(e.target.result); }
    };
    img.onerror = () => callback(e.target.result);
    img.src = e.target.result;
  };
  reader.onerror = () => callback(null);
  reader.readAsDataURL(file);
}

// ===================== SUBIDA DE FOTOS A FIREBASE STORAGE =====================
// Convierte un data URL (base64) en un Blob para poder subirlo a Storage.
function _dataUrlABlob(dataUrl) {
  const partes = dataUrl.split(',');
  const mimeMatch = partes[0].match(/:(.*?);/);
  const mime = mimeMatch ? mimeMatch[1] : 'image/jpeg';
  const bstr = atob(partes[1]);
  let n = bstr.length;
  const u8arr = new Uint8Array(n);
  while (n--) u8arr[n] = bstr.charCodeAt(n);
  return new Blob([u8arr], { type: mime });
}

// Sube una imagen (ya comprimida, como data URL) a Cloudflare R2 vía URL firmada.
// Si no hay conexión o falla, guarda base64 localmente para sincronizar después.
async function subirFotoAStorage(dataUrl, carpeta, callback) {
  if (!navigator.onLine) { callback(dataUrl); return; }
  try {
    // Asegurar que el SDK de Functions esté inicializado (puede cargarse en lazy)
    if (window._tryInitFunctions) window._tryInitFunctions();
    // Subir a través de Cloud Function para evitar error CORS en PUT directo a R2
    const contentType = dataUrl.startsWith('data:') ? dataUrl.split(';')[0].split(':')[1] : 'image/jpeg';
    const imageBase64 = dataUrl.startsWith('data:') ? dataUrl.split(',')[1] : dataUrl;
    const fnResult = await firebase.functions().httpsCallable('r2SubirFoto')({ imageBase64, contentType, carpeta });
    callback(fnResult.data.url);
  } catch (err) {
    console.error('Error subiendo foto a R2 (se usa respaldo local):', err);
    callback(dataUrl);
  }
}

// Elimina fotos de R2 al borrar un registro. No bloquea — se hace en background.
function _eliminarFotosR2(fotos) {
  if (!fotos || !fotos.length || !FIREBASE_ENABLED) return;
  const urls = fotos.filter(f => f && typeof f === 'string' && f.startsWith('http'));
  if (!urls.length) return;
  firebase.functions().httpsCallable('r2EliminarFotos')({ urls }).catch(() => {});
}

// Sincronización automática de fotos offline (base64 → Storage) al reconectarse.
// Devuelve una Promise que resuelve cuando todas las fotos pendientes han sido procesadas.
const _COLS_CON_FOTOS = ['consignacion','productos','materia','ventas','cotizaciones'];
function sincronizarFotosPendientes() {
  if (!storage || !navigator.onLine) return Promise.resolve();
  const promesas = [];
  _COLS_CON_FOTOS.forEach(col => {
    const items = db[col] || [];
    items.forEach(item => {
      if (!item.fotos || !item.fotos.length) return;
      if (!item.fotos.some(f => f && f.startsWith('data:'))) return;
      const nuevasFotos = [...item.fotos];
      const uploadsDeEsteItem = nuevasFotos.map((f, i) => {
        if (!f || !f.startsWith('data:')) return Promise.resolve();
        return new Promise(resolve => {
          subirFotoAStorage(f, col, url => {
            nuevasFotos[i] = url;
            resolve();
          });
        });
      });
      const itemPromise = Promise.all(uploadsDeEsteItem).then(() => {
        item.fotos = nuevasFotos;
        saveDb(col);
        console.log(`Fotos sincronizadas para ${col} id=${item.id}`);
      });
      promesas.push(itemPromise);
    });
  });
  return Promise.all(promesas);
}
window.addEventListener('online', () => {
  setSyncStatus('syncing');
  // Espera 300ms a que la conexión estabilice, luego sincroniza datos y fotos pendientes
  setTimeout(async () => {
    // SAFEGUARD: no subir si la app aún no cargó datos desde Firestore
    if (!_appReady) {
      console.warn('[online] App no lista aún — omitiendo sync');
      setSyncStatus('ok');
      return;
    }
    let syncOk = true;
    // Solo subir si hay colecciones que cambiaron en ESTA sesión mientras offline.
    // Si _pendingSyncCols está vacío, Firestore ya maneja la sincronización automáticamente
    // mediante su persistencia offline (IndexedDB). No es necesario re-subir todo.
    if (FIREBASE_ENABLED && firestore && _pendingSyncCols.size > 0) {
      // Proteger solo mientras dura el upload real (no 15s fijos)
      window._ownWriteUntil = Date.now() + 10000;
      try {
        const colsASubir = [..._pendingSyncCols].filter(c => db[c] != null);
        console.log('[online] Sincronizando', colsASubir.length, 'colección(es):', colsASubir.join(', '));
        if (colsASubir.length > 0) {
          await Promise.all(colsASubir.map(c => fsWriteCollection(c, db[c])));
        }
        _clearPendingSync();
        // Extender guard 1s más para atrapar snapshots tardíos de confirmación
        window._ownWriteUntil = Math.max(window._ownWriteUntil || 0, Date.now() + 1000);
      } catch(e) {
        syncOk = false;
        window._ownWriteUntil = 0;
        setSyncStatus('error', e && e.message ? e.message : String(e));
      }
    } else {
      // Sin cambios pendientes: Firestore sincroniza solo, no bloquear snapshots entrantes
      _clearPendingSync();
      console.log('[online] Sin cambios pendientes — Firestore sync automático');
    }
    // Marcar datos como sincronizados — el upload de fotos es secundario y no bloquea
    if (syncOk) {
      const teniaPending = _hasPendingSync;
      _hasPendingSync = false;
      setSyncStatus('ok');
      if (teniaPending && typeof showToast === 'function') {
        showToast('✅ Datos sincronizados con el servidor');
      }
    }
    // Subir fotos pendientes en background (no bloquea el indicador de sync)
    sincronizarFotosPendientes().catch(e => console.warn('[sync-fotos] Error:', e));
  }, 300);
});

