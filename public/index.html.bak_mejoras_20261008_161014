                if (sc) { sc.archivado = true; sc.archivadoPor = c.archivadoPor; sc.archivadoEn = now; }
              }
              try { if (firestore) firestore.collection('cobranza').doc(String(c.id)).update({ archivado: true, archivadoPor: c.archivadoPor, archivadoEn: now }).catch(()=>{}); } catch(e) {}
            });
            saveDb('cobranza');
          }
          renderVentas();
        }},
        { label: 'Cancelar', cls: 'btn-secondary', action: closeModal }
      ]);
