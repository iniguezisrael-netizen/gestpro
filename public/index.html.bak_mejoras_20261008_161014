            // (ej: baja:true, archivado:true puestos desde otro dispositivo)
            if (server.baja === true && !final.baja) final.baja = true;
            if (server.archivado === true && !final.archivado) { final.archivado = true; if (server.archivadoPor) final.archivadoPor = server.archivadoPor; if (server.archivadoEn) final.archivadoEn = server.archivadoEn; }
            if (final.recHecho === true && !server.recHecho) { server.recHecho = true; if (final.recSnoozeHasta) server.recSnoozeHasta = final.recSnoozeHasta; }
          }
          tx.set(docRef, final);
          committed = final;
        });
        txResults[String(item.id)] = committed;
      }

      // Batch para items sin cambio numérico
      // Usar update() para docs existentes: preserva campos sticky (baja, archivado)
      // que otro dispositivo pudo haber puesto sin que este haya recibido el onSnapshot.
      if (batchItems.length) {
        const BATCH_MAX = 400;
        for (let i = 0; i < batchItems.length; i += BATCH_MAX) {
          const batch = firestore.batch();
          batchItems.slice(i, i + BATCH_MAX).forEach(item => {
            const idStr = String(item.id);
            const isNew = !srvSnap[idStr] && !knownIds.has(idStr);
            if (isNew) batch.set(colRef.doc(idStr), item);
            else batch.set(colRef.doc(idStr), item, {merge: true});
          });
          await batch.commit();
        }
      }

      // Actualizar local con los valores finales (con deltas aplicados)
      const finalClean = clean.map(item =>
        item.id != null && txResults[String(item.id)] ? txResults[String(item.id)] : item
      );
      try { db[colName] = JSON.parse(JSON.stringify(finalClean)); save('gp_' + colName, db[colName]); } catch(e) { console.error('[sync] Error guardando ' + colName + ' en local:', e); }
      // Actualizar snapshot con los valores confirmados por el servidor
      window._serverSnapshot = window._serverSnapshot || {};
      window._serverSnapshot[colName] = window._serverSnapshot[colName] || {};
      finalClean.forEach(item => {
        if (item.id != null)
          window._serverSnapshot[colName][String(item.id)] = JSON.parse(JSON.stringify(item));
      });
      // Limpiar del snapshot los IDs eliminados
      toDelete.forEach(id => { delete window._serverSnapshot[colName]?.[id]; });
      return;
    }

    // ── Cajas: transacción que fusiona movimientos por id ────────────────────
    // Previene pérdida de movimientos cuando otro dispositivo tiene copia desactualizada.
    if (colName === 'cajas') {
      if (VERSION_COLS.includes(colName) && clean.length) fsSaveVersion(colName, clean);
      for (const item of clean) {
        if (!item.id) continue;
        const docRef = firestore.collection('cajas').doc(String(item.id));
        await firestore.runTransaction(async tx => {
          const snap = await tx.get(docRef);
          let finalMovs = item.movimientos || [];
          if (snap.exists) {
            const serverMovs = snap.data().movimientos || [];
            const localIds = new Set((item.movimientos || []).map(m => m.id));
            // Preservar movimientos del servidor que no están en la copia local
            const extra = serverMovs.filter(m => m.id && !localIds.has(m.id));
            if (extra.length) finalMovs = [...finalMovs, ...extra];
          }
          tx.set(docRef, { ...item, movimientos: finalMovs });
        });
      }
      // Actualizar db local con los datos fusionados
      try { db[colName] = JSON.parse(JSON.stringify(clean)); save('gp_' + colName, db[colName]); } catch(e) { console.error('[sync] Error guardando ' + colName + ' en local:', e); }
      return;
    }

    // ── Formato individual: resto de colecciones ──────────────────────────────
    const newIds = new Set(clean.map(i => String(i.id)));

    // Versión histórica antes de escribir (fire-and-forget)
    if (VERSION_COLS.includes(colName) && clean.length) {
      fsSaveVersion(colName, clean);
    }

    // IDs que estaban en Firestore pero ya no están → eliminar
    const knownIds = _firestoreKnownIds[colName] || new Set();
    const toDelete = [...knownIds].filter(id => !newIds.has(id));
    if (toDelete.length) toDelete.forEach(id => _addTombstone(colName, id));
    _firestoreKnownIds[colName] = new Set(newIds);
    _saveKnownIds();

    // Solo escribir documentos que realmente cambiaron (comparar con _serverSnapshot).
    // Regla: si tenemos snapshot del doc → comparar y solo escribir si cambió.
    //        si NO tenemos snapshot → siempre escribir (más seguro perder una escritura
    //        extra que perder datos del usuario).
    const srvSnap = (window._serverSnapshot || {})[colName] || {};
    const dirty = clean.filter(item => {
      const idStr = String(item.id);
      const srv = srvSnap[idStr];
      if (srv) {
        // Doc conocido en snapshot: solo escribir si cambió
        return JSON.stringify(item) !== JSON.stringify(srv);
      }
      // Sin snapshot para este doc → siempre escribir para no perder datos
      return true;
    });

    // Antes de escribir: si algún item tiene fotos base64 pesadas, subirlas a R2 primero
    // Esto evita exceder el límite de 1MB por documento en Firestore
    const _carpetaCol = { consignacion:'consignacion', productos:'inventario', materia:'inventario', ventas:'ventas', cotizaciones:'cotizaciones' };
    for (const item of dirty) {
      if (!item.fotos || !item.fotos.some(f => f && f.startsWith('data:'))) continue;
      const carpeta = _carpetaCol[colName] || colName;
      await Promise.all(item.fotos.map((f, i) => {
        if (!f || !f.startsWith('data:')) return Promise.resolve();
        return new Promise(resolve => {
          subirFotoAStorage(f, carpeta, url => { item.fotos[i] = url; resolve(); });
        });
      }));
      // Si alguna foto sigue como base64 (subida falló), al menos avisar
      if (item.fotos.some(f => f && f.startsWith('data:'))) {
        console.warn('[fsWrite] Foto base64 en', colName, item.id, '— no se pudo subir a R2');
      }
    }

    const colRef = firestore.collection(colName);
    const BATCH_MAX = 400;
    // Usar update() para docs existentes: preserva campos que este dispositivo no conoce
    // (ej: archivado:true puesto desde otro dispositivo sin que este haya recibido onSnapshot todavía).
    // Usar set() solo para docs nuevos (no están en srvSnap ni en _firestoreKnownIds).
    const _knownIdsCol = _firestoreKnownIds[colName] || new Set();
    const writes = dirty.map(item => {
      const idStr = String(item.id);
      const isNew = !srvSnap[idStr] && !_knownIdsCol.has(idStr);
      return { op: isNew ? 'set' : 'update', ref: colRef.doc(idStr), data: item };
    });
    const deletes = toDelete.map(id => ({ op:'del', ref: colRef.doc(id) }));
    const allOps = [...writes, ...deletes];

    for (let i = 0; i < allOps.length; i += BATCH_MAX) {
      const batch = firestore.batch();
      allOps.slice(i, i + BATCH_MAX).forEach(o => {
        if (o.op === 'set') batch.set(o.ref, o.data);
        else if (o.op === 'update') batch.set(o.ref, o.data, {merge: true}); // set+merge evita 'No document to update'
        else batch.delete(o.ref);
      });
      await batch.commit();
    }

    if (colName !== 'facturas') {
      try { db[colName] = JSON.parse(JSON.stringify(clean)); save('gp_' + colName, db[colName]); } catch(e) { console.error('[sync] Error guardando ' + colName + ' en local:', e); }
    }
    // Actualizar _serverSnapshot con lo que acabamos de escribir, para que el próximo
    // save calcule correctamente qué docs cambiaron (sin esperar al onSnapshot).
    window._serverSnapshot = window._serverSnapshot || {};
    window._serverSnapshot[colName] = window._serverSnapshot[colName] || {};
    dirty.forEach(item => {
      if (item.id != null) window._serverSnapshot[colName][String(item.id)] = JSON.parse(JSON.stringify(item));
    });
    toDelete.forEach(id => { delete window._serverSnapshot[colName]?.[id]; });
  } catch(e) {
    console.error('fsWriteCollection error:', colName, e);
    // Marcar como pendiente para reintento al reconectar (incluso si estamos "online")
    _markPendingSync(colName);
    _hasPendingSync = true;
    if (session && session.rol === 'admin') {
      setTimeout(() => _info(`⚠️ No se pudo guardar "${colName}" en la nube.\nRevisa tu conexión. El dato está seguro en este dispositivo.`, 'Error de sincronización'), 300);
    }
    setSyncStatus('error', e && e.message ? e.message : String(e));
    throw e; // propagar para que saveDb muestre ⚠️ correctamente
  }
}

