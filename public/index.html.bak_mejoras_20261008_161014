function _gsExtractCode(val) {
  // Si el valor escaneado es una URL con ?consig=, extraer solo el folio
  try {
    const _u = new URL(val.trim());
    const _c = _u.searchParams.get('consig');
    if (_c) return _c.trim();
  } catch(e) {}
  return val.trim();
}

function _gsScanHint(val) {
  const hint=document.getElementById('gs-scan-hint');
  if (!hint||!val.trim()) { if(hint) hint.innerHTML='&nbsp;'; return; }
  const code = _gsExtractCode(val);
  // Si se extrajo un código limpio de la URL, actualizar el campo visualmente
  if (code !== val.trim()) {
    const s=document.getElementById('gs-scan'); if(s) s.value=code;
  }
  const item=(db.materia||[]).find(i=>
    (i.barcode&&i.barcode.trim().toLowerCase()===code.toLowerCase())||
    (i.codigo &&i.codigo.trim().toLowerCase() ===code.toLowerCase())||
    (i.nombre &&i.nombre.trim().toLowerCase() ===code.toLowerCase()));
  if (item) {
    const u=document.getElementById('gs-uni'); if(u&&!u.value) u.value=item.unidad||'';
    const foto=item.fotos&&item.fotos[0]
      ?'<img src="'+esc(item.fotos[0])+'" style="width:34px;height:34px;object-fit:cover;border-radius:5px;border:1px solid var(--border);flex-shrink:0">'
      :'';
    hint.style.display='flex'; hint.style.alignItems='center';
    hint.innerHTML=foto+'<span>&#9989; <strong>'+esc(item.nombre)+'</strong> &mdash; stock: '+item.cantidad+' '+esc(item.unidad||'')+'</span>';
    return;
  }
  // Buscar también en consignación por folio o barcode
  const consig=(db.consignacion||[]).find(i=>
    (i.folio&&i.folio.trim().toLowerCase()===code.toLowerCase())||
    (i.barcode&&i.barcode.trim().toLowerCase()===code.toLowerCase()));
  if (consig) {
    hint.style.display='flex'; hint.style.alignItems='center';
    hint.innerHTML='<span>&#9989; <strong>'+esc(consig.producto||consig.nombre||consig.folio||code)+'</strong>'+(consig.folio?' &mdash; Folio: '+esc(consig.folio):'')+'</span>';
    return;
  }
  hint.style.display='';
  hint.innerHTML='<span style="color:#ef4444">&#9888; No encontrado &mdash; se registrará como texto libre</span>';
}

function _gsAgregar() {
  const rawDesc=(document.getElementById('gs-scan')?.value||'').trim();
  const desc=_gsExtractCode(rawDesc);
  if (desc !== rawDesc) { const s=document.getElementById('gs-scan'); if(s) s.value=desc; }
  const qty=parseFloat(document.getElementById('gs-qty')?.value)||1;
  const uni=(document.getElementById('gs-uni')?.value||'').trim();
  if (!desc) return;
  const item=(db.materia||[]).find(i=>
    (i.barcode&&i.barcode.trim().toLowerCase()===desc.toLowerCase())||
    (i.codigo &&i.codigo.trim().toLowerCase() ===desc.toLowerCase())||
    (i.nombre &&i.nombre.trim().toLowerCase() ===desc.toLowerCase()));
  if (item) {
    window._gsItems.push({descripcion:item.nombre, cantidad:qty, unidad:item.unidad||uni, _materiaId:item.id});
  } else {
    const consig=(db.consignacion||[]).find(i=>
      (i.folio&&i.folio.trim().toLowerCase()===desc.toLowerCase())||
      (i.barcode&&i.barcode.trim().toLowerCase()===desc.toLowerCase()));
    const displayNombre = consig ? (consig.producto||consig.nombre||desc)+(consig.folio?' ['+consig.folio+']':'') : desc;
    window._gsItems.push({descripcion:displayNombre, cantidad:qty, unidad:consig?'pza':uni, _materiaId:null, _consigId:consig?consig.id:null});
  }
  const s=document.getElementById('gs-scan'); if(s){s.value='';s.focus();}
  const u=document.getElementById('gs-uni');  if(u) u.value='';
  const h=document.getElementById('gs-scan-hint'); if(h) h.innerHTML='&nbsp;';
  const q=document.getElementById('gs-qty');  if(q) q.value=1;
  _gsRenderLista();
}

function _gsRenderLista() {
