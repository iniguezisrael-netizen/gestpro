function _dataUrlToBlobUrl(dataUrl) {
  const [header, base64] = dataUrl.split(',');
  const mimeMatch = header.match(/data:(.*?);base64/);
  const mime = mimeMatch ? mimeMatch[1] : 'application/pdf';
  const binary = atob(base64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return URL.createObjectURL(new Blob([bytes], { type: mime }));
}

function verPdfFactura(id) {
  const f = db.facturas.find(x=>x.id===id);
  if (!f) return;
  if (f.pdfUrl) {
    const win = window.open(f.pdfUrl, '_blank');
    if (!win) _info('Tu navegador bloqueó la ventana emergente. Permítela e intenta de nuevo.');
    return;
  }
  // Compatibilidad con facturas antiguas guardadas en localStorage
  if (f.pdfB64) {
    const blobUrl = _dataUrlToBlobUrl(f.pdfB64);
    const win = window.open(blobUrl, '_blank');
    if (!win) _info('Tu navegador bloqueó la ventana emergente. Permítela e intenta de nuevo.');
    return;
  }
  _info('No hay PDF guardado para esta factura');
}

async function descargarXml(id) {
  const f = db.facturas.find(x=>x.id===id);
  if (!f) return;
  const nombre = `${f.serie||''}${f.folio||f.uuid?.substring(0,8)||'factura'}.xml`;
  // Preferir xmlB64 (no requiere CORS)
  if (f.xmlB64) {
    try {
      const xmlText = decodeURIComponent(escape(atob(f.xmlB64)));
      const blob = new Blob([xmlText], {type:'text/xml'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = nombre; a.click();
      URL.revokeObjectURL(url);
      return;
    } catch(e) { console.error('Error con xmlB64:', e); }
  }
  if (f.xmlUrl) {
    // Intentar fetch; si falla por CORS, abrir en nueva pestaña
    try {
      const resp = await fetch(f.xmlUrl);
      if (!resp.ok) throw new Error('HTTP ' + resp.status);
      const xmlText = await resp.text();
      const blob = new Blob([xmlText], {type:'text/xml'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = nombre; a.click();
      URL.revokeObjectURL(url);
    } catch(e) {
      // CORS u otro error de red: abrir en nueva pestaña
      const a = document.createElement('a');
      a.href = f.xmlUrl; a.target = '_blank'; a.rel = 'noopener';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      _info('ℹ️ El XML se abrió en nueva pestaña. Usa Ctrl+S para guardarlo.');
    }
    return;
  }
  _info('No hay XML guardado');
}

