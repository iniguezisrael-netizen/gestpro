function saveItem(tipo, id) {
  if (_fotosSubiendo > 0) { _info(`⏳ Espera a que terminen de subir las fotos (${_fotosSubiendo} pendiente${_fotosSubiendo>1?'s':''})`); return; }
  const codigo = v('m-codigo');
  const nombre = tipo === 'materia' ? v('m-nombre') : (v('m-nombre') || codigo);
  if (!codigo || !nombre) { _info('Código y nombre son obligatorios'); return; }
  if (tipo === 'productos' && id && session.rol !== 'admin') {
    const actual = db[tipo].find(i => i.id === id);
    const nuevaCantidad = +v('m-cantidad');
    if (actual && nuevaCantidad < actual.cantidad) {
      _info('Solo el administrador puede dar de baja productos terminados manualmente. Para reducir el inventario, el producto debe venderse.');
      return;
    }
  }
  const obj = {
    id: id || sid(), codigo, nombre,
    barcode: tipo === 'materia' ? v('m-barcode').trim() : codigo,
    clienteNombre: v('m-cnombre'),
    clienteApellido: v('m-capellido'),
    clienteEmpresa: v('m-cempresa'),
    categoria: v('m-categoria'),
    ubicacion: tipo === 'materia' ? v('m-ubicacion') : v('m-ubicacion-prod'),
    estante: tipo === 'materia' ? v('m-estante') : (id ? db[tipo].find(i=>i.id===id)?.estante : ''),
    cantidad: +v('m-cantidad'),
    unidad: v('m-unidad') || 'pza',
    // Costo y precio público solo los puede definir el administrador; si el campo no
    // se renderizó (otros roles), conservamos el valor que ya tenía el artículo.
    precio: session.rol === 'admin' ? round2(v('m-precio')) : round2(id ? (db[tipo].find(i=>i.id===id)?.precio || 0) : 0),
    precioPublico: session.rol === 'admin' ? round2(v('m-precio-pub')) : round2(id ? (db[tipo].find(i=>i.id===id)?.precioPublico || 0) : 0),
    minimo: +v('m-minimo') || 5,
    sinMinimo: document.getElementById('m-sinminimo')?.checked || false,
    desc: v('m-desc'),
    ...(tipo === 'productos' ? {
      especUnidad: v('m-eunidad'), especTipo: v('m-etipo'),
      especForro: v('m-eforro'), especColor: v('m-ecolor'),
      especObservaciones: v('m-eobs')
    } : (id ? (({especUnidad,especTipo,especForro,especColor,especObservaciones}) => ({especUnidad,especTipo,especForro,especColor,especObservaciones}))(db[tipo].find(i=>i.id===id)||{}) : {})),
    fotos: [..._tempFotos],
    ...(tipo === 'materia' && session.rol === 'admin' ? {
      empresa: v('m-empresa') || '',
      vendedor: v('m-vendedor') || '',
      tel: v('m-tel') || '',
