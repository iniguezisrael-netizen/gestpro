        <input type="text" id="ei-pedido-search" placeholder="Escribe folio o cliente para buscar…"
          style="width:100%;padding:8px;border:1.5px solid var(--border);border-radius:8px;background:#fff;box-sizing:border-box"
          autocomplete="off" spellcheck="false"
          value="${ei ? esc(ei.folioPedido + ' — ' + ei.cliente) : ''}"
          oninput="_eiPedidoBuscar(this.value)"
          onfocus="_eiPedidoBuscar(this.value)"
          onblur="setTimeout(_eiPedidoCerrar,200)" />
        <input type="hidden" id="ei-pedido-id"     value="${ei ? ei.pedidoId : ''}" />
        <input type="hidden" id="ei-pedido-folio"  value="${ei ? esc(ei.folioPedido||'') : ''}" />
        <input type="hidden" id="ei-pedido-cliente" value="${ei ? esc(ei.cliente||'') : ''}" />
      </div>
      <div class="form-group">
        <label>Fecha *</label>
        <input type="date" id="ei-fecha" value="${ei ? ei.fecha : today()}" style="width:100%;padding:8px;border:1.5px solid var(--border);border-radius:8px">
      </div>
      <div class="form-group">
        <label>Entregado por</label>
        <input type="text" id="ei-entregadoPor" value="${esc(ei ? ei.entregadoPor||'' : '')}" placeholder="Nombre de quien entrega" style="width:100%;padding:8px;border:1.5px solid var(--border);border-radius:8px">
      </div>
      <div class="form-group" style="grid-column:1/-1">
