// Click en una sugerencia: completa el campo con ese artículo.
document.addEventListener('click', e => {
  const sug = e.target.closest && e.target.closest('.vsel-sug');
  if (!sug) return;
  const inp = document.getElementById('vsel-item');
  if (inp) inp.value = sug.getAttribute('data-nombre') || '';
  vSelItemChange();
  const sugs = document.getElementById('vsel-item-sugs');
  if (sugs) sugs.style.display = 'none';
});

// Oculta la lista de sugerencias al salir del campo (con un pequeño retraso
// para permitir que el click sobre una sugerencia se registre primero).
function vSelHideSugsLater() {
  setTimeout(() => {
    const sugs = document.getElementById('vsel-item-sugs');
    if (sugs) sugs.style.display = 'none';
  }, 180);
}
window['vSelHideSugsLater'] = vSelHideSugsLater;

function vSelAddItem() {
  const tipo = v('vsel-tipo');
  const nombre = v('vsel-item').trim();
  if (!nombre) { _info('Escribe el nombre del artículo'); return; }
  const item = _vSelFindItem(tipo, nombre);
  const qty = +v('vsel-qty');
  const price = +v('vsel-price');
  if (!qty || qty <= 0) { _info('Ingresa una cantidad válida'); return; }
  if (price === '' || price < 0 || isNaN(price)) { _info('Ingresa un precio válido'); return; }
  if (item) {
    if (tipo==='consignacion' && (item.cantidad||0) <= 0) { _info('❌ Este artículo ya no está disponible en consignación (stock: 0). No se puede agregar.'); return; }
    if (qty > (item.cantidad||0)) { _info('⚠️ No hay suficiente stock ('+(item.cantidad||0)+' disponible). Se agregará el artículo de cualquier forma.'); }
    ventaItems.push({
      producto: tipo==='consignacion'?item.producto:item.nombre,
      cantidad: qty, precio: price,
      _tipo: tipo, _itemId: item.id, unidad: tipo==='materia'?(item.unidad||''):'',
      _consigFolio: tipo==='consignacion'?(item.folio||undefined):undefined
    });
  } else if (tipo === 'materia') {
    // Materia Prima: si no existe en inventario, se agrega como artículo libre, sin descontar stock.
    ventaItems.push({ producto: nombre, cantidad: qty, precio: price });
  } else {
    _info('Escribe y selecciona un artículo válido de la lista (Producto Terminado / Consignación deben estar dados de alta en inventario)');
    return;
  }
  updateVentaItems();
  vSelRenderPicker();
}
window['vSelAddItem'] = vSelAddItem;

// Abre 'Nueva Venta' ya en la página de Ventas y Pedidos, con un artículo de
// Materia Prima / Productos Terminados / Consignación precargado.
function nuevaVentaDesdeItem(tipo, id) {
  navigate('ventas');
  setTimeout(() => {
    openVentaModal();
    setTimeout(() => {
      const selTipo = document.getElementById('vsel-tipo');
      if (!selTipo) return;
      selTipo.value = tipo;
      vSelRenderPicker();
      setTimeout(() => {
        const item = (db[tipo]||[]).find(i=>i.id===id);
        const selItem = document.getElementById('vsel-item');
        if (selItem && item) selItem.value = (tipo==='consignacion'?item.producto:item.nombre);
        vSelItemChange();
        vSelAddItem();
      }, 30);
    }, 30);
  }, 30);
}
window['nuevaVentaDesdeItem'] = nuevaVentaDesdeItem;

function handleFotoUploadVt(event) {
  const files = [...event.target.files];
  event.target.value = '';
  const disponibles = MAX_FOTOS - _tempFotosVt.length;
  if (disponibles <= 0) { _info(`Límite de ${MAX_FOTOS} fotos por ítem.`); return; }
  const token = _fotoSessionVt;
  files.slice(0, disponibles).forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionVt !== token) return;
      _fotosSubiendoVt++; renderFotosPreviewVt();
      subirFotoAStorage(dataUrl, 'ventas', url => {
        if (_fotoSessionVt !== token) return;
        _fotosSubiendoVt--; _tempFotosVt.push(url); renderFotosPreviewVt();
      });
    });
  });
}
window['handleFotoUploadVt'] = handleFotoUploadVt;
function handleFotoDropVt(event) {
  event.preventDefault();
  event.currentTarget.classList.remove('drag-over');
  const files = Array.from(event.dataTransfer.files || []).filter(f => f.type.startsWith('image/'));
  if (!files.length) return;
  const disponibles = MAX_FOTOS - _tempFotosVt.length;
  if (disponibles <= 0) { _info(`Límite de ${MAX_FOTOS} fotos por ítem.`); return; }
  const token = _fotoSessionVt;
  files.slice(0, disponibles).forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSessionVt !== token) return;
      _fotosSubiendoVt++; renderFotosPreviewVt();
      subirFotoAStorage(dataUrl, 'ventas', url => {
        if (_fotoSessionVt !== token) return;
        _fotosSubiendoVt--; _tempFotosVt.push(url); renderFotosPreviewVt();
      });
    });
  });
}
window['handleFotoDropVt'] = handleFotoDropVt;
function renderFotosPreviewVt() {
  const cont = document.getElementById('fotos-preview-vt');
