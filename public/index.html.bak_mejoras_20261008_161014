function _verFotoGrande(idx, source) {
  // source='re' para _reFotos (Reporte Entrega); extensible a otros arrays
  const imgs = _reFotos;
  if (!imgs || !imgs.length) return;
  let cur = idx;

  // Evitar duplicados
  let lb = document.getElementById('_foto-lightbox');
  if (lb) lb.remove();

  lb = document.createElement('div');
  lb.id = '_foto-lightbox';
  lb.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.93);display:flex;flex-direction:column;align-items:center;justify-content:center;touch-action:none';

  function _lbRender() {
    lb.innerHTML = `
      <div style="position:absolute;top:12px;right:12px;display:flex;gap:8px;z-index:1">
        <span style="color:rgba(255,255,255,0.6);font-size:0.85rem;line-height:40px;padding:0 6px">${cur+1} / ${imgs.length}</span>
        <button id="_lb-close" style="background:rgba(255,255,255,0.15);color:white;border:none;border-radius:50%;width:40px;height:40px;font-size:22px;cursor:pointer;line-height:1">✕</button>
      </div>
      ${imgs.length > 1 ? `
      <button id="_lb-prev" style="position:absolute;left:8px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.15);color:white;border:none;border-radius:50%;width:44px;height:44px;font-size:24px;cursor:pointer;z-index:1">‹</button>
      <button id="_lb-next" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.15);color:white;border:none;border-radius:50%;width:44px;height:44px;font-size:24px;cursor:pointer;z-index:1">›</button>
      ` : ''}
      <img src="${imgs[cur]}" style="max-width:92vw;max-height:85vh;object-fit:contain;border-radius:8px;box-shadow:0 8px 40px rgba(0,0,0,0.6);user-select:none" draggable="false" />
    `;

    lb.querySelector('#_lb-close').onclick = () => lb.remove();
    const prev = lb.querySelector('#_lb-prev');
    const next = lb.querySelector('#_lb-next');
    if (prev) prev.onclick = () => { cur = (cur - 1 + imgs.length) % imgs.length; _lbRender(); };
    if (next) next.onclick = () => { cur = (cur + 1) % imgs.length; _lbRender(); };

    // Swipe táctil
    let tx0 = null;
    lb.ontouchstart = e => { tx0 = e.touches[0].clientX; };
    lb.ontouchend = e => {
      if (tx0 === null || imgs.length < 2) return;
      const dx = e.changedTouches[0].clientX - tx0;
      tx0 = null;
      if (Math.abs(dx) < 40) return;
      cur = dx < 0 ? (cur + 1) % imgs.length : (cur - 1 + imgs.length) % imgs.length;
      _lbRender();
    };
  }

  _lbRender();
  document.body.appendChild(lb);

  // Cerrar con Escape
  function _lbKey(e) {
    if (e.key === 'Escape') { lb.remove(); document.removeEventListener('keydown', _lbKey); }
    if (e.key === 'ArrowRight' && imgs.length > 1) { cur = (cur+1)%imgs.length; _lbRender(); }
    if (e.key === 'ArrowLeft' && imgs.length > 1) { cur = (cur-1+imgs.length)%imgs.length; _lbRender(); }
  }
  document.addEventListener('keydown', _lbKey);
}
window['_verFotoGrande'] = _verFotoGrande;

async function guardarReporteEntrega(vtId) {
  if (_reFotosSubiendo > 0) { _info('Espera a que terminen de subir las fotos.'); return; }
  const vt = findById(db.ventas, vtId);
  if (!vt) return;
  try {
    const items = _RE_ITEMS.map(it => {
      const okBtn = document.getElementById('re-ok-'+it.key);
      const naBtn = document.getElementById('re-na-'+it.key);
      let estado = '';
      if (okBtn && okBtn.classList.contains('btn-success')) estado = 'ok';
      else if (naBtn && naBtn.classList.contains('btn-warning')) estado = 'na';
      const nota = document.getElementById('re-nota-'+it.key)?.value || '';
      return { key:it.key, label:it.label, remolque:!!it.remolque, estado, nota };
    });
    const fecha      = document.getElementById('re-fecha')?.value   || today();
    const revisadoPor= document.getElementById('re-revisor')?.value || session.nombre;
    const notas      = document.getElementById('re-notas')?.value   || '';

    // Subir a R2 cualquier foto que quedó como base64 (falló el upload inicial)
    _info('⏳ Subiendo fotos…');
    const fotosFinales = await Promise.all(_reFotos.map(src =>
      new Promise(resolve => {
        if (typeof src === 'string' && src.startsWith('data:')) {
          subirFotoAStorage(src, 'reportesEntrega', url => resolve(url));
        } else {
          resolve(src);
        }
      })
    ));

    db.reportesEntrega = db.reportesEntrega || [];
    const idx = db.reportesEntrega.findIndex(r => r.pedidoId === vt.id || r.folioPedido === vt.folioPedido);
    const rep = {
      id: idx>=0 ? db.reportesEntrega[idx].id : sid(),
      pedidoId: vt.id, folioPedido: vt.folioPedido||'',
      cliente: vt.cliente, fecha, revisadoPor, items, fotos: fotosFinales, notas
    };
    if (idx >= 0) db.reportesEntrega[idx] = rep;
    else db.reportesEntrega.push(rep);
    saveDb(['reportesEntrega']);
  } catch(e) {
    console.error('[guardarReporteEntrega]', e);
  } finally {
    closeModal();
    _info('✅ Reporte de entrega guardado.');
  }
}
window['guardarReporteEntrega'] = guardarReporteEntrega;

