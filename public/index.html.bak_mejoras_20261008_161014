// Declaración del flag de sincronización pendiente
let _hasPendingSync = false;
// Set de colecciones que cambiaron y aún no se confirmó su escritura en Firestore.
// Se persiste en localStorage para sobrevivir recargas de página.
const _PENDING_SYNC_KEY = 'gp_pending_sync_cols';
let _pendingSyncCols = new Set();
try { JSON.parse(localStorage.getItem(_PENDING_SYNC_KEY) || '[]').forEach(c => _pendingSyncCols.add(c)); } catch(e) {}
function _markPendingSync(cols) {
  (Array.isArray(cols) ? cols : [cols]).forEach(c => _pendingSyncCols.add(c));
  try { localStorage.setItem(_PENDING_SYNC_KEY, JSON.stringify([..._pendingSyncCols])); } catch(e) {}
}
function _clearPendingSync() {
  _pendingSyncCols.clear();
  try { localStorage.removeItem(_PENDING_SYNC_KEY); } catch(e) {}
}
// Flag: la app terminó de cargar datos desde Firestore — evita subir datos vacíos antes de tiempo
let _appReady = false;

// ── Tombstones: IDs eliminados explícitamente ─────────────────────────────
// Previene que el merge offline restaure items borrados intencionalmente en otro dispositivo.
const _FS_TOMBSTONES_KEY = 'gp_fs_tombstones';
let _fsTombstones = {};
try { _fsTombstones = JSON.parse(localStorage.getItem(_FS_TOMBSTONES_KEY) || '{}'); } catch(e) { _fsTombstones = {}; }
// Limpiar tombstones con más de 60 días al cargar
(function() {
  const cutoff = Date.now() - 60 * 24 * 60 * 60 * 1000;
  let changed = false;
  Object.keys(_fsTombstones).forEach(col => {
    Object.keys(_fsTombstones[col] || {}).forEach(id => {
      if (_fsTombstones[col][id] < cutoff) { delete _fsTombstones[col][id]; changed = true; }
    });
  });
  if (changed) try { localStorage.setItem(_FS_TOMBSTONES_KEY, JSON.stringify(_fsTombstones)); } catch(e) {}
})();
function _addTombstone(colName, id) {
  if (!_fsTombstones[colName]) _fsTombstones[colName] = {};
  _fsTombstones[colName][String(id)] = Date.now();
  try { localStorage.setItem(_FS_TOMBSTONES_KEY, JSON.stringify(_fsTombstones)); } catch(e) {}
  // Persistir en Firestore para que otros dispositivos también lo respeten
  _saveTombstoneFirestore(colName, id);
}
function _saveTombstoneFirestore(colName, id) {
  if (typeof FIREBASE_ENABLED === 'undefined' || !FIREBASE_ENABLED || !firestore) return;
  const update = {};
  update[colName + '.' + String(id)] = Date.now();
  // update() actualiza solo el campo específico sin tocar el resto del mapa
  firestore.collection('_meta').doc('tombstones').update(update)
    .catch(err => {
      if (err.code === 'not-found') {
        // Primera vez: el documento no existe aún, crearlo
        const setData = { [colName]: { [String(id)]: Date.now() } };
        firestore.collection('_meta').doc('tombstones').set(setData, { merge: true })
          .catch(e => console.warn('[tombstone] FS set error:', e));
      } else {
        console.warn('[tombstone] FS update error:', err);
      }
    });
}

