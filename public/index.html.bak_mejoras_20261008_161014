// ===================== SISTEMA DE RECORDATORIOS =====================
(function() {
  let _panelSnoozedUntil = 0; // snooze temporal al cerrar con ✕ (15 min)
  const SNOOZE_KEY = '_rec_snooze'; // localStorage key
  const DISMISS_ID_KEY = '_rec_dismissed_ids'; // descartados permanentes por ID

  function _getSnooze() {
    try { return JSON.parse(localStorage.getItem(SNOOZE_KEY) || '{}'); } catch { return {}; }
  }
  function _setSnooze(obj) {
    try { localStorage.setItem(SNOOZE_KEY, JSON.stringify(obj)); } catch {}
  }
  function _snoozeItem(key, minutos) {
    const s = _getSnooze();
    s[key] = Date.now() + minutos * 60000;
    _setSnooze(s);
  }
  function _dismissItem(key) {
    const s = _getSnooze();
    s[key] = 9999999999999;
    _setSnooze(s);
  }
  // Descarte robusto por ID (no depende de recFecha/recHora)
  function _dismissById(id) {
    try {
      const ids = JSON.parse(localStorage.getItem(DISMISS_ID_KEY) || '[]');
      if (!ids.includes(String(id))) { ids.push(String(id)); localStorage.setItem(DISMISS_ID_KEY, JSON.stringify(ids)); }
    } catch {}
  }
  function _isDismissedById(id) {
    try { return JSON.parse(localStorage.getItem(DISMISS_ID_KEY) || '[]').includes(String(id)); } catch { return false; }
  }
  // Quitar del listado cuando se reactive explicitamente (recHecho=false desde Firestore)
  function _undismissById(id) {
    try {
      const ids = JSON.parse(localStorage.getItem(DISMISS_ID_KEY) || '[]').filter(x => x !== String(id));
      localStorage.setItem(DISMISS_ID_KEY, JSON.stringify(ids));
    } catch {}
  }

  function _recKey(c) { return 'cz_' + c.id + '_' + (c.recFecha || '') + '_' + (c.recHora || ''); }

  function _vencido(c) {
    // Descarte permanente por ID — primera comprobación, independiente de Firestore
    if (_isDismissedById(c.id)) return false;
    if (!c.recFecha || c.recHecho) return false;
    // Snooze guardado directamente en la cotización (persistente en Firestore)
    if (c.recSnoozeHasta && c.recSnoozeHasta > Date.now()) return false;
    // Snooze por llave completa (compatibilidad)
    try { const _s = _getSnooze(); const _k = _recKey(c); if (_s[_k] && _s[_k] > Date.now()) return false; } catch(e) {}
    const hoy = today();
    if (c.recFecha > hoy) return false;
    if (c.recFecha < hoy) return true; // fecha pasada → siempre vencido
    // Misma fecha → revisar hora
    if (!c.recHora || c.recHora === 'Todo el día') return true;
    const [hh, mm] = c.recHora.split(':').map(Number);
    const ahora = new Date();
    return ahora.getHours() > hh || (ahora.getHours() === hh && ahora.getMinutes() >= mm);
  }

  function _checkRecordatorios() {
    if (!db || !session) return;
    const esAdmin = session.rol === 'admin';
    // Admin ve todos los recordatorios (o solo del usuario filtrado); otros solo los suyos
    const usuarioFiltro = window._recFiltroUsuario || null;
    // _vencido ya revisa recSnoozeHasta internamente
    const pendientes = (db.cotizaciones || []).filter(c => {
      if (!_vencido(c)) return false;
      if (!esAdmin && c.usuario !== session.nombre) return false;
      if (esAdmin && usuarioFiltro && c.usuario !== usuarioFiltro) return false;
      return true;
    });
    if (!pendientes.length) { const _ep=document.getElementById('_rec-panel'); if(_ep) _ep.remove(); return; }
    if (_panelSnoozedUntil > Date.now()) return; // cerrado con ✕, esperar snooze
    _mostrarPopupRecordatorios(pendientes, esAdmin);
    // Notificación del navegador
    if (window.Notification && Notification.permission === 'granted') {
      pendientes.forEach(c => {
        new Notification('🔔 Recordatorio — ' + c.cliente, {
          body: c.recNota || ('Cotización #' + c.id),
          icon: '/logo.png',
          tag: _recKey(c)
        });
      });
    } else if (window.Notification && Notification.permission !== 'denied') {
      Notification.requestPermission();
    }
  }

  function _mostrarPopupRecordatorios(items, esAdmin) {
    const existente = document.getElementById('_rec-panel');
    if (existente) existente.remove();

    // Inyectar estilos del panel si no existen
    if (!document.getElementById('_rec-styles')) {
      const st = document.createElement('style');
      st.id = '_rec-styles';
      st.textContent = `
        #_rec-panel { position:fixed;top:56px;right:14px;z-index:9990;width:300px;
          max-height:420px;
          background:var(--surface-2,#fff);border:0.5px solid #cbd5e1;border-radius:12px;
          display:flex;flex-direction:column;font-family:inherit;
          box-shadow:0 8px 24px rgba(0,0,0,0.13);
          animation:_rec-slide-in 0.18s ease; }
        @keyframes _rec-slide-in { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:translateY(0)} }
        #_rec-panel .rec-item { display:flex;align-items:flex-start;gap:9px;
          padding:10px 14px;border-bottom:1px solid #f1f5f9;cursor:default; }
        #_rec-panel .rec-item:hover { background:#f8fafc; }
        #_rec-panel .rec-dot { width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:5px; }
        #_rec-panel .rec-dot.vencido { background:#ef4444; }
        #_rec-panel .rec-dot.hoy { background:#f59e0b; }
      `;
      document.head.appendChild(st);
    }

    const snoozeOpts = [
      { label:'5 minutos', val:5 }, { label:'15 minutos', val:15 },
      { label:'30 minutos', val:30 }, { label:'1 hora', val:60 },
      { label:'2 horas', val:120 }, { label:'4 horas', val:240 },
      { label:'1 día', val:1440 }, { label:'2 días', val:2880 },
      { label:'3 días', val:4320 }, { label:'1 semana', val:10080 },
      { label:'2 semanas', val:20160 }, { label:'Mañana (8:00 am)', val:'tomorrow' },
      { label:'Fecha manual...', val:'manual' }
    ];

    // Dropdown de usuarios: incluye todos los que tienen recordatorios pendientes,
    // más cualquier secretaria/auxiliar aunque no tengan recordatorios aún
    const _czUsuariosRec = esAdmin ? [...new Set([
      ...( (_rolesParaCaja||[]).filter(u=>u.rol==='secretaria'||u.rol==='auxiliar').map(u=>u.nombre) ),
      ...(db.cotizaciones||[]).filter(c=>c.recFecha&&!c.recHecho).map(c=>c.usuario).filter(Boolean)
    ])].sort() : [];

    const panel = document.createElement('div');
    panel.id = '_rec-panel';
    panel.innerHTML = `
      <div id="_rec-header" style="background:#1d4ed8;color:white;padding:12px 14px;display:flex;align-items:center;gap:8px;flex-shrink:0;user-select:none">
        <span style="font-size:1rem">🔔</span>
        <span style="font-weight:600;font-size:0.88rem;flex:1">Recordatorios <span style="font-weight:400;opacity:0.85">(${items.length})</span></span>
        ${esAdmin && _czUsuariosRec.length > 1 ? `
          <select id="_rec-user-filter" style="font-size:0.72rem;padding:2px 5px;border:none;border-radius:5px;background:rgba(255,255,255,0.18);color:white;cursor:pointer;max-width:100px;outline:none">
            <option value="" style="color:#1e293b">Todos</option>
            ${_czUsuariosRec.map(u=>`<option value="${esc(u)}" style="color:#1e293b" ${(window._recFiltroUsuario||'')=== u?'selected':''}>${esc(u)}</option>`).join('')}
          </select>` : ''}
        <button id="_rec-min" style="background:none;border:none;color:white;font-size:1.1rem;cursor:pointer;padding:0 3px;line-height:1;opacity:0.8" title="Minimizar">—</button>
        <button id="_rec-close" style="background:none;border:none;color:white;font-size:1.1rem;cursor:pointer;padding:0;line-height:1;opacity:0.8">✕</button>
      </div>
      <div id="_rec-body" style="flex:1;overflow-y:auto">
        ${items.map(c => {
          const hoy = typeof today === 'function' ? today() : new Date().toISOString().slice(0,10);
          const vencido = c.recFecha < hoy;
          const dotCls = vencido ? 'vencido' : 'hoy';
          const tiempoLabel = vencido
            ? `<span style="color:#ef4444;font-size:0.72rem">Vencido</span>`
            : `<span style="color:#f59e0b;font-size:0.72rem">Hoy</span>`;
          const k = _recKey(c);
          return `<div class="rec-item" data-key="${k}" data-id="${c.id}">
            <div class="rec-dot ${dotCls}"></div>
            <div style="flex:1;min-width:0">
              <div style="font-weight:600;font-size:0.83rem;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(c.cliente)}</div>
              <div style="font-size:0.72rem;color:#64748b;margin-top:1px">
                ${c.recHora && c.recHora!=='Todo el día' ? c.recHora+' · ' : ''}${tiempoLabel}
                ${esAdmin && c.usuario ? ` · <span style="color:#7c3aed">${esc(c.usuario)}</span>` : ''}
              </div>
              ${c.recNota ? `<div style="font-size:0.76rem;color:#475569;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(c.recNota)}</div>` : ''}
              <div style="display:flex;gap:4px;margin-top:6px;flex-wrap:wrap">
                <button onclick="window._recAbrir(${c.id})" style="font-size:0.7rem;padding:2px 8px;border:1px solid #cbd5e1;border-radius:5px;background:white;color:#2563eb;cursor:pointer">Abrir</button>
                <button onclick="window._recDescartar('${k}',${c.id})" style="font-size:0.7rem;padding:2px 8px;border:1px solid #fca5a5;border-radius:5px;background:#fff5f5;color:#dc2626;cursor:pointer">Descartar</button>
              </div>
              <div style="display:flex;gap:4px;margin-top:5px">
                <select class="_rec-item-snooze" data-key="${k}" onchange="const inp=this.closest('div').querySelector('._rec-manual-inp');if(inp)inp.style.display=this.value==='manual'?'block':'none'" style="flex:1;font-size:0.68rem;padding:3px 4px;border:1px solid #e2e8f0;border-radius:5px;background:white;color:#1e293b;min-width:0">
                  ${snoozeOpts.map(o=>`<option value="${o.val}">${o.label}</option>`).join('')}
                </select>
                <button data-id="${c.id}" onclick="window._recPosponer(this)" style="font-size:0.68rem;padding:3px 8px;border:none;border-radius:5px;background:#1d4ed8;color:white;cursor:pointer;white-space:nowrap">Posponer</button>
                <input type="date" class="_rec-manual-inp" style="display:none;width:100%;font-size:0.68rem;padding:3px 4px;border:1px solid #93c5fd;border-radius:5px;margin-top:2px">
              </div>
            </div>
          </div>`;
        }).join('')}
      </div>
      <div id="_rec-foot" style="padding:10px 14px;border-top:1px solid #e2e8f0;flex-shrink:0;display:flex;flex-direction:column;gap:6px">
        <select id="_rec-snooze-sel" onchange="const inp=document.getElementById('_rec-snooze-manual');if(inp)inp.style.display=this.value==='manual'?'block':'none'" style="width:100%;padding:6px 8px;border:1px solid #e2e8f0;border-radius:7px;font-size:0.8rem;background:white;color:#1e293b">
          ${snoozeOpts.map(o=>`<option value="${o.val}">${o.label}</option>`).join('')}
        </select>
        <input type="date" id="_rec-snooze-manual" style="display:none;width:100%;padding:6px 8px;border:1px solid #93c5fd;border-radius:7px;font-size:0.8rem;box-sizing:border-box">
        <div style="display:flex;gap:6px">
          <button id="_rec-snooze-btn" style="flex:1;padding:6px;background:#1d4ed8;color:white;border:none;border-radius:7px;cursor:pointer;font-size:0.8rem;font-weight:600">Posponer todos</button>
          <button id="_rec-dismiss-all" style="flex:1;padding:6px;background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;border-radius:7px;cursor:pointer;font-size:0.8rem">Descartar todo</button>
        </div>
      </div>`;

    document.body.appendChild(panel);

    // Restaurar posición guardada
    if (window._recPanelPos) {
      panel.style.top = window._recPanelPos.y + 'px';
      panel.style.left = window._recPanelPos.x + 'px';
      panel.style.right = 'auto';
    }

    // Restaurar estado minimizado
    if (window._recPanelMinimized) {
      const _rb = panel.querySelector('#_rec-body');
      const _rf = panel.querySelector('#_rec-foot');
      if (_rb) _rb.style.display = 'none';
      if (_rf) _rf.style.display = 'none';
      const _rm = panel.querySelector('#_rec-min');
      if (_rm) _rm.textContent = '□';
    }

    // Minimizar / expandir
    panel.querySelector('#_rec-min').onclick = () => {
      const rb = panel.querySelector('#_rec-body');
      const rf = panel.querySelector('#_rec-foot');
      const rm = panel.querySelector('#_rec-min');
      const isMin = rb && rb.style.display === 'none';
      if (rb) rb.style.display = isMin ? '' : 'none';
      if (rf) rf.style.display = isMin ? '' : 'none';
      if (rm) rm.textContent = isMin ? '—' : '□';
      window._recPanelMinimized = !isMin;
    };

    // Drag para mover el panel
    if (window._recDragMove) document.removeEventListener('mousemove', window._recDragMove);
    if (window._recDragUp)   document.removeEventListener('mouseup',   window._recDragUp);
    const _recHdr = panel.querySelector('#_rec-header');
    let _recDragging = false, _recOx = 0, _recOy = 0;
    _recHdr.style.cursor = 'grab';
    _recHdr.addEventListener('mousedown', e => {
      if (e.target.closest('button,select')) return;
      _recDragging = true;
      const rect = panel.getBoundingClientRect();
      _recOx = e.clientX - rect.left;
      _recOy = e.clientY - rect.top;
      _recHdr.style.cursor = 'grabbing';
      e.preventDefault();
    });
    window._recDragMove = e => {
      if (!_recDragging) return;
      let nx = e.clientX - _recOx;
      let ny = e.clientY - _recOy;
      nx = Math.max(0, Math.min(window.innerWidth - panel.offsetWidth, nx));
      ny = Math.max(0, Math.min(window.innerHeight - 40, ny));
      panel.style.left = nx + 'px';
      panel.style.top  = ny + 'px';
      panel.style.right = 'auto';
      window._recPanelPos = { x: nx, y: ny };
    };
    window._recDragUp = () => { _recDragging = false; _recHdr.style.cursor = 'grab'; };
    document.addEventListener('mousemove', window._recDragMove);
    document.addEventListener('mouseup',   window._recDragUp);

    // Selector usuario (admin)
    const userFilterEl = panel.querySelector('#_rec-user-filter');
    if (userFilterEl) {
      userFilterEl.onchange = () => {
        window._recFiltroUsuario = userFilterEl.value;
        panel.remove();
        _checkRecordatorios();
      };
    }

    panel.querySelector('#_rec-close').onclick = () => {
      window._recFiltroUsuario = '';
      window._recPanelPos = null;
      window._recPanelMinimized = false;
      if (window._recDragMove) document.removeEventListener('mousemove', window._recDragMove);
      if (window._recDragUp)   document.removeEventListener('mouseup',   window._recDragUp);
      _panelSnoozedUntil = Date.now() + 15 * 60 * 1000; // vuelve a aparecer en 15 min
      panel.remove();
    };

    panel.querySelector('#_rec-snooze-btn').onclick = () => {
      const selVal = document.getElementById('_rec-snooze-sel').value;
      let manualTs = null;
      if (selVal === 'manual') {
        const dv = document.getElementById('_rec-snooze-manual')?.value;
        if (!dv) { alert('Selecciona una fecha'); return; }
        const d = new Date(dv + 'T08:00:00');
        if (isNaN(d.getTime())) { alert('Fecha inválida'); return; }
        manualTs = d.getTime();
      }
      items.forEach(c => {
        if (selVal === 'tomorrow') {
          const tom = new Date(); tom.setDate(tom.getDate()+1); tom.setHours(8,0,0,0);
          c.recSnoozeHasta = tom.getTime();
        } else if (selVal === 'manual') {
          c.recSnoozeHasta = manualTs;
        } else {
          c.recSnoozeHasta = Date.now() + parseInt(selVal) * 60000;
        }
        // Escritura directa a Firestore (sin batch) para que el snooze persista
        // aunque el usuario cierre la app inmediatamente después.
        if (firestore) firestore.collection('cotizaciones').doc(String(c.id))
          .update({ recSnoozeHasta: c.recSnoozeHasta }).catch(() => {});
      });
      saveDb('cotizaciones');
      panel.remove();
    };

    panel.querySelector('#_rec-dismiss-all').onclick = () => {
      try { if (!window._ownWriteUntilByCol) window._ownWriteUntilByCol = {}; window._ownWriteUntilByCol['cotizaciones'] = Math.max(window._ownWriteUntilByCol['cotizaciones']||0, Date.now()+30000); } catch(e) {}
      items.forEach(c => {
        _dismissItem(_recKey(c));
        _dismissById(c.id); // descarte robusto por ID
        c.recHecho = true;
        c.recSnoozeHasta = 9999999999999;
        // Actualizar _serverSnapshot para que saveDb no revierta a recHecho:false
        try { if (window._serverSnapshot?.cotizaciones) { const _ss = window._serverSnapshot.cotizaciones[String(c.id)]; if (_ss) { _ss.recHecho = true; _ss.recSnoozeHasta = 9999999999999; } } } catch(e) {}
        if (firestore) firestore.collection('cotizaciones').doc(String(c.id))
          .set({ recHecho: true, recSnoozeHasta: 9999999999999 }, { merge: true }).catch(() => {});
      });
      saveDb('cotizaciones');
      panel.remove();
    };
  }

  // Posponer un item individual — guarda snooze en la cotización (Firestore)
  window._recPosponer = function(btn) {
    const id = parseInt(btn.dataset.id);
    const sel = btn.previousElementSibling;
    if (!id || !sel) return;
    const selVal = sel.value;
    const cot = db && findById(db.cotizaciones, id);
    if (!cot) return;
    if (selVal === 'tomorrow') {
      const tom = new Date(); tom.setDate(tom.getDate()+1); tom.setHours(8,0,0,0);
      cot.recSnoozeHasta = tom.getTime();
    } else if (selVal === 'manual') {
      const inp = btn.closest('.rec-item')?.querySelector('._rec-manual-inp');
      if (!inp || !inp.value) { alert('Selecciona una fecha'); return; }
      const d = new Date(inp.value + 'T08:00:00');
      if (isNaN(d.getTime())) { alert('Fecha inválida'); return; }
      cot.recSnoozeHasta = d.getTime();
    } else {
      cot.recSnoozeHasta = Date.now() + parseInt(selVal) * 60000;
    }
    // Escritura directa para garantizar persistencia
    if (firestore) firestore.collection('cotizaciones').doc(String(cot.id))
      .update({ recSnoozeHasta: cot.recSnoozeHasta }).catch(() => {});
    saveDb('cotizaciones');
    const row = btn.closest('.rec-item');
    if (row) {
      row.remove();
      const remaining = document.querySelectorAll('#_rec-panel .rec-item');
      if (!remaining.length) document.getElementById('_rec-panel')?.remove();
    }
  };

  // Abrir cotización desde el panel
  window._recAbrir = function(id) {
    window._recAbrirCotizId = id;   // marca para que verCotiz muestre banner
    document.getElementById('_rec-panel')?.remove();
    navigate('cotizaciones');
    // Reintentar hasta que la página haya renderizado (evita fallo en tabletas lentas)
    let _recAbrirIntentos = 0;
    const _recAbrirIntento = () => {
      _recAbrirIntentos++;
      // La página está lista si existe la tabla de cotizaciones en el DOM
      const listo = !!document.getElementById('tbl-cotiz') || !!document.querySelector('[data-czid]');
      if (listo) {
        verCotiz && verCotiz(id);
      } else if (_recAbrirIntentos < 20) {
        setTimeout(_recAbrirIntento, 150);
      }
    };
    setTimeout(_recAbrirIntento, 200);
  };

  // Descartar un item individual
  window._recDescartar = function(key, id) {
    _dismissItem(key);
    _dismissById(id); // descarte robusto por ID, no depende de recFecha/recHora
    // Extender guard para que onSnapshot no restaure recHecho:false antes de que Firestore confirme
    try { if (!window._ownWriteUntilByCol) window._ownWriteUntilByCol = {}; window._ownWriteUntilByCol['cotizaciones'] = Math.max(window._ownWriteUntilByCol['cotizaciones']||0, Date.now()+30000); } catch(e) {}
    const c = window.db && findById(db.cotizaciones, id);
    if (c) {
      c.recHecho = true;
      c.recSnoozeHasta = 9999999999999;
      // Actualizar _serverSnapshot para que saveDb no revierta a recHecho:false
      try { if (window._serverSnapshot?.cotizaciones) { const _ss = window._serverSnapshot.cotizaciones[String(c.id)]; if (_ss) { _ss.recHecho = true; _ss.recSnoozeHasta = 9999999999999; } } } catch(e) {}
      saveDb('cotizaciones');
      try { if (firestore) firestore.collection('cotizaciones').doc(String(c.id)).set({ recHecho: true, recSnoozeHasta: 9999999999999 }, { merge: true }).catch(()=>{}); } catch(e) {}
    }
    const row = document.querySelector(`[data-key="${key}"]`);
    if (row) {
      row.remove();
      const remaining = document.querySelectorAll('#_rec-panel .rec-item');
      if (!remaining.length) document.getElementById('_rec-panel')?.remove();
    }
  };

  // Posponer desde el modal de cotización (sin necesitar el DOM del panel)
  window._recPosponerModal = function(id) {
    const selVal = document.getElementById('_rec-modal-snooze')?.value;
    const cot = db && findById(db.cotizaciones, id);
    if (!cot || !selVal) return;
    if (selVal === 'tomorrow') {
      const tom = new Date(); tom.setDate(tom.getDate()+1); tom.setHours(8,0,0,0);
      cot.recSnoozeHasta = tom.getTime();
    } else if (selVal === 'manual') {
      const dv = document.getElementById('_rec-modal-manual-date')?.value;
      if (!dv) { alert('Selecciona una fecha'); return; }
      const allDay = document.getElementById('_rec-modal-allday')?.checked !== false;
      const tv = document.getElementById('_rec-modal-manual-time')?.value || '08:00';
      const timeStr = allDay ? '08:00:00' : (tv.length === 5 ? tv + ':00' : tv);
      const d = new Date(dv + 'T' + timeStr);
      if (isNaN(d.getTime())) { alert('Fecha inválida'); return; }
      cot.recSnoozeHasta = d.getTime();
    } else {
      cot.recSnoozeHasta = Date.now() + parseInt(selVal) * 60000;
    }
    if (firestore) firestore.collection('cotizaciones').doc(String(cot.id))
      .update({ recSnoozeHasta: cot.recSnoozeHasta }).catch(() => {});
    saveDb('cotizaciones');
    const banner = document.getElementById('_rec-modal-banner');
    if (banner) { banner.innerHTML = `<span style="color:#1d4ed8;font-size:0.83rem">⏰ Recordatorio pospuesto.</span>`; }
  };

  // Marcar como hecho desde el modal de cotización
  window._recDescartarModal = function(id) {
    const cot = db && findById(db.cotizaciones, id);
    if (!cot) return;
    const k = _recKey(cot);
    _dismissItem(k);
    _dismissById(id); // descarte robusto por ID
    try { if (!window._ownWriteUntilByCol) window._ownWriteUntilByCol = {}; window._ownWriteUntilByCol['cotizaciones'] = Math.max(window._ownWriteUntilByCol['cotizaciones']||0, Date.now()+30000); } catch(e) {}
    cot.recHecho = true;
    cot.recSnoozeHasta = 9999999999999;
    saveDb('cotizaciones');
    try { if (firestore) firestore.collection('cotizaciones').doc(String(cot.id)).update({ recHecho: true, recSnoozeHasta: 9999999999999 }).catch(()=>{}); } catch(e) {}
    const banner = document.getElementById('_rec-modal-banner');
    if (banner) { banner.innerHTML = `<span style="color:#16a34a;font-size:0.83rem">✅ Recordatorio marcado como hecho.</span>`; }
  };

  // Exponer para que renderPage pueda dispararlo al cargar datos
  window._checkRecordatorios = _checkRecordatorios;
  window._undismissById = _undismissById; // para que funciones externas puedan reactivar recordatorios

  // Iniciar checker — espera a que la app esté lista
  function _initChecker() {
    if (!_appReady) { setTimeout(_initChecker, 1000); return; }
    _checkRecordatorios();
    setInterval(_checkRecordatorios, 60000); // revisar cada minuto
  }
  _initChecker();
})();


// ── Sonidos de interfaz (Web Audio API) ──────────────────────────────────
(function() {
  let _ac = null;
  const _SND_KEY = '_ui_sound';
  let _sndOn = true;
  try { _sndOn = localStorage.getItem(_SND_KEY) !== '0'; } catch(e) {}

  function _getAC() {
    if (!_ac) _ac = new (window.AudioContext || window.webkitAudioContext)();
    return _ac;
  }

  function _playTone(freq, dur, vol, type, freqEnd) {
    if (!_sndOn) return;
    try {
      const ac = _getAC();
      if (ac.state === 'suspended') ac.resume();
      const osc = ac.createOscillator();
      const gain = ac.createGain();
      osc.connect(gain);
      gain.connect(ac.destination);
      osc.type = type || 'sine';
      osc.frequency.setValueAtTime(freq, ac.currentTime);
      if (freqEnd) osc.frequency.exponentialRampToValueAtTime(freqEnd, ac.currentTime + dur);
      gain.gain.setValueAtTime(vol || 0.08, ac.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + dur);
      osc.start(ac.currentTime);
      osc.stop(ac.currentTime + dur);
    } catch(e) {}
  }

  window._uiSound = {
    click:   () => _playTone(900, 0.04, 0.06, 'sine', 600),
    success: () => { _playTone(600, 0.07, 0.07, 'sine'); setTimeout(() => _playTone(900, 0.09, 0.07, 'sine'), 70); },
    error:   () => _playTone(300, 0.15, 0.08, 'sawtooth', 150),
    soft:    () => _playTone(700, 0.035, 0.04, 'sine', 500),
  };

  window._toggleUiSound = function() {
    _sndOn = !_sndOn;
    try { localStorage.setItem(_SND_KEY, _sndOn ? '1' : '0'); } catch(e) {}
    const btn = document.getElementById('sound-toggle-btn');
    if (btn) btn.textContent = _sndOn ? '🔊' : '🔇';
    if (_sndOn) window._uiSound.success();
  };

  // Inicializar icono al cargar
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('sound-toggle-btn');
    if (btn) btn.textContent = _sndOn ? '🔊' : '🔇';
  });

  // Event delegation: detectar clics en botones relevantes
  document.addEventListener('click', function(e) {
    if (!_sndOn) return;
    const el = e.target.closest('button, .btn, [role="button"]');
    if (!el) return;
    if (el.id === 'sound-toggle-btn' || el.id === 'dark-toggle-btn') return;
    const txt = (el.textContent || '').trim().toLowerCase();
    const cls = el.className || '';
    // Sonido de éxito para guardar/confirmar
    if (/guardar|✅|confirmar|✔|listo|agregar|nuevo|crear|registrar|subir|deploy/i.test(txt) ||
        cls.includes('btn-primary') || cls.includes('btn-success')) {
      window._uiSound.success();
    }
    // Sonido de error para eliminar/cancelar
    else if (/eliminar|borrar|cancelar|revocar|rechazar|❌|🗑/i.test(txt) ||
             cls.includes('btn-danger') || cls.includes('btn-red')) {
      window._uiSound.error();
    }
    // Click suave para el resto
    else {
      window._uiSound.soft();
    }
  }, true);
})();

// ── Service Worker (PWA — offline + instalable) ────────────
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js')
      .then(reg => {
        console.log('[PWA] Service Worker registrado:', reg.scope);
        // Revisa actualizaciones cada vez que el usuario navega a la app
        reg.update();
      })
      .catch(err => console.warn('[PWA] Error al registrar SW:', err));
  });
}

// ── Teclado virtual en tablet: barra flotante + ajuste de modal ─────────────
(function() {
  if (!_IS_TABLET) return;

  // Crear barra flotante "Listo ✓" que aparece justo encima del teclado
  const _kbBar = document.createElement('div');
  _kbBar.id = 'kb-dismiss-bar';
  _kbBar.style.cssText = [
    'display:none',
    'position:fixed',
    'left:0','right:0',
    'z-index:99999',
    'background:#f1f5f9',
    'border-top:1px solid #cbd5e1',
    'padding:6px 16px',
    'display:none',
    'align-items:center',
    'justify-content:flex-end',
    'gap:10px',
  ].join(';');
  _kbBar.innerHTML = `<span style="font-size:0.8rem;color:#64748b;flex:1">Toca fuera del campo o presiona Listo para cerrar el teclado</span>
    <button onclick="document.activeElement&&document.activeElement.blur()"
      style="background:#3b82f6;color:white;border:none;border-radius:8px;padding:7px 18px;font-size:0.9rem;font-weight:700;cursor:pointer;min-height:38px">
      ✓ Listo
    </button>`;
  document.body.appendChild(_kbBar);

  const overlay = document.getElementById('modal-overlay');
  const box     = document.getElementById('modal-box');
  const btnHide = document.getElementById('btn-hide-keyboard');

  let _vpRafPending = false;
  function _onViewport() {
    if (_vpRafPending) return; // ya hay un frame pendiente, ignorar este evento
    _vpRafPending = true;
    requestAnimationFrame(() => {
      _vpRafPending = false;
      if (!window.visualViewport) return;
      const vvh      = window.visualViewport.height;
      const wh       = window.innerHeight;
      const kbHeight = Math.max(0, wh - vvh - window.visualViewport.offsetTop);
      const kbVisible = kbHeight > 100;

      // Barra flotante: posicionarla justo encima del teclado
      if (kbVisible) {
        _kbBar.style.display = 'flex';
        _kbBar.style.bottom  = kbHeight + 'px';
      } else {
        _kbBar.style.display = 'none';
      }

      // Botón en header del modal
      if (btnHide) btnHide.style.display = kbVisible ? 'inline-flex' : 'none';

      // Ajustar modal para que footer quede sobre el teclado
      if (overlay && overlay.classList.contains('open')) {
        if (kbVisible) {
          box.style.marginBottom = kbHeight + 'px';
          box.style.maxHeight    = (vvh - 24) + 'px';
        } else {
          box.style.marginBottom = '';
          box.style.maxHeight    = '';
        }
      }
    });
  }

  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', _onViewport);
    window.visualViewport.addEventListener('scroll', _onViewport);
  }

  // Al abrir el modal resetear posición
  const _origShow = window.showModal;
  if (_origShow) {
    window.showModal = function() {
      _origShow.apply(this, arguments);
      setTimeout(_onViewport, 50);
    };
  }
})();
</script>
