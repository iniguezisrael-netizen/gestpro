// ── Helpers atómicos para movimientos de caja ─────────────────────────────────
// En lugar de push+saveDb (que sobreescribe todo el arreglo y puede perder entradas
// escritas por otro dispositivo), usamos arrayUnion para ADDS y una transacción para
// REMOVES. saveDb sigue corriendo después — actualiza la metadata de la caja (fondo,
// cerrada, etc.) y tiene su propia transacción de merge como respaldo.
function _cajaMovAdd(caja, mov) {
  if (!mov.id) mov.id = sid();
  if (!mov.fecha) mov.fecha = today(); // fecha local del dispositivo, no UTC
  caja.movimientos = caja.movimientos || [];
  caja.movimientos.push(mov);
  // Actualiza el saldo local en función del tipo de movimiento
  const delta = mov.tipo === 'entrada' ? (mov.monto || 0) : -(mov.monto || 0);
  caja.saldo = (caja.saldo || 0) + delta;
  // arrayUnion: Firestore añade el elemento de forma atómica SIN leer ni sobreescribir
  // el arreglo completo. Dos dispositivos concurrentes producen la unión, no una pérdida.
  // saldo se escribe junto para que siempre esté sincronizado, evitando el bug delta-snapshot.
  if (FIREBASE_ENABLED && firestore && caja.id) {
    const ref = firestore.collection('cajas').doc(String(caja.id));
    ref.update({
      movimientos: firebase.firestore.FieldValue.arrayUnion(mov),
      saldo: caja.saldo
    }).catch(() => {
        // doc puede no existir aún (primera escritura). El saveDb subsiguiente lo crea.
        _hasPendingSync = true; _markPendingSync('cajas');
      });
  } else if (FIREBASE_ENABLED) {
    _hasPendingSync = true; _markPendingSync('cajas');
  }
}

function _cajaMovRemove(caja, movId) {
  if (!caja || !movId) return;
  // Eliminar en local
  if (caja.movimientos) {
    const idx = caja.movimientos.findIndex(m => m.id === movId);
    if (idx > -1) caja.movimientos.splice(idx, 1);
  }
  // arrayRemove requiere objeto exacto (deep equality). Usamos transacción por ID.
  if (FIREBASE_ENABLED && firestore && caja.id) {
    const ref = firestore.collection('cajas').doc(String(caja.id));
    firestore.runTransaction(async tx => {
      const snap = await tx.get(ref);
      if (!snap.exists) return;
      const movs = (snap.data().movimientos || []).filter(m => m.id !== movId);
      tx.update(ref, { movimientos: movs });
    }).catch(() => { _hasPendingSync = true; _markPendingSync('cajas'); });
  } else if (FIREBASE_ENABLED) {
    _hasPendingSync = true; _markPendingSync('cajas');
  }
}
