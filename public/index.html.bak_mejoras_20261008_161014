function registrarAbonoCobranza(id) {
  const c = db.cobranza.find(x=>x.id===id);
  if (!c) return;
  const monto = +v('abono-monto');
  const saldo = cobranzaSaldo(c);
  if (!monto || monto <= 0) { _info('Ingresa un monto válido'); return; }
  if (monto > saldo + 0.01) { _info('El abono no puede ser mayor al saldo pendiente ($' + fmt(saldo) + ')'); return; }
  const formaPago = document.getElementById('abono-forma')?.value || 'efectivo';
  const esAdmin = session.rol === 'admin';
  const ahora = new Date();
  const fecha = esAdmin ? (document.getElementById('abono-fecha')?.value || today()) : today();
  const hora  = ahora.toTimeString().slice(0,5);
  const nota  = document.getElementById('abono-nota')?.value.trim() || '';

  // Solo efectivo afecta caja chica
  let caja = null;
  if ((session.rol === 'secretaria' || session.rol === 'auxiliar') && formaPago === 'efectivo') {
    caja = cajaActivaOCrear();
  }

  c.abonos = c.abonos || [];
  const nuevoAbono = { monto, fecha, hora, usuario: session.nombre, rol: session.rol, formaPago, ...(nota ? { nota } : {}) };
  c.abonos.push(nuevoAbono);
  if (cobranzaSaldo(c) <= 0.01) c.estado = 'Pagado';

  if (caja) {
    _cajaMovAdd(caja, {
      id: sid(), tipo: 'entrada',
      concepto: 'Abono de cobranza — ' + c.cliente,
      monto, hora, usuario: session.nombre
    });
  }

  // Patch directo a Firestore — cobranza
  if (window._serverSnapshot?.cobranza?.[String(c.id)]) {
    window._serverSnapshot.cobranza[String(c.id)].abonos = c.abonos;
    window._serverSnapshot.cobranza[String(c.id)].estado = c.estado;
  }
  if (FIREBASE_ENABLED && firestore) {
    firestore.collection('cobranza').doc(String(c.id))
      .update({ abonos: c.abonos, estado: c.estado })
      .catch(e => console.error('[cobranza] FS patch error:', e));
  }

  // Sincronizar con la venta vinculada (mismo flujo que registrarPago → cobranza)
  if (c.ventaId) {
    const vt = (db.ventas||[]).find(v => String(v.id) === String(c.ventaId));
    if (vt) {
      vt.pagos = vt.pagos || [];
      const cajaMovId = caja ? sid() : null;
      vt.pagos.push({ monto, fecha, hora, nota, recibidoPor: session.nombre, formaPago, cajaMovId, cajaUsuario: cajaMovId ? session.nombre : null });
      vt.anticipo = vt.pagos.reduce((s,p) => s + p.monto, 0);
      vt.saldo    = Math.max(0, vt.total - vt.anticipo);
      if (vt.saldo === 0) {
        vt.estado = 'Pagada';
        // Marcar consignación vinculada como Vendido
        (db.consignacion||[]).filter(ci => String(ci.ventaId) === String(vt.id))
          .forEach(ci => { ci.estado = 'Vendido'; });
      }
      if (window._serverSnapshot?.ventas?.[String(vt.id)]) {
        window._serverSnapshot.ventas[String(vt.id)].pagos    = vt.pagos;
        window._serverSnapshot.ventas[String(vt.id)].anticipo = vt.anticipo;
        window._serverSnapshot.ventas[String(vt.id)].saldo    = vt.saldo;
        window._serverSnapshot.ventas[String(vt.id)].estado   = vt.estado;
      }
      if (FIREBASE_ENABLED && firestore) {
        firestore.collection('ventas').doc(String(vt.id))
          .update({ pagos: vt.pagos, anticipo: vt.anticipo, saldo: vt.saldo, estado: vt.estado })
          .catch(e => console.error('[cobranza→venta sync] FS patch error:', e));
      }
    }
  }

  const colsSave = ['cobranza', ...(caja ? ['cajas'] : []), ...(c.ventaId ? ['ventas','consignacion'] : [])];
  saveDb(colsSave); closeModal(); renderCobranza();
}

