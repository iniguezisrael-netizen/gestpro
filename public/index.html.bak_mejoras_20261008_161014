function saveDb(colChanged) {
  // localStorage (backup local): solo guardar las colecciones que cambiaron,
  // no todas. Reduce escrituras en tablets lentas.
  const lsCols = colChanged
    ? (Array.isArray(colChanged) ? colChanged : [colChanged])
    : Object.keys(_LS_KEYS);
  lsCols.forEach(c => {
    const key = _LS_KEYS[c];
    if (key) save(key, db[c] != null ? db[c] : []);
  });
  // Firestore (nube)
  if (FIREBASE_ENABLED && firestore) {
    const isOffline = !navigator.onLine;
    // Proteger datos locales durante la escritura (online o offline).
    // En offline, Firestore encola la escritura en IndexedDB y la envía al reconectarse;
    // el guard asegura que ese snapshot tardío no sobreescriba datos locales.
    // Guard por colección: solo bloquea snapshots de las colecciones que estamos escribiendo.
    // Evita que una escritura en "ventas" bloquee actualizaciones de "consignacion" del tablet.
    if (!window._ownWriteUntilByCol) window._ownWriteUntilByCol = {};
    const cols = colChanged ? (Array.isArray(colChanged) ? colChanged : [colChanged]) : FS_COLLECTIONS;
    cols.forEach(c => { window._ownWriteUntilByCol[c] = Date.now() + 2000; });
    if (isOffline) {
      // Sin internet: marcamos como pendiente y guardamos QUÉ colecciones cambiaron.
      // Al reconectar solo subimos esas, no todas.
      setSyncStatus('offline');
      _hasPendingSync = true;
      _markPendingSync(cols);
    } else {
      setSyncStatus('syncing');
    }
    // Timeout de 20s: el dato ya está seguro en localStorage e IndexedDB de Firestore,
    // así que mostramos 'ok' aunque Firestore no haya confirmado aún. La escritura
    // sigue corriendo en segundo plano; si falla, se marca pendiente para el próximo reconect.
    let _timeoutFired = false;
    const _syncTimeout = setTimeout(() => {
      if (!isOffline) { _timeoutFired = true; setSyncStatus('ok'); }
    }, 20000);
    Promise.all(cols.map(c => fsWriteCollection(c, db[c])))
      .then(() => {
        clearTimeout(_syncTimeout);
        if (!isOffline) {
          // Extender ventana 1s más tras confirmar para atrapar snapshots tardíos
          cols.forEach(c => { window._ownWriteUntilByCol[c] = Math.max(window._ownWriteUntilByCol[c] || 0, Date.now() + 1000); });
          _hasPendingSync = false;
          setSyncStatus('ok');
          _programarRespaldo();
        }
      })
      .catch(e => {
        clearTimeout(_syncTimeout);
        console.error('Sync error:', e);
        // Marcar como pendiente para reintentar al reconectar
        _markPendingSync(cols);
        _hasPendingSync = true;
        // Solo mostrar error si el timeout aún no había mostrado 'ok'
        if (!_timeoutFired) {
          setSyncStatus('error', e && e.message ? e.message : String(e));
        }
      });
  }
}

