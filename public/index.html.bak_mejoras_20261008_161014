        // Actualizar _serverSnapshot para que saveDb no revierta el pago
        if (window._serverSnapshot?.ventas?.[String(vt.id)]) {
          window._serverSnapshot.ventas[String(vt.id)].pagos = vt.pagos;
          window._serverSnapshot.ventas[String(vt.id)].anticipo = vt.anticipo;
          window._serverSnapshot.ventas[String(vt.id)].saldo = vt.saldo;
          window._serverSnapshot.ventas[String(vt.id)].estado = vt.estado;
        }
        // PATCH directo: garantiza que el pago llega a Firestore
        // aunque saveDb tenga snapshot desactualizado (mismo fix que archivarVenta)
        if (firestore) {
          firestore.collection('ventas').doc(String(vt.id))
            .update({ pagos: vt.pagos, anticipo: vt.anticipo, saldo: vt.saldo, estado: vt.estado })
            .catch(e => console.error('[registrarPago] FS patch error:', e));
        }
      }
      // Si la venta tiene cobranzaId, sincronizar el abono en cobranza automáticamente
      if (vt.cobranzaId) {
        const _cob = (db.cobranza||[]).find(c => c.id === vt.cobranzaId);
        if (_cob && _cob.estado !== 'Pagado') {
          _cob.abonos = _cob.abonos || [];
          _cob.abonos.push({ monto, fecha, hora, usuario: session.nombre, rol: session.rol, formaPago });
          if (cobranzaSaldo(_cob) <= 0.01) _cob.estado = 'Pagado';
          if (window._serverSnapshot?.cobranza?.[String(_cob.id)]) {
            window._serverSnapshot.cobranza[String(_cob.id)].abonos = _cob.abonos;
            window._serverSnapshot.cobranza[String(_cob.id)].estado = _cob.estado;
          }
          if (FIREBASE_ENABLED && firestore) {
            firestore.collection('cobranza').doc(String(_cob.id))
              .update({ abonos: _cob.abonos, estado: _cob.estado })
              .catch(e => console.error('[cobranza sync] FS patch error:', e));
          }
        }
      }
      saveDb(['ventas','cajas','consignacion','productos','cobranza']); renderVentas(); closeModal();
      const _vtIdPago = vt.id, _vtFolioPago = vt.folioPedido;
