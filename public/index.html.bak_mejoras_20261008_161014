function _archivarCobranza(id) {
  const c = db.cobranza.find(x => x.id === id);
  if (!c) return;
  _confirm('¿Archivar este registro de cobranza? Ya no aparecerá en la lista activa.', () => {
    c.archivado = true;
    // Patch directo a Firestore para evitar bug delta-snapshot
    if (window._serverSnapshot?.cobranza?.[String(id)]) {
      window._serverSnapshot.cobranza[String(id)].archivado = true;
    }
    if (FIREBASE_ENABLED && firestore) {
      firestore.collection('cobranza').doc(String(id))
        .update({ archivado: true })
        .catch(e => console.error('[cobranza] archivado FS error:', e));
    }
    // Si tiene venta vinculada, también archivarla
    if (c.ventaId) setTimeout(() => archivarVenta(c.ventaId), 200);
    else { saveDb('cobranza'); renderCobranza(); }
  }, null, { ok: '📁 Archivar' });
}
window['_archivarCobranza'] = _archivarCobranza;

function _eliminarCobranzaArchivada(id) {
  if (!can(['admin'])) return;
  const c = db.cobranza.find(x => x.id === id);
  if (!c) return;
  _confirm(`¿Eliminar definitivamente el registro de "${c.cliente}"? Esta acción no se puede deshacer.`, () => {
    db.cobranza = db.cobranza.filter(x => x.id !== id);
    if (window._serverSnapshot?.cobranza?.[String(id)]) delete window._serverSnapshot.cobranza[String(id)];
    if (FIREBASE_ENABLED && firestore) {
      firestore.collection('cobranza').doc(String(id)).delete()
        .catch(e => console.error('[cobranza] delete error:', e));
    }
    saveDb('cobranza'); renderCobranza();
  }, null, { ok: '🗑️ Eliminar', okCls: 'btn-danger' });
}
window['_eliminarCobranzaArchivada'] = _eliminarCobranzaArchivada;

