function updateVentaItems() {
  const list = document.getElementById('venta-items-list');
  if (!list) return;
  list.innerHTML = ventaItems.length ? `<table style="width:100%;font-size:0.85rem;border-collapse:collapse">
    <tr style="background:var(--bg)"><th style="padding:6px">Producto / Concepto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th><th></th></tr>
    ${ventaItems.map((i,idx) => `<tr style="border-top:1px solid var(--border)">
      <td style="padding:4px 6px"><input type="text" value="${esc(i.producto)}" style="width:100%;padding:2px 4px;border:1px solid var(--border);border-radius:4px;font-size:0.85rem" onchange="ventaItems[${idx}].producto=this.value" />${i._consigFolio?`<div style="font-size:0.68rem;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:3px;padding:1px 5px;margin-top:2px;display:inline-block">📋 ${esc(i._consigFolio)}</div>`:''}</td>
      <td><input type="number" min="0.01" step="any" value="${i.cantidad}" style="width:60px;padding:2px 4px;border:1px solid var(--border);border-radius:4px;font-size:0.85rem" onchange="ventaItems[${idx}].cantidad=+this.value||1;updateVentaItems()" />${i.unidad?` <span style="font-size:0.75rem;color:#64748b">${esc(i.unidad)}</span>`:''}</td>
      <td style="padding:6px;color:#64748b">$${fmt(i.precio)}</td>
      <td style="padding:6px;font-weight:600">$${fmt(i.cantidad*i.precio)}</td>
      <td><button onclick="ventaItems.splice(${idx},1);updateVentaItems()" style="background:none;border:none;cursor:pointer;color:var(--danger)">✕</button></td>
    </tr>`).join('')}
  </table>` : '<p style="color:#94a3b8;font-size:0.85rem">Sin items. Agrega productos arriba.</p>';
  const subtotalVt = ventaItems.reduce((s, i) => s + i.cantidad * i.precio, 0);
  const ivaElVt = document.querySelector('input[name="vt-iva"]:checked');
  const ivaModeVt = ivaElVt ? ivaElVt.value : 'neto';
  const tv = document.getElementById('venta-total');
  if (tv) {
    if (!ventaItems.length) { tv.innerHTML = ''; }
    else {
      const ivaAmtVt = ivaModeVt === 'mas' ? round2(subtotalVt * 0.16) : 0;
      const totalVt = round2(ivaModeVt === 'mas' ? subtotalVt + ivaAmtVt : subtotalVt);
      const labelVt = ivaModeVt === 'mas'
        ? `<span style="font-size:0.8rem;color:#0f6e56;font-weight:600;margin-left:6px">+ IVA (16%)</span>`
        : ivaModeVt === 'incluido'
        ? `<span style="font-size:0.8rem;color:#7c3aed;font-weight:600;margin-left:6px">NETO con IVA</span>`
        : `<span style="font-size:0.8rem;color:#64748b;font-weight:600;margin-left:6px">NETO sin IVA</span>`;
      tv.innerHTML = ivaModeVt === 'mas'
        ? `<span style="font-weight:700;font-size:1.1rem;color:var(--primary)">Total: $${fmt(totalVt)}</span> <span style="font-size:0.8rem;color:#64748b">(base $${fmt(subtotalVt)} + IVA $${fmt(ivaAmtVt)})</span>`
        : `<span style="font-weight:700;font-size:1.1rem;color:var(--primary)">Total: $${fmt(totalVt)}</span>${labelVt}`;
    }
  }
  calcSaldoVenta();
}

function calcSaldoVenta() {
  const subtotalVt2 = ventaItems.reduce((s, i) => s + i.cantidad * i.precio, 0);
  const ivaElVt2 = document.querySelector('input[name="vt-iva"]:checked');
  const ivaModeVt2 = ivaElVt2 ? ivaElVt2.value : 'neto';
  const total = ivaModeVt2 === 'mas' ? round2(subtotalVt2 * 1.16) : subtotalVt2;
  const anticipo = +document.getElementById('v-anticipo')?.value || 0;
  const saldo = Math.max(0, total - anticipo);
  const sEl = document.getElementById('v-saldo');
  if (sEl) sEl.value = saldo.toFixed(2);
}
window['calcSaldoVenta'] = calcSaldoVenta;

// Genera el siguiente folio automático en formato "NOTA DE VENTA-001", "NOTA
// DE VENTA-002"... cuando el usuario deja el campo de Número de Pedido vacío.
// Busca el número más alto ya usado con ese formato y le suma 1.
function _siguienteNotaVenta() {
  let max = 0;
  (db.ventas||[]).forEach(x => {
    const m = /^NOTA DE VENTA-(\d+)$/i.exec((x.folioPedido||'').trim());
    if (m) { const n = parseInt(m[1], 10); if (n > max) max = n; }
  });
  return `NOTA DE VENTA-${String(max + 1).padStart(3,'0')}`;
}
window['_siguienteNotaVenta'] = _siguienteNotaVenta;

function saveVenta() {
  if (_fotosSubiendoVt > 0) { _info(`⏳ Espera a que terminen de subir las fotos (${_fotosSubiendoVt} pendiente${_fotosSubiendoVt>1?'s':''})`); return; }
  const nombre = v('v-nombre');
  const apellido = v('v-apellido');
  const cliente = [nombre, apellido].filter(Boolean).join(' ');
  if (!cliente) { _info('Ingresa el nombre del cliente'); return; }
  const _pendienteCotizar = document.getElementById('v-pendiente-cotizar')?.checked || false;
  if (!ventaItems.length && !_pendienteCotizar) { _info('Agrega al menos un producto, o marca "Precio pendiente de cotizar"'); return; }
  const folioManual = v('v-folio').trim();
  if (folioManual && db.ventas.find(x=>x.folioPedido===folioManual && x.estado!=='Cancelada')) {
    _info(`❌ Ya existe un pedido activo con el folio "${folioManual}". Asigna un número diferente (solo se puede reutilizar si ese pedido está cancelado).`);
    return;
  }
  const nuevoId = sid();
  const folioPedido = folioManual || _siguienteNotaVenta();
  const ivaElSv = document.querySelector('input[name="vt-iva"]:checked');
  const ivaModeSv = ivaElSv ? ivaElSv.value : 'neto';
  const subtotalSv = ventaItems.reduce((s, i) => s + i.cantidad * i.precio, 0);
  const netoSv = subtotalSv;
  const ivaAmtSv = ivaModeSv === 'mas' ? round2(subtotalSv * 0.16) : 0;
  const total = _pendienteCotizar ? 0 : round2(ivaModeSv === 'mas' ? subtotalSv + ivaAmtSv : subtotalSv);
  const anticipo = +v('v-anticipo') || 0;
  if (!_pendienteCotizar && anticipo > total + 0.01) {
    _info(`❌ El anticipo ($${fmt(anticipo)}) no puede ser mayor al total ($${fmt(total)}).`);
    return;
  }
  const saldo = _pendienteCotizar ? 0 : Math.max(0, total - anticipo);
  const formaPagoAnticipo = anticipo > 0 ? (document.getElementById('v-forma-pago')?.value || 'efectivo') : null;
  const pagosIniciales = anticipo > 0
    ? [{ monto: anticipo, fecha: v('v-fecha'), hora: new Date().toTimeString().slice(0,5), nota: 'Anticipo inicial', recibidoPor: session.nombre, formaPago: formaPagoAnticipo }]
    : [];
  db.ventas.push({
    id:nuevoId, folioPedido, esPedido:true, fecha:v('v-fecha'), cliente,
    ctNombre:nombre, ctApellido:apellido,
    ctCiudad:v('v-ciudad'), ctEstado:v('v-estado'), ctEmpresa:v('v-empresa'),
    ctTelFijo:v('v-telfijo'), ctCelular:v('v-celular'), ctCorreo:v('v-correo'),
    ctDireccion:v('v-direccion'), ctColonia:v('v-colonia'), ctCp:v('v-cp'), ctRfc:v('v-rfc'),
    unidad:v('v-unidad'), tipo:v('v-tipo'), forro:v('v-forro'), color:v('v-color'),
    observaciones:v('v-observaciones'), notas:v('v-notas')||undefined,
    fotos:[..._tempFotosVt],
    items:ventaItems, total, anticipo, saldo, pagos: pagosIniciales,
    iva: ivaModeSv !== 'neto', ivaMode: ivaModeSv, subtotal: netoSv, ivaAmount: ivaAmtSv,
    pendienteCotizar: _pendienteCotizar || undefined,
    tiempoFabricacion:v('v-tiempo-fabricacion'), numFactura:(document.getElementById('v-factura')?.value?.trim()||undefined), estado:v('v-estado-form'), fechaEntrega:v('v-fecha-entrega'), usuario:session.nombre
  });
  // Descontar stock de los artículos agregados desde inventario (materia/productos/consignación).
  let _tieneProductosPendientes = false;
  ventaItems.forEach(i => {
    if (i._itemId != null) {
      const item = (db[i._tipo]||[]).find(x=>x.id===i._itemId);
      if (item && item.cantidad != null) {
        if (i._tipo === 'consignacion') {
          item.estado = saldo === 0 ? 'Vendido' : 'Apartado';
          item.ventaId = nuevoId;
        } else if (i._tipo === 'productos') {
          if (saldo === 0) item.cantidad = Math.max(0, item.cantidad - i.cantidad);
          else _tieneProductosPendientes = true;
        } else {
          item.cantidad = Math.max(0, item.cantidad - i.cantidad);
        }
      }
    }
  });
  // marcar venta con nueva lógica si hay productos pendientes de cobro
  if (_tieneProductosPendientes) {
    const _vtRef = db.ventas.find(v => v.id === nuevoId);
    if (_vtRef) _vtRef._nuevaLogicaProd = true;
  }
  // Secretaria/auxiliar: siempre enlazar la venta al turno de caja para que aparezca en Caja Chica.
  // Si hay anticipo en efectivo, también registrar movimiento de entrada.
  if (session.rol === 'secretaria' || session.rol === 'auxiliar') {
    const caja = cajaActivaOCrear();
    if (caja) {
      const vt = db.ventas.find(v => v.id === nuevoId);
      if (vt) vt.cajaSesion = caja.id;
      if (anticipo > 0 && formaPagoAnticipo === 'efectivo') {
        const movId = sid();
        caja.movimientos = caja.movimientos || [];
        _cajaMovAdd(caja, { id: movId, tipo: 'entrada', monto: anticipo, concepto: `Anticipo pedido ${folioPedido} — ${cliente}`, fecha: v('v-fecha'), hora: new Date().toTimeString().slice(0,5), ventaId: nuevoId });
        if (pagosIniciales[0]) { pagosIniciales[0].cajaMovId = movId; pagosIniciales[0].cajaUsuario = session.nombre; }
      }
    }
  }
  upsertCliente({ nombre, apellido, ciudad: v('v-ciudad'), estado: v('v-estado'), empresa: v('v-empresa'), telfijo: v('v-telfijo'), celular: v('v-celular'), correo: v('v-correo'), direccion: v('v-direccion'), colonia: v('v-colonia'), cp: v('v-cp'), rfc: v('v-rfc') });
  saveDb(['ventas','cajas','clientes','materia','productos','consignacion']); closeModal(); renderVentas();
}

