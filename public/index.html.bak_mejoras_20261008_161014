// ---- Autorización de crédito por cliente ----
// Una vez que un administrador autoriza el crédito de un pedido para un cliente, ese cliente
// queda "precalificado" y no se vuelve a pedir contraseña de admin la próxima vez — a menos que
// el administrador la revoque explícitamente desde Cobranza.
async function archivarVenta(id) {
  const vt = db.ventas.find(v => v.id === id);
  if (!vt) return;
  const folio = esc(vt.folioPedido || ('#' + vt.id));
  const cobPendiente = (db.cobranza||[]).find(c => c.ventaId === id && !c.archivado && cobranzaSaldo(c) > 0);
  if (cobPendiente) {
    showModal('No se puede archivar', `
      <p style="margin:0;line-height:1.6"><strong>${folio}</strong> tiene un saldo pendiente de <strong>$${fmt(cobranzaSaldo(cobPendiente))}</strong> en Crédito y Cobranza.</p>
      <p style="margin:8px 0 0;font-size:0.88rem;color:#b45309;background:#fefce8;padding:8px 10px;border-radius:8px">Liquida el saldo antes de archivar la venta.</p>
    `, [{ label: 'Cerrar', cls: 'btn-secondary', action: closeModal }]);
    return;
  }
  showModal('Archivar venta', `
    <p style="margin:0;line-height:1.6">¿El camper / producto de <strong>${folio}</strong> ya fue entregado al cliente?</p>
    <p style="margin:8px 0 0;font-size:0.88rem;color:#b45309;background:#fefce8;padding:8px 10px;border-radius:8px">Si aún no se entrega, no es posible archivar.</p>
  `, [
    { label: '✅ Sí, ya fue entregado', cls: 'btn-primary', style:'background:#16a34a;border-color:#16a34a', action: () => {
      showModal('Confirmar archivo', `
