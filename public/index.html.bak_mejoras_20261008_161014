async function exportarDatosJSON() {
  if (!(await _checkAdminReal())) { _info('Solo el administrador puede exportar datos.'); return; }
  const exportData = {};
  const FS_COL_KEYS = ['materia','productos','consignacion','ventas','cotizaciones',
    'cajas','reparaciones','produccion','catalogoMateriales','cobranza','clientesCredito',
    'clientes','bodegas','entregas','facturas','vehiculos',
    'herramientas','herramientasAsignadas','herramientasHistorial',
    'ordenesCompra','proveedores','checadas','checadorConfig',
    'entregaInsumos','reportesEntrega','reportesProduccion','agenda'];
  FS_COL_KEYS.forEach(k => { exportData[k] = db[k] || []; });
  exportData._nextId = nextId;
  exportData._exportadoEn = new Date().toISOString();
  const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  const fecha = new Date().toISOString().slice(0,10);
  a.download = `GestPro_${fecha}_datos.json`;
  a.click();
  URL.revokeObjectURL(url);
}
