      <div class="t-line"></div>
      <div class="t-row"><span>Estado:</span><span>${esc(r.estado||'')}</span></div>
      ${r.notas?`<div class="t-small">${esc(r.notas)}</div>`:''}
      <div class="t-line"></div>
