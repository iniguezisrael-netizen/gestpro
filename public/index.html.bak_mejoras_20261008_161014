// ── WhatsApp PDF: renderizar HTML a blob usando html2canvas + jsPDF ──────────
function _loadHtml2Canvas(cb) {
  if (window.html2canvas) { cb(); return; }
  const s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
  s.onload = cb;
  s.onerror = () => { console.warn('[GestPro] html2canvas no se pudo cargar'); cb(); };
  document.head.appendChild(s);
}
function _htmlToPdfBlob(htmlStr, callback) {
  const iframe = document.createElement('iframe');
  iframe.style.cssText = 'position:fixed;left:-9999px;top:-9999px;width:794px;height:1060px;border:none;opacity:0;pointer-events:none;';
  document.body.appendChild(iframe);
  const cleanup = () => { try { document.body.removeChild(iframe); } catch(_) {} };
  iframe.onload = function() {
    _loadHtml2Canvas(() => {
      if (!window.html2canvas) { cleanup(); callback(null); return; }
      const iDoc = iframe.contentDocument || iframe.contentWindow.document;
      const pageEl = iDoc.querySelector('.page') || iDoc.body;
      html2canvas(pageEl, {
        scale: 2, useCORS: true, allowTaint: true,
        backgroundColor: '#ffffff',
        width: 794, height: 1060,
        windowWidth: 794, windowHeight: 1060,
        scrollX: 0, scrollY: 0,
        foreignObjectRendering: false
      }).then(canvas => {
        cleanup();
        const imgData = canvas.toDataURL('image/jpeg', 0.93);
        try {
          const { jsPDF } = window.jspdf;
          const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
          const W = doc.internal.pageSize.getWidth();
          const H = doc.internal.pageSize.getHeight();
          doc.addImage(imgData, 'JPEG', 0, 0, W, H);
          callback(doc.output('blob'));
        } catch(e) { console.error('[_htmlToPdfBlob jsPDF]', e); callback(null); }
      }).catch(e => { console.error('[_htmlToPdfBlob html2canvas]', e); cleanup(); callback(null); });
    });
  };
  iframe.srcdoc = htmlStr;
}

