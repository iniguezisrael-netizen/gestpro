window._checFaceCapturar = async function() {
  const { nombre, sigEv, diffMin, ahora, hoy } = window._checFaceData || {};
  if (!nombre) return;
  const v  = document.getElementById('chec-face-v');
  const c  = document.getElementById('chec-face-c');
  const st = document.getElementById('chec-face-status');
  if (!v || !c) return;
  if (st) st.textContent = 'Verificando...';

  const detection = await faceapi
    .detectSingleFace(v, new faceapi.TinyFaceDetectorOptions({ inputSize:320, scoreThreshold:0.5 }))
    .withFaceLandmarks(true)
    .withFaceDescriptor();

  if (!detection) {
    if (st) st.textContent = '⚠️ No se detectó ninguna cara. Intenta de nuevo.';
    return;
  }

  const t = (db.checadorConfig||[]).find(x => x.nombre === nombre);
  if (!t || !t.faceDescriptor) {
    if (st) st.textContent = 'Error: trabajador sin cara registrada.';
    return;
  }

  const refDesc  = new Float32Array(t.faceDescriptor);
  const distance = faceapi.euclideanDistance(Array.from(detection.descriptor), Array.from(refDesc));
  const UMBRAL   = 0.6; // 0=idéntico, >0.6 diferente persona

  if (distance > UMBRAL) {
    if (st) { st.style.color='#dc2626'; st.textContent = '❌ Cara no reconocida. Intenta de nuevo o contacta al administrador.'; }
    return;
  }

  // Cara verificada — tomar foto para el registro
  c.width = 200; c.height = 200;
  const ctx = c.getContext('2d');
  const vw = v.videoWidth || 200, vh = v.videoHeight || 200;
  const side = Math.min(vw, vh);
  const sx = (vw-side)/2, sy = (vh-side)/2;
  ctx.save(); ctx.scale(-1,1); ctx.translate(-200,0);
  ctx.drawImage(v, sx, sy, side, side, 0, 0, 200, 200);
  ctx.restore();
  const foto = c.toDataURL('image/jpeg', 0.5);

  _faceStopCam('chec-face-v');
  closeModal();
  setTimeout(() => _checConfirmar(nombre, sigEv, ahora, hoy, diffMin, foto), 150);
};
window['_checFaceCapturar'] = window._checFaceCapturar;

