window._faceModelsLoaded = false;
window._faceModelsLoading = false;

async function _loadFaceModels() {
  if (window._faceModelsLoaded) return true;
  if (window._faceModelsLoading) {
    return new Promise(resolve => {
      const check = setInterval(() => {
        if (window._faceModelsLoaded) { clearInterval(check); resolve(true); }
      }, 200);
    });
  }
  window._faceModelsLoading = true;
  try {
    // Cargar face-api.js dinámicamente si no está disponible
    if (typeof faceapi === 'undefined') {
      await new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js';
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    const MODEL_URL = '/models';
    await Promise.all([
      faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
      faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),
      faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL),
    ]);
    window._faceModelsLoaded = true;
    window._faceModelsLoading = false;
    return true;
  } catch(e) {
    window._faceModelsLoading = false;
    console.error('[face-api] Error cargando modelos:', e);
    return false;
  }
}

