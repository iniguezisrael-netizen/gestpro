      <button class="btn btn-secondary btn-sm" onclick="renderHistorialCaja()">📊 Ver historial de cajas</button>
      ${can(['admin']) ? `<button class="btn btn-danger btn-sm" style="margin-left:auto" onclick="cerrarCaja()">🔒 Corte de Caja</button>` : `<span style="font-size:0.78rem;color:#94a3b8;margin-left:auto">El corte lo hace el administrador</span>`}
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <!-- MOVIMIENTOS -->
      <div class="card">
        <div class="card-header"><span class="card-title">📋 Movimientos de Caja</span></div>
        ${movs.length ? `<div style="max-height:320px;overflow-y:auto">
