function generarPDFCompra(id, elaboroOverride) {
  const oc = (db.ordenesCompra||[]).find(o => o.id === id);
  if (!oc) return;
  const _withLogo = (cb) => {
    if (window._logoB64Cache) { cb(window._logoB64Cache); return; }
    const img = new Image(); img.crossOrigin='anonymous';
    img.onload = () => { const c=document.createElement('canvas'); c.width=img.width; c.height=img.height; c.getContext('2d').drawImage(img,0,0); try{window._logoB64Cache=c.toDataURL('image/png');}catch(e){} cb(window._logoB64Cache||''); };
    img.onerror = () => cb(''); img.src = '/logo.png';
  };
  const _withBarcode = (logoB64, cb) => {
    _cargarLibJsBarcode(() => {
      let bcB64 = '';
      try {
        const canvas = document.createElement('canvas');
        JsBarcode(canvas, _ocFolio(oc), { format:'CODE128', width:1.4, height:36, fontSize:10, margin:3, displayValue:true });
        bcB64 = canvas.toDataURL('image/png');
      } catch(e) {}
      cb(logoB64, bcB64);
    });
  };
  const _doGen = () => _withLogo(logoB64 => _withBarcode(logoB64, (l, bc) => _buildPDFCompra(oc, l, bc, elaboroOverride)));
  if (typeof window.jspdf === 'undefined' && typeof window.jsPDF === 'undefined') {
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
    s.onload = _doGen;
    s.onerror = () => _info('No se pudo cargar jsPDF. Verifica tu conexión.');
    document.head.appendChild(s);
  } else {
    _doGen();
  }
}
window['generarPDFCompra'] = generarPDFCompra;

function _buildPDFCompra(oc, logoB64, bcB64, elaboroOverride) {
  try {
    const { jsPDF } = window.jspdf || window;
    const doc = new jsPDF({ orientation:'portrait', unit:'mm', format:'a4', compress:true });
    const W = 210, M = 12;
    let y = 0;

    // ── Encabezado ──────────────────────────────────────
    // Logo izquierda
    if (logoB64) { try { doc.addImage(logoB64, 'PNG', M, 3, 36, 36); } catch(e) {} }

    // "La Cuesta" centrado en el espacio medio (entre logo y columna derecha)
    // Logo termina en x≈36, columna derecha empieza en x≈150 → centro ~93
    doc.setFont('helvetica','bold'); doc.setFontSize(36); doc.setTextColor(220,38,38);
    doc.setLineWidth(0.6); doc.setDrawColor(220,38,38);
    doc.text('La Cuesta', 90, 27, {align:'center', renderingMode:'fillThenStroke'});

    // Columna derecha: sello + folio + barcode
    const rxLeft = W-M-50, rxCenter = rxLeft + 25;
    // Sello ORDEN DE COMPRA
    doc.setFillColor(254,249,195); doc.roundedRect(rxLeft, 5, 50, 7, 2, 2, 'F');
    doc.setDrawColor(180,83,9); doc.setLineWidth(0.4); doc.roundedRect(rxLeft, 5, 50, 7, 2, 2, 'S');
    doc.setFont('helvetica','bold'); doc.setFontSize(6.5); doc.setTextColor(146,64,14);
    doc.text('ORDEN DE COMPRA', rxCenter, 9.8, {align:'center'});
    // Folio
    doc.setDrawColor(30,58,95); doc.setLineWidth(0.6); doc.roundedRect(rxLeft, 14, 50, 8, 2, 2, 'S');
    doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(30,58,95);
    doc.text('#' + _ocFolio(oc), rxCenter, 19.5, {align:'center'});
    // Código de barras real
    if (bcB64) {
      try { doc.addImage(bcB64, 'PNG', rxLeft, 23, 50, 14); } catch(e) {}
    }

    y = 40;

    // ── Barra DATOS DEL PROVEEDOR (2 líneas para evitar solapamiento) ─
    const estadoLabel = (oc.estado||'Borrador').toUpperCase();
    const barH = oc.fechaEntrega ? 11 : 7;
    doc.setFillColor(30,41,59); doc.rect(M, y, W-M*2, barH, 'F');
    doc.setFont('helvetica','bold'); doc.setFontSize(7.5); doc.setTextColor(255,255,255);
    doc.text('DATOS DEL PROVEEDOR', M+3, y+4.8);
    doc.text('FECHA: ' + fechaLarga(oc.fecha), M+72, y+4.8);
    if (oc.fechaEntrega) {
      doc.setFontSize(7); doc.text('ENTREGA ESTIMADA: ' + fechaLarga(oc.fechaEntrega), M+3, y+8.8);
    }
    // Badge estado — separado a la derecha sin solapar
    doc.setFillColor(245,197,0); doc.roundedRect(W-M-28, y+1.5, 26, 5, 1, 1, 'F');
    doc.setFont('helvetica','bold'); doc.setFontSize(6); doc.setTextColor(30,41,59);
    doc.text(estadoLabel, W-M-15, y+4.8, {align:'center'});
    y += barH;

    // Grid datos proveedor — fila 1: Empresa | Tel / WA | Contacto
    const _provTel   = oc.provTelFijo  || oc.provWhatsApp || '—';
    const _provCont  = [oc.provNombre, oc.provApellido].filter(Boolean).join(' ') || '—';
    const _provCorr  = oc.provCorreo   || '';
    const _provDir   = [oc.provDireccion, oc.provColonia, oc.provCiudad, oc.provEstado].filter(Boolean).join(', ') || '';
    const _provRFC   = oc.provRFC      || '';
    const _row2H     = (_provCorr || _provDir || _provRFC) ? 12 : 0;
    const _gridH     = 14 + _row2H;
    doc.setDrawColor(203,213,225); doc.setLineWidth(0.3);
    doc.rect(M, y, W-M*2, _gridH);
    doc.line(M+62, y, M+62, y+_gridH);
    doc.line(M+124, y, M+124, y+_gridH);
    const cells = [
      {label:'EMPRESA / PROVEEDOR', val: (oc.proveedor||'—').substring(0,22), x:M+2, lx:M+2},
      {label:'TELÉFONO',            val: _provTel.substring(0,20),             x:M+64, lx:M+64},
      {label:'CONTACTO',            val: _provCont.substring(0,22),            x:M+126, lx:M+126},
    ];
    cells.forEach(c => {
      doc.setFont('helvetica','bold'); doc.setFontSize(6); doc.setTextColor(100,116,139);
      doc.text(c.label, c.lx, y+4);
      doc.setFont('helvetica','bold'); doc.setFontSize(8.5); doc.setTextColor(15,23,42);
      doc.text(c.val, c.x, y+11);
    });
    if (_row2H > 0) {
      doc.setLineWidth(0.2); doc.line(M, y+14, M+W-M*2, y+14);
      doc.setFont('helvetica','bold'); doc.setFontSize(6); doc.setTextColor(100,116,139);
      if (_provCorr) { doc.text('CORREO', M+2, y+17); doc.setFont('helvetica','normal'); doc.setFontSize(7.5); doc.setTextColor(15,23,42); doc.text(_provCorr.substring(0,35), M+2, y+23); }
      if (_provDir)  { doc.setFont('helvetica','bold'); doc.setFontSize(6); doc.setTextColor(100,116,139); doc.text('DIRECCIÓN', M+64, y+17); doc.setFont('helvetica','normal'); doc.setFontSize(7.5); doc.setTextColor(15,23,42); doc.text(_provDir.substring(0,45), M+64, y+23); }
      if (_provRFC)  { doc.setFont('helvetica','bold'); doc.setFontSize(6); doc.setTextColor(100,116,139); doc.text('RFC', M+126, y+17); doc.setFont('helvetica','normal'); doc.setFontSize(7.5); doc.setTextColor(15,23,42); doc.text(_provRFC, M+126, y+23); }
    }
    y += _gridH + 4;

    // ── Barra ARTÍCULOS ──────────────────────────────────
    doc.setFillColor(30,41,59); doc.rect(M, y, W-M*2, 7, 'F');
    doc.setFont('helvetica','bold'); doc.setFontSize(7.5); doc.setTextColor(255,255,255);
    doc.text('ARTÍCULOS', M+3, y+4.8);
    doc.setFillColor(245,197,0); doc.roundedRect(W-M-22, y+1.2, 20, 5, 1, 1, 'F');
    doc.setFontSize(6); doc.setTextColor(30,41,59);
    doc.text('DETALLE', W-M-12, y+4.8, {align:'center'});
    y += 7;

    // Cabecera tabla
    doc.setFillColor(30,41,59); doc.rect(M, y, W-M*2, 7, 'F');
    doc.setFont('helvetica','bold'); doc.setFontSize(7); doc.setTextColor(255,255,255);
    doc.text('CONCEPTO', M+2, y+4.5);
    doc.text('CANT.', M+121, y+4.5, {align:'center'});
    doc.text('PRECIO UNIT.', M+145, y+4.5, {align:'center'});
    doc.text('SUBTOTAL', W-M-2, y+4.5, {align:'right'});
    y += 7;

    // Filas
    const items = oc.items||[];
    const _iSym = (oc.moneda||'MXN') === 'USD' ? 'USD $' : '$';
    items.forEach((item, i) => {
      const sub = (item.cantidad||0) * (item.precioUnitario||0);
      if (i % 2 === 0) { doc.setFillColor(248,250,252); doc.rect(M, y, W-M*2, 8, 'F'); }
      doc.setDrawColor(226,232,240); doc.setLineWidth(0.2);
      doc.line(M, y+8, M+W-M*2, y+8);
      doc.setFont('helvetica','normal'); doc.setFontSize(7.5); doc.setTextColor(51,65,85);
      const desc = doc.splitTextToSize(item.descripcion||'', 100);
      doc.text(desc[0], M+2, y+5.5);
      doc.text(String(item.cantidad||0), M+121, y+5.5, {align:'center'});
      doc.text(_iSym+fmt(item.precioUnitario||0), M+145, y+5.5, {align:'center'});
      doc.setFont('helvetica','bold');
      doc.text(_iSym+fmt(sub), W-M-2, y+5.5, {align:'right'});
      y += 8;
    });

    // ── Total ────────────────────────────────────────────
