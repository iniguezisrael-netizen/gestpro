function _checCamaraModal(nombre, sigEv) {
  const ahora   = new Date().toTimeString().slice(0,5);
  const hoy     = today();
  const [eH,eM] = sigEv.esperada.split(':').map(Number);
  const [aH,aM] = ahora.split(':').map(Number);
  const diffMin = (aH*60+aM) - (eH*60+eM);

  showModal(`📷 ${nombre}`, `
    <div style="text-align:center;padding:10px 0">
      <p style="font-size:0.82rem;color:var(--text-light);margin-bottom:10px">Se tomará una foto para confirmar tu asistencia</p>
      <video id="chec-cam-v" autoplay playsinline muted
        style="width:100%;max-width:250px;border-radius:14px;background:#000;transform:scaleX(-1);display:block;margin:0 auto"></video>
      <canvas id="chec-cam-c" style="display:none"></canvas>
      <button onclick="_checTomarFoto()"
        style="margin-top:16px;width:64px;height:64px;border-radius:50%;background:var(--primary);border:none;color:white;font-size:1.8rem;cursor:pointer;touch-action:manipulation">📸</button>
    </div>
  `, [{ label:'Cancelar', cls:'btn-secondary', action:() => { _checStopCam(); closeModal(); } }]);

  navigator.mediaDevices.getUserMedia({ video:{ facingMode:'user' }, audio:false })
    .then(stream => {
      window._checCamStream = stream;
      const v = document.getElementById('chec-cam-v');
      if (v) { v.srcObject = stream; v.play().catch(()=>{}); }
    })
    .catch(() => { _checStopCam(); closeModal(); _info('No se pudo acceder a la cámara. Verifica los permisos.'); });

  window._checTomarFoto = () => {
    const v = document.getElementById('chec-cam-v');
    const c = document.getElementById('chec-cam-c');
    if (!v || !c) return;
    c.width = 200; c.height = 200;
    const ctx = c.getContext('2d');
    const vw = v.videoWidth || 200, vh = v.videoHeight || 200;
    const side = Math.min(vw, vh);
    const sx = (vw-side)/2, sy = (vh-side)/2;
    ctx.save(); ctx.scale(-1,1); ctx.translate(-200,0);
    ctx.drawImage(v, sx, sy, side, side, 0, 0, 200, 200);
    ctx.restore();
    const foto = c.toDataURL('image/jpeg', 0.5);
    _checStopCam();
    closeModal();
    setTimeout(() => _checConfirmar(nombre, sigEv, ahora, hoy, diffMin, foto), 150);
  };
  window['_checTomarFoto'] = window._checTomarFoto;
}

function _checStopCam() {
  if (window._checCamStream) {
    window._checCamStream.getTracks().forEach(t => t.stop());
