function setSyncStatus(status, errMsg) { // 'ok' | 'syncing' | 'offline' | 'error'
  const el = document.getElementById('sync-status');
  if (!el) return;
  const icons = { ok:'🟢', syncing:'🔄', offline:'🔴', error:'⚠️' };
  if (status === 'error' && errMsg) _lastSyncError = errMsg;

  // ── Icono compacto en topbar ──
  if (status === 'error') {
    el.style.cssText += ';background:transparent;color:inherit';
    el.innerHTML = `<span style="cursor:pointer" title="Error al guardar en la nube. Reintentando automáticamente…" onclick="reintentarSync()">⚠️</span>`;
    clearTimeout(window._autoRetryTimer);
    window._autoRetryTimer = setTimeout(() => {
      if (FIREBASE_ENABLED && navigator.onLine) reintentarSync();
    }, 10000);
  } else if (status === 'offline') {
    el.style.cssText += ';background:#fef2f2;color:#b91c1c';
    el.innerHTML = `🔴 <span>Sin internet</span>`;
  } else if (status === 'syncing') {
    el.style.cssText += ';background:#eff6ff;color:#1d4ed8';
    el.innerHTML = `🔄 <span>Sincronizando…</span>`;
  } else { // ok
    el.style.cssText += ';background:#f0fdf4;color:#15803d';
    el.innerHTML = `✅ <span>Sincronizado</span>`;
    // Quitar el texto "Sincronizado" después de 4s, dejar solo el ✅
    clearTimeout(el._okTimer);
    el._okTimer = setTimeout(() => {
      el.innerHTML = `✅`;
      el.style.background = 'transparent';
      el.style.color = 'inherit';
    }, 4000);
  }

  // ── Barra superior visible (solo offline y ok-post-sync) ──
  const bar = document.getElementById('sync-bar');
  if (!bar) return;
  clearTimeout(bar._hideTimer);

  if (status === 'offline') {
    bar.style.display = 'flex';
    bar.style.background = '#fef2f2';
    bar.style.color = '#991b1b';
    bar.style.borderBottom = '2px solid #fca5a5';
    bar.innerHTML = `🔴 <span>Sin internet — la información se está guardando en este dispositivo. Se subirá a la nube cuando haya conexión.</span>`;
  } else if (status !== 'offline') {
    // ok, syncing o error: el icono del topbar ya informa — no mostrar barra
    bar.style.display = 'none';
  }
}
function reintentarSync() {
  if (!FIREBASE_ENABLED || !firestore) return;
  // Solo reintentar las colecciones que sabemos que cambiaron (no todas)
  const cols = _pendingSyncCols.size > 0
    ? [..._pendingSyncCols].filter(c => db[c] != null)
    : [];
  if (cols.length === 0) { setSyncStatus('ok'); return; }
  setSyncStatus('syncing');
  if (!window._ownWriteUntilByCol) window._ownWriteUntilByCol = {};
  cols.forEach(c => { window._ownWriteUntilByCol[c] = Date.now() + 8000; });
  Promise.all(cols.map(c => fsWriteCollection(c, db[c])))
    .then(() => {
      cols.forEach(c => { window._ownWriteUntilByCol[c] = Math.max(window._ownWriteUntilByCol[c] || 0, Date.now() + 1000); });
      _clearPendingSync();
      _hasPendingSync = false;
      setSyncStatus('ok');
    })
    .catch(e => {
      const msg = e && e.message ? e.message : String(e);
      setSyncStatus('error', msg);
    });
}
