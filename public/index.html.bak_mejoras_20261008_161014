  }
  (db.consignacion||[]).filter(c => String(c.ventaId) === String(vt.id))
    .forEach(c => { c.estado = (nuevoEstado === 'Pagada' || nuevoEstado === 'Entregado') ? 'Vendido' : 'Apartado'; });
  if (nuevoEstado === 'Pagada' && vt._nuevaLogicaProd) { _descontarProdVenta(vt.items); vt._nuevaLogicaProd = false; }
