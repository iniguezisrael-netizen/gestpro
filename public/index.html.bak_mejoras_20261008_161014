  }

  wrap.innerHTML = cajas.filter(c => !c.cerrada).map(c => {
    const movs = c.movimientos || [];
    // Incluir ventas "huérfanas" (sin cajaSesion) del mismo usuario durante este turno
    const ventasCaja = db.ventas.filter(v => v.cajaSesion === c.id);

    // Construir lista unificada con saldo corriente
    // Deduplicar: si un movimiento manual ya cubre una venta, omitir la venta de ventasCaja.
    const foliosEnMovs = new Set(
      movs.filter(m => m.tipo === 'entrada').map(m => {
        const match = (m.concepto || '').match(/(?:Venta|Anticipo\s+pedido)\s+#?(.+?)\s*—/);
        return match ? match[1].trim() : null;
      }).filter(Boolean)
    );
    const idsEnMovs = new Set(movs.filter(m => m.ventaId).map(m => m.ventaId));
    const ventasFiltradas = ventasCaja.filter(v =>
      !idsEnMovs.has(v.id) && !(v.folioPedido && foliosEnMovs.has(v.folioPedido)) &&
      _ventaEfectivoCaja(v) > 0
    );

    // Calcular rango del período seleccionado
    const _hoy = today();
    let _desde = null, _hasta = null;
    const _periodo = window._hcPeriodo || 'todo';
    if (_periodo === 'hoy') {
      _desde = _hasta = _hoy;
    } else if (_periodo === 'dia' && window._hcDia) {
      _desde = _hasta = window._hcDia;
    } else if (_periodo === 'semana') {
      const d = new Date(); const dow = d.getDay() || 7;
      const lun = new Date(d); lun.setDate(d.getDate() - dow + 1);
      const dom = new Date(lun); dom.setDate(lun.getDate() + 6);
      _desde = lun.toISOString().slice(0,10);
      _hasta = dom.toISOString().slice(0,10);
    } else if (_periodo === 'mes') {
      _desde = _hoy.slice(0,7) + '-01';
      const ult = new Date(+_hoy.slice(0,4), +_hoy.slice(5,7), 0).getDate();
      _hasta = _hoy.slice(0,7) + '-' + String(ult).padStart(2,'0');
    }
    const _enPeriodo = f => !_desde || (f >= _desde && f <= _hasta);

    // Enriquecer movimientos con ventaId/folio si referencian una venta
    // NOTA: NO usar c.fecha como fallback — si un movimiento no tiene fecha propia,
    // mostrar vacío es mejor que mostrar la fecha de apertura de caja (confunde al usuario).
    const movsEnriquecidos = movs.map(m => {
      if (m.ventaId) return { ...m, _es: 'mov', fecha: m.fecha || '' };
      const match = (m.concepto || '').match(/(?:Venta|Anticipo\s+pedido)\s+#?(.+?)\s*—/);
      if (match) {
        const folio = match[1].trim();
        const vRef = db.ventas.find(v => v.folioPedido === folio);
        if (vRef) return { ...m, _es: 'mov', fecha: m.fecha || '', ventaId: vRef.id, folio: vRef.folioPedido };
      }
      return { ...m, _es: 'mov', fecha: m.fecha || '' };
    });

    const todosMovs = [
      ...movsEnriquecidos,
      ...ventasFiltradas.map(v => ({ _es: 'venta', tipo: 'entrada', concepto: `Venta${v.folioPedido ? ' #' + v.folioPedido : ''} — ${v.cliente}`, monto: _ventaEfectivoCaja(v), fecha: v.fecha || c.fecha, hora: v.hora || '', ventaId: v.id, folio: v.folioPedido }))
    ].sort((a, b) => ((a.fecha||'')+(a.hora||'')).localeCompare((b.fecha||'')+(b.hora||'')));

    // Saldo al inicio del período (acumulado hasta el día anterior al período)
    // NOTA: usar c.fecha como fallback de fecha SOLO para el cálculo (no para display),
    // porque movimientos sin fecha propia pertenecen a la apertura de caja.
    let saldoAcum = c.fondo;
    todosMovs.forEach(m => {
      const _mFechaCalc = m.fecha || c.fecha;
      if (_desde && _mFechaCalc && _mFechaCalc < _desde) {
        if (m.tipo === 'entrada') saldoAcum += m.monto;
        else if (m.tipo === 'salida') saldoAcum -= m.monto;
      }
    });

    let saldo = saldoAcum;
    const lineas = _desde
      ? [{ concepto: `Saldo al inicio del período`, tipo: 'fondo', monto: saldoAcum, fecha: _desde, hora: '00:00', saldo }]
      : [{ concepto: 'Fondo inicial', tipo: 'fondo', monto: c.fondo, fecha: c.fecha, hora: c.hora, saldo: c.fondo }];
    if (!_desde) saldo = c.fondo;

    const movsFiltrados = todosMovs.filter(m => _enPeriodo(m.fecha || c.fecha));
    // Ocultar cajas cerradas sin actividad en el período
    if (_desde && c.cerrada && movsFiltrados.length === 0) return '';
    movsFiltrados.forEach(m => {
      if (m.tipo === 'entrada') saldo += m.monto;
      else if (m.tipo === 'salida') saldo -= m.monto;
      lineas.push({ ...m, saldo });
    });

    // Totales del período
    const totEnt = movsFiltrados.filter(m=>m.tipo==='entrada').reduce((s,m)=>s+m.monto,0);
    const totSal = movsFiltrados.filter(m=>m.tipo==='salida').reduce((s,m)=>s+m.monto,0);

    const encabezado = c.cerrada
      ? `✅ ${esc(c.usuario)} — ${fechaLarga(c.fecha)} ${c.hora} → ${c.horaCierre || ''}`
      : `🟡 ${esc(c.usuario)} — desde ${fechaLarga(c.fecha)} ${c.hora} (En curso)`;
    const saldoLabel = c.cerrada
      ? `Saldo contado: $${fmt(c.saldoContado || 0)}`
      : `Saldo en caja: $${fmt(saldo)}`;
    const headerColor = c.cerrada ? '#15803d' : '#b45309';

    const resumenPeriodo = _desde ? `
      <div style="display:flex;gap:16px;padding:8px 16px;background:var(--bg);font-size:0.82rem;border-bottom:1px solid var(--border)">
        <span>📅 <strong>${_desde === _hasta ? fechaLarga(_desde) : fechaLarga(_desde)+' → '+fechaLarga(_hasta)}</strong></span>
        <span style="color:var(--success)">⬆ Entradas: <strong>$${fmt(totEnt)}</strong></span>
        <span style="color:var(--danger)">⬇ Salidas: <strong>$${fmt(totSal)}</strong></span>
        <span style="color:#7c3aed">Neto: <strong>$${fmt(totEnt-totSal)}</strong></span>
      </div>` : '';


    return `<div class="card" style="margin-bottom:16px;${c.cerrada ? 'opacity:0.85' : ''}">
      <div class="card-header">
        <span class="card-title" style="color:${headerColor}">${encabezado}</span>
        <span style="font-size:1rem;font-weight:700;color:#7c3aed">${saldoLabel}</span>
      </div>
      ${resumenPeriodo}
      ${_renderDesglosePanel(c, movs)}
      <div class="table-wrap"><table>
        <tr><th>Fecha y Hora</th><th>Concepto</th><th style="text-align:right">Entrada</th><th style="text-align:right">Salida</th><th style="text-align:right">Saldo</th></tr>
        ${lineas.map(l => {
          const esEntrada = l.tipo === 'entrada';
          const esSalida  = l.tipo === 'salida';
          const esFondo   = l.tipo === 'fondo';
          const fechaHora = [l.fecha ? fechaCorta(l.fecha) : '', l.hora || ''].filter(Boolean).join(' ');
          return `<tr>
            <td style="font-size:0.78rem;color:#94a3b8;white-space:nowrap">${fechaHora || '—'}</td>
            <td>
              ${esFondo ? `<span style="font-weight:600">💵 ${esc(l.concepto)}</span>` :
                esEntrada ? `<span style="color:var(--success)">⬆️ ${esc(l.concepto)}</span>` :
                `<span style="color:var(--danger)">⬇️ ${esc(l.concepto)}</span>`}
              ${l.ventaId ? `<button class="btn btn-outline btn-sm" style="margin-left:6px;font-size:0.72rem;padding:2px 6px" onclick="verVenta(${l.ventaId},'${esc(l.folio||'')}')">⋯</button>` : ''}
            </td>
            <td style="text-align:right;color:var(--success);font-weight:600">${esEntrada||esFondo ? '$'+fmt(l.monto) : ''}</td>
            <td style="text-align:right;color:var(--danger);font-weight:600">${esSalida ? '$'+fmt(l.monto) : ''}</td>
            <td style="text-align:right;font-weight:700;color:#1e40af">$${fmt(l.saldo)}</td>
          </tr>`;
        }).join('')}
      </table></div>
    </div>`;
  }).join('');
}

