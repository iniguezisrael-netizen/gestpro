// FOTO UPLOAD GENÉRICO — usado por todos los módulos
// ══════════════════════════════════════════════════════════════
function _handleFotoUploadGenerico(files, carpeta, getTempFotos, setSubiendo, getSubiendo, renderFn, getSession) {
  const token = getSession();
  files.forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (getSession() !== token) return;
      setSubiendo(getSubiendo() + 1); renderFn();
      subirFotoAStorage(dataUrl, carpeta, url => {
        if (getSession() !== token) return;
        setSubiendo(getSubiendo() - 1);
        getTempFotos().push(url);
        renderFn();
      });
    });
  });
}

function _renderFotosGenerico(fotos, previewId, onDeleteFn, subiendo) {
  const c = document.getElementById(previewId);
  if (!c) return;
  c.innerHTML = fotos.map((src, idx) => `
    <div style="position:relative;display:inline-block">
      <img src="${src}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer"  data-src="${esc(src)}" onclick="openLightboxSrc(this.dataset.src)" />
      <button class="foto-prev-del" onclick="(${onDeleteFn})(${idx})">✕</button>
    </div>`).join('') +
    (subiendo > 0 ? `<div style="display:inline-flex;align-items:center;gap:6px;padding:8px;color:#94a3b8;font-size:0.8rem"><span class="spinner"></span> Subiendo ${subiendo}...</div>` : '');
}

function handleFotoUpload(event) {
  const files = Array.from(event.target.files);
  event.target.value = '';
  const disponibles = MAX_FOTOS - _tempFotos.length;
  if (disponibles <= 0) { _info(`Límite de ${MAX_FOTOS} fotos por ítem.`); return; }
  const token = _fotoSession;
  files.slice(0, disponibles).forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSession !== token) return;
      _fotosSubiendo++; renderFotosPreview();
      subirFotoAStorage(dataUrl, 'inventario', url => {
        if (_fotoSession !== token) return;
        _fotosSubiendo--; _tempFotos.push(url); renderFotosPreview();
      });
    });
  });
}

function handleFotoDrop(event) {
  event.preventDefault();
  event.currentTarget.classList.remove('drag-over');
  const files = Array.from(event.dataTransfer.files || []).filter(f => f.type.startsWith('image/'));
  if (!files.length) return;
  const disponibles = MAX_FOTOS - _tempFotos.length;
  if (disponibles <= 0) { _info(`Límite de ${MAX_FOTOS} fotos por ítem.`); return; }
  const token = _fotoSession;
  files.slice(0, disponibles).forEach(file => {
    comprimirImagen(file, dataUrl => {
      if (_fotoSession !== token) return;
      _fotosSubiendo++; renderFotosPreview();
      subirFotoAStorage(dataUrl, 'inventario', url => {
        if (_fotoSession !== token) return;
        _fotosSubiendo--; _tempFotos.push(url); renderFotosPreview();
      });
    });
  });
}


