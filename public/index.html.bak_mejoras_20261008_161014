  const _vtFf = window._vtFiltroFecha || '';
  const _vtH = today();
  const _vtSI = (()=>{ const d=new Date(); d.setDate(d.getDate()-d.getDay()); return d.toISOString().slice(0,10); })();
  const _vtMI = _vtH.slice(0,7)+'-01';
  let ventasFiltradas = db.ventas.slice().sort((a,b) => {
    if ((b.fecha||'') > (a.fecha||'')) return 1;
    if ((b.fecha||'') < (a.fecha||'')) return -1;
    const fa = parseInt((a.folioPedido||'').replace(/\D/g,''))||0;
    const fb = parseInt((b.folioPedido||'').replace(/\D/g,''))||0;
    return fb - fa || b.id - a.id;
  }).filter(filtroVentas)
    .filter(vt => { if(!_vtFf)return true; if(_vtFf==='hoy')return vt.fecha===_vtH; if(_vtFf==='semana')return vt.fecha>=_vtSI; if(_vtFf==='mes')return vt.fecha>=_vtMI; return true; });
  const _vtS = window._vtSort;
  if (_vtS) {
    const asc = _vtS.dir === 'asc';
    const getVal = (vt) => {
      if (_vtS.col === 'folio')   return vt.folioPedido || '';
      if (_vtS.col === 'fecha')   return vt.fecha || '';
      if (_vtS.col === 'cliente') return (vt.cliente || '').toLowerCase();
      if (_vtS.col === 'empresa') return (vt.ctEmpresa && vt.ctEmpresa !== 'No aplica' ? vt.ctEmpresa : '').toLowerCase();
      return '';
    };
    const opts = _vtS.col === 'folio' ? {numeric: true} : undefined;
    ventasFiltradas.sort((a, b) => {
      const va = getVal(a), vb = getVal(b);
      const cmp = opts ? va.localeCompare(vb, undefined, opts) : va < vb ? -1 : va > vb ? 1 : 0;
      return asc ? cmp : -cmp;
    });
  }
  if (window._ventasSearch) {
    const _vsW = _normSearch(window._ventasSearch).split(' ').filter(Boolean);
    if (_vsW.length) ventasFiltradas = ventasFiltradas.filter(vt => {
      const hay = _normSearch((vt.cliente||'')+' '+(vt.ctEmpresa&&vt.ctEmpresa!=='No aplica'?vt.ctEmpresa:'')+' '+(vt.folioPedido||'')+' '+vt.id+' '+(vt.cotizRef||'')+' '+(vt.fecha||''));
      return _vsW.every(w => hay.includes(w));
    });
  }
