function epiInvFillList(q) {
  const origen = document.getElementById('epi-inv-origen')?.value;
  if (!origen) return;
  _epiInvMap = {};
  const src = origen==='materia'?(db.materia||[]):origen==='consignacion'?(db.consignacion||[]):(db.productos||[]);
  const esConsig = origen === 'consignacion';
  const ql = (q||'').toLowerCase();
  const normalized = src.map(i => ({ ...i, _displayNombre: esConsig?(i.producto||i.nombre||''):(i.nombre||''), _folio: esConsig?(i.folio||undefined):undefined }));
  const all = normalized.filter(i=>i._displayNombre&&(!ql||i._displayNombre.toLowerCase().includes(ql))).slice(0,25);
  all.forEach(i=>{ _epiInvMap[i._displayNombre]=i; });
  _invDropShow('epi-inv-prod', all, _epiInvMap);
