function addVentaItem() {
  const prod = document.getElementById('vi-prod').value.trim();
  const qty = +document.getElementById('vi-qty').value;
  const price = +document.getElementById('vi-price').value;
  const _pcCheck = document.getElementById('v-pendiente-cotizar')?.checked;
  if (!prod || qty <= 0 || (!_pcCheck && price <= 0)) { _info('Completa producto, cantidad y precio'); return; }
  ventaItems.push({ producto:prod, cantidad:qty, precio:price });
