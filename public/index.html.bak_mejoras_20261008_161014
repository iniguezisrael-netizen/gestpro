  if (!can(['admin'])) return;
  const ids = Array.from(document.querySelectorAll('.cob-arch-chk:checked')).map(c => +c.dataset.id);
  if (!ids.length) { _info('Selecciona al menos un registro para eliminar.'); return; }
  const registros = (db.cobranza||[]).filter(c => ids.includes(c.id) && c.archivado);
  if (!registros.length) { _info('Ninguno de los seleccionados es un registro archivado.'); return; }
  showModal('🗑️ Eliminar archivados permanentemente', `
