function clienteKey(nombre) { return (nombre || '').trim().toLowerCase(); }
function clienteCreditoAutorizado(nombre) {
  return (db.clientesCredito || []).includes(clienteKey(nombre));
}
function _vtNombreCredito(vt) {
  return (vt && vt.ctEmpresa && vt.ctEmpresa !== 'No aplica') ? vt.ctEmpresa : (vt && vt.cliente) || '';
}
function vtCreditoAutorizado(vt) {
  return clienteCreditoAutorizado(_vtNombreCredito(vt));
}
function autorizarCreditoCliente(nombre) {
  const k = clienteKey(nombre);
  if (!k) return;
  if (!db.clientesCredito) db.clientesCredito = [];
  if (!db.clientesCredito.includes(k)) db.clientesCredito.push(k);
}
function revocarCreditoCliente(nombre) {
  const k = clienteKey(nombre);
  db.clientesCredito = (db.clientesCredito || []).filter(c => c !== k);
}
function _parseDiasCredito(str) {
  if (!str) return null;
  const m = String(str).match(/(\d+)/);
  return m ? parseInt(m[1], 10) : null;
}
function _fechaLimiteCobranza(c) {
  const dias = _parseDiasCredito(c.credito);
  if (!dias || !c.fecha) return null;
  const d = new Date(c.fecha + 'T00:00:00');
  d.setDate(d.getDate() + dias);
  return d.toISOString().slice(0, 10);
}
function _renderVenceCell(c) {
  const lim = _fechaLimiteCobranza(c);
  if (!lim) return `<span style="color:var(--text-muted);font-size:0.78rem">-</span>`;
  const hoy = today();
  const diff = Math.round((new Date(lim+'T00:00:00') - new Date(hoy+'T00:00:00')) / 86400000);
  if (c.estado === 'Pagado') return `<span style="color:var(--text-muted);font-size:0.78rem">${fechaCorta(lim)}</span>`;
  if (diff < 0) return `<span style="color:#dc2626;font-weight:600;font-size:0.8rem">🔴 Vencido</span><div style="font-size:0.7rem;color:#dc2626">${fechaCorta(lim)}</div>`;
  if (diff <= 5) return `<span style="color:#d97706;font-weight:600;font-size:0.8rem">⚠️ ${fechaCorta(lim)}</span><div style="font-size:0.7rem;color:#d97706">en ${diff} día${diff===1?'':'s'}</div>`;
  return `<span style="font-size:0.8rem">📅 ${fechaCorta(lim)}</span><div style="font-size:0.7rem;color:var(--text-muted)">en ${diff} días</div>`;
}

