function cerrarModalHistorial() {
  const m = document.getElementById('modal-historial');
  if (m) m.style.display = 'none';
}

async function cargarVersiones(colName) {
  const lista = document.getElementById('hist-versiones-lista');
  if (!colName) { lista.innerHTML = ''; return; }
  lista.innerHTML = '<p style="color:#94a3b8;text-align:center">Cargando...</p>';
  try {
    const versions = await fsGetVersions(colName);
    if (!versions.length) {
      lista.innerHTML = '<p style="color:#94a3b8;text-align:center">Sin versiones guardadas aún.<br>Las versiones se crean automáticamente a partir de ahora.</p>';
      return;
    }
    lista.innerHTML = versions.map(v => {
      const fecha = new Date(v.ts).toLocaleString('es-MX',{timeZone:'America/Monterrey',dateStyle:'short',timeStyle:'short'});
      return `<div style="background:#0f172a;border:1px solid #334155;border-radius:8px;padding:12px;display:flex;justify-content:space-between;align-items:center">
        <div>
          <div style="font-weight:600;font-size:14px">${fecha}</div>
          <div style="color:#94a3b8;font-size:12px">${(v.items||[]).length} registros</div>
        </div>
        <button onclick="confirmarRestaurar('${colName}','${v.id}')"
          style="background:#7c3aed;color:#fff;border:none;border-radius:6px;padding:6px 14px;cursor:pointer;font-size:13px">
          Restaurar
        </button>
      </div>`;
    }).join('');
  } catch(e) {
    lista.innerHTML = `<p style="color:#f87171">Error: ${esc(String(e.message || e))}</p>`;
  }
}

function confirmarRestaurar(colName, versionId) {
  const nombre = NOMBRES_COLS[colName] || colName;
  _confirm(`¿Restaurar esta versión de "${nombre}"?\n\nEsto reemplazará los datos actuales. El estado actual se guardará como versión antes de restaurar.`, () => fsRestoreVersion(colName, versionId), null, {ok:'Restaurar'});
}
window['abrirModalHistorial'] = abrirModalHistorial;
window['cerrarModalHistorial'] = cerrarModalHistorial;
window['cargarVersiones'] = cargarVersiones;
window['confirmarRestaurar'] = confirmarRestaurar;

function logout() {
  // Detener listeners de sync
  _syncUnsubscribers.forEach(u => u());
  _syncUnsubscribers = [];
  if (auth && auth.currentUser) auth.signOut().catch(() => {});
  // Seguridad: borrar el caché local (clientes, ventas, montos, etc.) para que no quede
  // visible en el navegador (DevTools → Application → Local Storage) después de cerrar
  // sesión, sobre todo en equipos compartidos. Al volver a iniciar sesión se vuelve a
  // descargar todo desde Firestore.
  try { localStorage.clear(); } catch(e) {}
  try { sessionStorage.removeItem("_qs"); } catch(e) {}
  session = null;
