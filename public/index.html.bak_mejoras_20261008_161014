// Verifica el rol REAL del usuario autenticado consultando Firestore directamente.
// Usada en operaciones sensibles para que session.rol falsificada desde la consola no tenga efecto.
async function _checkAdminReal() {
  try {
    const u = firebase.auth().currentUser;
    if (!u) return false;
    const snap = await firestore.collection('roles').doc(u.uid).get();
    return snap.exists && snap.data().rol === 'admin';
  } catch(e) { return false; }
}

// Escapa texto controlado por el usuario antes de insertarlo en innerHTML, para prevenir XSS.
function escapeHtml(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
