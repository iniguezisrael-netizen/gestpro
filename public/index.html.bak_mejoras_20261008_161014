// Leer una colección de Firestore
// Array cols: lee {col}/data.items[] (1 lectura)
// Resto: consulta documentos individuales, excluye meta-docs con prefijo '_'
async function fsReadCollection(colName) {
  if (!firestore) return null;
  try {
    if (FS_ARRAY_COLS.includes(colName)) {
      // Caché primero: 0 lecturas de servidor si IndexedDB tiene datos
      try {
        const doc = await firestore.collection(colName).doc('data').get({ source: 'cache' });
        if (doc.exists) return doc.data().items || [];
      } catch(_) {}
      // Sin caché → servidor (primera carga o caché vacío)
      const doc = await firestore.collection(colName).doc('data').get();
      return doc.exists ? (doc.data().items || []) : [];
    }
    // Caché primero: 0 lecturas de servidor si IndexedDB tiene datos
    try {
      const snap = await firestore.collection(colName).get({ source: 'cache' });
      if (!snap.empty) {
        return snap.docs
          .filter(d => !d.id.startsWith('_'))
          .map(d => d.data())
          .filter(d => d && d.id != null);
      }
    } catch(_) {}
    // Sin caché → servidor (primera carga o caché vacío)
    const snap = await firestore.collection(colName).get();
    return snap.docs
      .filter(d => !d.id.startsWith('_'))
      .map(d => d.data())
      .filter(d => d && d.id != null);
  } catch(e) {
    console.warn('fsReadCollection error:', colName, e);
    return null;
  }
}

// Eliminar un registro en Firestore
// Array cols: transacción que filtra el array; Resto: borra documento individual
async function fsDeleteFromCollection(colName, id) {
  if (!firestore) return;
  try {
    if (FS_ARRAY_COLS.includes(colName)) {
      const docRef = firestore.collection(colName).doc('data');
      await firestore.runTransaction(async (tx) => {
        const snap = await tx.get(docRef);
        const items = snap.exists ? (snap.data().items || []) : [];
        tx.set(docRef, { items: items.filter(i => i.id !== id), updatedAt: Date.now(), writerId: _mySessionId });
      });
    } else {
      await firestore.collection(colName).doc(String(id)).delete();
      if (_firestoreKnownIds[colName]) _firestoreKnownIds[colName].delete(String(id));
    }
  } catch(e) { console.error('fsDeleteFromCollection error:', colName, e); }
}

