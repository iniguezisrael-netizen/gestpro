  }
  .dark-toggle-btn:hover { background: var(--bg); transform: rotate(20deg); }

  /* ── SKELETON SHIMMER ───────────────────────────────────────────── */
  @keyframes shimmer { from{background-position:-200% 0} to{background-position:200% 0} }
  .sk {
