        style="padding:3px 6px;border-radius:12px;font-size:0.78rem;font-weight:600;border:none;cursor:pointer;outline:none;
          ${vt.estado==='Pagada'?'background:#dcfce7;color:#15803d':vt.estado==='Terminada'?'background:#ede9fe;color:#5b21b6':vt.estado==='En Proceso'?'background:#dbeafe;color:#1e40af':'background:#fef3c7;color:#92400e'}">
