        doc.line(M, y, M+60, y);
        doc.setFont('helvetica','normal'); doc.setFontSize(7); doc.setTextColor(100,116,139);
        doc.text('Firma del cliente', M, y+4);
        // Bank data
        y += 12;
        doc.setDrawColor(226,232,240); doc.setLineWidth(0.2); doc.line(M, y, W-M, y); y += 4;
        doc.setFont('helvetica','bold'); doc.setFontSize(7); doc.setTextColor(51,65,85);
        doc.text('DATOS BANCARIOS', M, y); y += 4;
        const bankCols = [
          ['Razón Social:',_EMPRESA.razonSocial],['RFC:',_EMPRESA.rfc],
          ['Banco:',_EMPRESA.banco],['Cuenta:',_EMPRESA.cuenta],
          ['No. Tarjeta:',_EMPRESA.tarjeta],['CLABE:',_EMPRESA.clabe],
        ];
        const colW = (W-M*2)/2;
        bankCols.forEach(([lbl,val],i) => {
          const col = i%2, row = Math.floor(i/2);
