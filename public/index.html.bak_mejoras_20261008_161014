      const nuevoIdx = vt.pagos.length - 1;
      vt.anticipo = vt.pagos.reduce((s,p) => s + p.monto, 0);
      vt.saldo    = Math.max(0, vt.total - vt.anticipo);
      if (vt.saldo === 0) {
        vt.estado = 'Pagada';
        const _ci = (db.consignacion||[]).find(c => String(c.ventaId) === String(vt.id));
        if (_ci) _ci.estado = 'Vendido';
        if (vt._nuevaLogicaProd) { _descontarProdVenta(vt.items); vt._nuevaLogicaProd = false; }
      }
      // Sincronizar con db.ventas por si _verVentaRef es una referencia desactualizada
      // (ocurre cuando el listener de Firestore reemplazó el objeto mientras el modal estaba abierto)
      { const _vtLive = (db.ventas||[]).find(v => String(v.id) === String(vt.id));
