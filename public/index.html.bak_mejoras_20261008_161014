        const cXs=[M, M+c0W, M+c0W+c1W, M+c0W+c1W+c2W];
        const cWs=[c0W,c1W,c2W,c3W];
        const cAligns=['left','center','right','right'];
        const cLbls=['CONCEPTO / SERVICIO','CANT.','PRECIO UNIT.','SUBTOTAL'];
        // Encabezado tabla
        doc.setFillColor(45,55,72); doc.rect(M,bodyY,descColW,tblHdrH,'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(6); doc.setTextColor(255,255,255);
        cLbls.forEach((lbl,i)=>{
          const al=cAligns[i];
          const tx=al==='center'?cXs[i]+cWs[i]/2:al==='right'?cXs[i]+cWs[i]-2:cXs[i]+2;
          doc.text(lbl, tx, bodyY+4.7, {align:al==='center'?'center':al==='right'?'right':'left'});
