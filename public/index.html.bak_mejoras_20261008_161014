// Resto: documento individual por registro {col}/{id}
//   → sin race conditions, sin límite de 1MB, sync incremental.
async function fsWriteCollection(colName, arr) {
  if (!firestore) return;
  const clean = JSON.parse(JSON.stringify(arr == null ? [] : arr));

  try {
    // ── Formato array: colecciones grandes (materia, catalogoMateriales) ──────
    if (FS_ARRAY_COLS.includes(colName)) {
      const docRef = firestore.collection(colName).doc('data');
      let finalItems = clean;
      await firestore.runTransaction(async (tx) => {
        const snap = await tx.get(docRef);
        let merged = clean;
        if (snap.exists) {
          const serverItems = snap.data().items || [];
          if (VERSION_COLS.includes(colName) && serverItems.length) {
            fsSaveVersion(colName, serverItems);
          }
          const localIds = new Set(clean.map(i => i.id));
          const extra = serverItems.filter(s => !localIds.has(s.id));
          if (extra.length) merged = [...clean, ...extra];
        }
        tx.set(docRef, { items: merged, updatedAt: Date.now(), writerId: _mySessionId });
        finalItems = merged;
      });
      try { db[colName] = JSON.parse(JSON.stringify(finalItems)); save('gp_' + colName, db[colName]); } catch(e) { console.error('[sync] Error guardando ' + colName + ' en local:', e); }
      return;
    }

    // ── Inventario: delta atómico para campos numéricos (cantidad, stock, etc.) ─
    // materia y catalogoMateriales usan docs individuales + transacciones que aplican
    // el delta (cambio local) sobre el valor actual del servidor.
    // Ejemplo: almacén suma +50, secretaria resta -10 al mismo tiempo → resultado 140 (correcto).
    // Solo los items con cambios numéricos van por transacción; el resto por batch.
    const INVENTORY_DELTA_COLS = [
      'materia', 'catalogoMateriales',
      'consignacion', 'productos', 'bodegas',
      'herramientas', 'herramientasAsignadas',
      'entregaInsumos', 'produccion', 'vehiculos',
    ];
    if (INVENTORY_DELTA_COLS.includes(colName)) {
      if (VERSION_COLS.includes(colName) && clean.length) fsSaveVersion(colName, clean);
      const colRef = firestore.collection(colName);
      const srvSnap = (window._serverSnapshot || {})[colName] || {};

      // Manejar eliminaciones: docs que estaban en Firestore pero ya no están localmente
      const newIds = new Set(clean.filter(i => i.id != null).map(i => String(i.id)));
      const knownIds = _firestoreKnownIds[colName] || new Set();
      const toDelete = [...knownIds].filter(id => !newIds.has(id));
      _firestoreKnownIds[colName] = new Set(newIds);
      _saveKnownIds();
      if (toDelete.length) {
        // Para consignacion: solo borrar IDs con tombstone explícito (puestos por delConsig).
        // IDs sin tombstone = artículos de otro dispositivo que aún no sincronizaron → no borrar.
        const safeToDelete = colName === 'consignacion'
          ? toDelete.filter(id => !!(_fsTombstones['consignacion'] || {})[id])
          : toDelete;
        if (safeToDelete.length) {
          safeToDelete.forEach(id => _addTombstone(colName, id));
          const BATCH_MAX = 400;
          for (let i = 0; i < safeToDelete.length; i += BATCH_MAX) {
            const batch = firestore.batch();
            safeToDelete.slice(i, i + BATCH_MAX).forEach(id => batch.delete(colRef.doc(id)));
            await batch.commit();
          }
        }
      }

      // Separar items con cambios numéricos (transacción) de los sin cambio (batch)
      const needsTx = [];
      const batchItems = [];
      for (const item of clean) {
        if (item.id == null) continue;
        const orig = srvSnap[String(item.id)];
        const hasNumericDelta = orig && Object.keys(item).some(k =>
          typeof item[k] === 'number' && typeof orig[k] === 'number' && item[k] !== orig[k]
        );
        if (hasNumericDelta) needsTx.push(item);
        else batchItems.push(item);
      }

      // Transacciones para items con delta numérico
      const txResults = {};
      for (const item of needsTx) {
        const docRef = colRef.doc(String(item.id));
        const orig = srvSnap[String(item.id)] || {};
        let committed = { ...item };
        await firestore.runTransaction(async tx => {
          const snap = await tx.get(docRef);
          let final = { ...item };
          if (snap.exists) {
            const server = snap.data();
            for (const key of Object.keys(item)) {
              const lv = item[key], ov = orig[key], sv = server[key];
              if (typeof lv === 'number' && typeof ov === 'number' && typeof sv === 'number') {
                final[key] = Math.max(0, sv + (lv - ov)); // delta atómico
              }
            }
            // Merge arrays anidadas
            for (const key of Object.keys(server)) {
              const sArr = server[key], lArr = final[key];
              if (Array.isArray(sArr) && Array.isArray(lArr)) {
                const lIds = new Set(lArr.map(x => x?.id).filter(Boolean));
                const extra = sArr.filter(x => x?.id && !lIds.has(x.id));
                if (extra.length) final[key] = [...lArr, ...extra];
              }
