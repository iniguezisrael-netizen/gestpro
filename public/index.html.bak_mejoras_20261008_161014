  `, [
    { label:'🗑️ Sí, eliminar '+registros.length+' registro'+(registros.length!==1?'s':''), cls:'btn-danger', action:() => {
      if (!can(['admin'])) return;
      registros.forEach(c => {
        if (window._serverSnapshot?.cobranza?.[String(c.id)]) delete window._serverSnapshot.cobranza[String(c.id)];
        try { if (firestore) firestore.collection('cobranza').doc(String(c.id)).delete().catch(()=>{}); } catch(e) {}
      });
      db.cobranza = db.cobranza.filter(c => !ids.includes(c.id));
      saveDb('cobranza'); closeModal(); renderCobranza();
    }},
    { label:'Cancelar', cls:'btn-secondary', action:closeModal }
  ]);
}
window['_eliminarCobranzaArchivadasSeleccionadas'] = _eliminarCobranzaArchivadasSeleccionadas;

