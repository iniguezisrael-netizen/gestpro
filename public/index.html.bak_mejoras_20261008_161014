function renderFacturas() {
  const el = document.getElementById('page-facturas');
  const q = { nombre:'', folio:'', fecha:'' }; // estado de búsqueda en memoria

  // Opciones dinámicas para los filtros de año y RFC
  const anios = [...new Set((db.facturas||[]).filter(f=>f.fecha).map(f=>f.fecha.substring(0,4)))].sort((a,b)=>b-a);
  const rfcs = [...new Map((db.facturas||[]).filter(f=>f.rfcReceptor).map(f=>[f.rfcReceptor, f.receptor])).entries()].sort((a,b)=>(a[1]||'').localeCompare(b[1]||''));
  const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

  // Aplica los filtros de búsqueda sobre la lista de facturas.
  // `omitir` permite excluir un filtro específico (se usa para recalcular las opciones del select de RFC).
  function _filtrarLista(filtro, omitir) {
    let lista = db.facturas.slice().reverse();
    if (filtro.nombre && omitir!=='nombre') lista = lista.filter(f=>((f.serie||'')+(f.folio||'')+' '+f.receptor+' '+f.rfcReceptor+' '+f.folio+' '+f.serie+' '+f.uuid+' '+(f.nombreArchivo||'')).toLowerCase().includes(filtro.nombre.toLowerCase()));
    if (filtro.folio  && omitir!=='folio')  lista = lista.filter(f=>(f.conceptos||[]).some(c=>(c.descripcion||'').toLowerCase().includes(filtro.folio.toLowerCase())));
    if (filtro.mes    && omitir!=='mes')    lista = lista.filter(f=>f.fecha && f.fecha.substring(5,7) === filtro.mes);
    if (filtro.anio   && omitir!=='anio')   lista = lista.filter(f=>f.fecha && f.fecha.substring(0,4) === filtro.anio);
    if (filtro.rfc    && omitir!=='rfc')    lista = lista.filter(f=>(f.rfcReceptor||'') === filtro.rfc);
    if (filtro.tipo   && omitir!=='tipo') {
      if (filtro.tipo === 'SINFOLIO') lista = lista.filter(f=>!f.serie && !f.folio);
      else lista = lista.filter(f=>(f.serie||'').toUpperCase() === filtro.tipo);
    }
    if (filtro.colFolio   && omitir!=='colFolio')   lista = lista.filter(f=>((f.serie||'')+(f.folio||'')+' '+(f.nombreArchivo||'')).toLowerCase().includes(filtro.colFolio.toLowerCase()));
    if (filtro.colFecha   && omitir!=='colFecha')   lista = lista.filter(f=>(f.fecha||'').includes(filtro.colFecha));
    if (filtro.colCliente && omitir!=='colCliente') lista = lista.filter(f=>(f.receptor||'').toLowerCase().includes(filtro.colCliente.toLowerCase()));
    return lista;
  }

