function saveCotiz(id) {
  if (_fotosSubiendoCz > 0) { _info(`⏳ Espera a que terminen de subir las fotos (${_fotosSubiendoCz} pendiente${_fotosSubiendoCz>1?'s':''})`); return; }
  const nombre = czVal('nombre'), apellido = czVal('apellido');
  if (!nombre || nombre === 'No aplica') { _info('El nombre del cliente es obligatorio'); return; }
  if (!cotizItems.length) { _info('Agrega al menos un item'); return; }
  const ivaElS = document.querySelector('input[name="cz-iva"]:checked');
  const ivaModeS = ivaElS ? ivaElS.value : 'neto';
  const masIvaS = ivaModeS === 'mas';
  const subtotalCz = cotizItems.reduce((s,i)=>s+i.cantidad*i.precio,0);
  const ivaAmtS = ivaModeS === 'mas' ? round2(subtotalCz * 0.16) : (ivaModeS === 'incluido' ? round2(subtotalCz - subtotalCz / 1.16) : 0);
  const total = round2(ivaModeS === 'mas' ? subtotalCz + ivaAmtS : subtotalCz);
  const cliente = [nombre, apellido !== 'No aplica' ? apellido : ''].filter(Boolean).join(' ');
  // Un folio "real" es pequeño y secuencial. Si es igual o mayor a 1000 probablemente
  // es un ID global (sid()) que se coló accidentalmente. Se filtra para no romper la secuencia.
  const _isFolioReal = (f) => f && typeof f === 'number' && f < 1000;
  const _nextCzFolio = () => {
    const folios = (db.cotizaciones||[]).map(c => c.folio || 0).filter(_isFolioReal);
    return (folios.length ? Math.max(...folios) : 0) + 1;
  };
  const existente = id ? (db.cotizaciones.find(x => String(x.id) === String(id)) || null) : null;
  const obj = {
    id: id || sid(),
    // Al editar: conservar folio si es real; si era un ID-coladizo, asignar uno secuencial.
    folio: existente ? (_isFolioReal(existente.folio) ? existente.folio : _nextCzFolio()) : _nextCzFolio(),
    fecha: v('cz-fecha'), fechaEntrega: v('cz-entrega'), validez: parseInt(document.getElementById('cz-validez').value)||0, cliente,
    ctNombre: nombre, ctApellido: czVal('apellido'),
    ctCiudad: czVal('ciudad'), ctEstado: czVal('estado'), ctEmpresa: czVal('empresa'),
    ctRfc: (czVal('rfc')||'').toUpperCase(), ctTelFijo: czVal('telfijo'), ctCelular: czVal('celular'),
    ctCorreo: czVal('correo'),
    ctDireccion: czVal('direccion'), ctColonia: czVal('colonia'), ctCp: czVal('cp'),
    estado: v('cz-estado-form') || existente?.estado || 'Pendiente',
    unidad: v('cz-unidad'), tipo: v('cz-tipo'),
    forro: v('cz-forro'), color: v('cz-color'),
    observaciones: v('cz-observaciones'),
    notas: v('cz-notas'),
    recFecha: v('cz-rec-fecha'),
    recHora: document.getElementById('cz-rec-todoeldia')?.checked ? 'Todo el día' : v('cz-rec-hora'),
    recNota: v('cz-rec-nota'),
    recHecho: existente?.recHecho || false,
    items: JSON.parse(JSON.stringify(cotizItems)), total,
    iva: masIvaS, ivaMode: ivaModeS, subtotal: subtotalCz, ivaAmount: ivaAmtS,
    fotos: [..._tempFotosCz],
    usuario: id ? (existente?.usuario || session.nombre) : session.nombre,
    usuarioRol: id ? (existente?.usuarioRol || session.rol) : session.rol
  };
  // Si el usuario cambió la fecha del recordatorio y no está hecho, limpiar descarte de localStorage
  if (obj.recFecha && obj.recFecha !== existente?.recFecha && !obj.recHecho) {
    window._undismissById && window._undismissById(String(obj.id));
  }
  const _czDbIdx = (db.cotizaciones || []).findIndex(x => String(x.id) === String(id || obj.id));
  if (_czDbIdx >= 0) db.cotizaciones[_czDbIdx] = obj; else db.cotizaciones.push(obj);
  upsertCliente({ nombre: obj.ctNombre, apellido: obj.ctApellido, ciudad: obj.ctCiudad, estado: obj.ctEstado, empresa: obj.ctEmpresa, telfijo: obj.ctTelFijo, celular: obj.ctCelular, correo: obj.ctCorreo, direccion: obj.ctDireccion, colonia: obj.ctColonia, cp: obj.ctCp });

  // Guardar clientes en segundo plano
  saveDb(['clientes']);

  // Escribir la cotización directamente a Firestore (sin pasar por el dirty-check del batch)
  // para garantizar que el cambio llega al servidor aunque el snapshot esté desactualizado.
  const _objToSave = JSON.parse(JSON.stringify(obj));
  if (firestore) {
    if (!window._ownWriteUntilByCol) window._ownWriteUntilByCol = {};
    window._ownWriteUntilByCol['cotizaciones'] = Date.now() + 6000;
    setSyncStatus('syncing');
    firestore.collection('cotizaciones').doc(String(obj.id)).set(_objToSave)
      .then(() => {
        window._ownWriteUntilByCol['cotizaciones'] = Math.max(window._ownWriteUntilByCol['cotizaciones'] || 0, Date.now() + 1000);
        // Actualizar snapshot para que saves futuros calculen dirty correctamente
        window._serverSnapshot = window._serverSnapshot || {};
        window._serverSnapshot.cotizaciones = window._serverSnapshot.cotizaciones || {};
        window._serverSnapshot.cotizaciones[String(obj.id)] = JSON.parse(JSON.stringify(_objToSave));
        save('gp_cotizaciones', db.cotizaciones);
        setSyncStatus('ok');
        _programarRespaldo();
      })
      .catch(e => {
        console.error('Error guardando cotización en Firestore:', e);
        setSyncStatus('error', e.message || String(e));
        _info('⚠️ No se pudo guardar en la nube: ' + (e.message || 'Error desconocido') + '\nEl dato está seguro en este dispositivo.');
      });
  } else {
    save('gp_cotizaciones', db.cotizaciones);
  }

  closeModal(); renderCotizaciones();
}

