    // ── PIE ──
    const footY = Math.min(Math.max(_noteEndY + 6, 268), 274);
    doc.setDrawColor(226,232,240); doc.setLineWidth(0.4);
    doc.line(M, footY, W-M, footY);
    doc.setFont('helvetica','normal'); doc.setFontSize(7.5); doc.setTextColor(100,116,139);
    doc.text('Crucero Arandas #900, Col. el Crucero de Arandas, Tepatitlán, Jalisco, México', W/2, footY+5, {align:'center'});
    doc.text('Tel: 378-70-100-90  ·  WhatsApp: 378-710-5467  ·  ventas@camperslacuesta.com  ·  www.camperslacuesta.com', W/2, footY+11, {align:'center'});
    const _secCz2 = (_rolesParaCaja||[]).find(u => u.nombre === c.usuario && u.rol === 'secretaria');
    if (_secCz2) { doc.setFontSize(7); doc.text('Elaborado por: ' + c.usuario + '  ·  adriana@camperslacuesta.com', W/2, footY+17, {align:'center'}); }
  }

  // ── GENERAR PDF ──
  function _entregarPDF(fname, pdfBlob) {
    if (window._gpWaBlobCallback) { const cb=window._gpWaBlobCallback; window._gpWaBlobCallback=null; cb(pdfBlob,fname); return; }
    const blobUrl = URL.createObjectURL(pdfBlob);
    if (autoDescargar) {
      // Dispara la descarga real del archivo (sin abrir pestaña/overlay), para
      // que el navegador lo guarde directamente en la carpeta de Descargas.
      const a = document.createElement('a');
      a.href = blobUrl;
      a.download = fname;
      document.body.appendChild(a);
      a.click();
      a.remove();
    } else {
      _mostrarPDFOverlay(blobUrl, fname);
    }
    setTimeout(() => URL.revokeObjectURL(blobUrl), 120000);
  }

  if (_ventaPedido) {
    buildPage('cliente');
    if (!window._pdfSoloCliente) {
      doc.addPage(); buildPage('empresa');
      doc.addPage(); buildPage('produccion');
    }
    window._pdfSoloCliente = false;
    const pedidoLabel = _ventaPedido.folioPedido || `PED-${String(_ventaPedido.id).padStart(5,'0')}`;
    const fname = `Pedido_${pedidoLabel}_${c.cliente.replace(/\s+/g,'_')}.pdf`;
    _entregarPDF(fname, doc.output('blob'));
  } else {
    buildPage('cotizacion');
    const _clienteNom = (c.cliente || ((c.ctNombre||'') + (c.ctApellido?' '+c.ctApellido:'')).trim() || 'cliente');
    const fname = `Cotizacion_${folio}_${_clienteNom.replace(/\s+/g,'_')}.pdf`;
    _entregarPDF(fname, doc.output('blob'));
  }
  } catch(e) {
    console.error('[PDF] Error en _buildPDF:', e);
    alert('Error generando PDF: ' + (e.message||e) + '\n\nUsando impresión alternativa...');
    _abrirImpresionCotiz(c);
  }
}


