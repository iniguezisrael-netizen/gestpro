  if (!cliente) { _info('El cliente es obligatorio'); return; }
  const _doSaveRep = () => {
    const manoObra = +v('rep-mano') || 0;
    const matTotal = repItems.reduce((s,i)=>s+i.qty*i.price, 0);
    db.reparaciones.push({
      id: sid(), folio, cliente,
      tel: v('rep-tel'), unidad: v('rep-unidad'),
      fecha: v('rep-fecha'),
      descripcion: v('rep-descripcion'),
      estado: v('rep-estado'),
      materiales: [...repItems],
      manoObra, total: matTotal+manoObra,
      notas: v('rep-notas'),
      usuario: session.nombre,
      cotizRef: c.id,
      ticketImpreso: false
    });
    c.estado = 'Aprobada';
    saveDb(['reparaciones','cotizaciones']); closeModal();
    navigate('reparaciones');
