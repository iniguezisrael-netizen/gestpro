async function _gpShareBlob(blob, fname, msgEncoded, sinTexto, waUrl) {
  const pdfFile = new File([blob], fname, {type:'application/pdf'});
  if (navigator.canShare && navigator.canShare({files:[pdfFile]})) {
    const shareData = {files:[pdfFile], title:fname};
    if (!sinTexto) shareData.text = decodeURIComponent(msgEncoded);
    try { await navigator.share(shareData); return; } catch(e) { if(e.name==='AbortError') return; }
  }
  // Fallback desktop: descargar PDF y abrir WhatsApp Web con el número
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download=fname;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 60000);
  if (waUrl) {
    setTimeout(() => window.open(waUrl, '_blank'), 500);
    if (typeof showToast==='function') showToast('PDF descargado — adjúntalo en WhatsApp Web');
  } else {
    if (typeof showToast==='function') showToast('PDF descargado — adjúntalo en WhatsApp');
  }
}
