function _globalScanInit() {
  // Input invisible permanente — recibe input del scanner HID en Android/tablet
  // (sin un input enfocado, Android no entrega keydown events a la pagina)
  let bgInput = document.getElementById('gs-bg-reader');
  if (!bgInput) {
    bgInput = document.createElement('input');
    bgInput.type = 'text';
    bgInput.id = 'gs-bg-reader';
    bgInput.setAttribute('aria-hidden', 'true');
    bgInput.setAttribute('tabindex', '0');
    bgInput.setAttribute('autocomplete', 'off');
    bgInput.setAttribute('inputmode', 'none');
    
    bgInput.style.cssText = 'position:fixed;top:0;right:0;width:2px;height:2px;font-size:16px;border:none;outline:none;background:transparent;color:transparent;caret-color:transparent;overflow:hidden;z-index:1;opacity:0;';
    document.body.appendChild(bgInput);
  }

  let _gsBuf = '', _gsTimer = null, _gsFocusTimer = null;
setTimeout(function() { if (bgInput) bgInput.focus({preventScroll:true}); }, 1000);
  let _suppressRefocus = false;

  window._closeKeyboard = function() {
    _suppressRefocus = true;
    clearTimeout(_gsFocusTimer);
    if (document.activeElement) document.activeElement.blur();
    bgInput.value = "";
    setTimeout(function() { _suppressRefocus = false; _gsRefocus(); }, 800);
  };

  function _gsRefocus() {
    if (_suppressRefocus) return;
    if (document.getElementById('modal-entrega-rapida')) return;
    if (document.getElementById('modal-scan-global'))   return;
    const active = document.activeElement;
    const tag = active ? active.tagName.toLowerCase() : '';
    if (['input','textarea','select'].includes(tag) && active.id !== 'gs-bg-reader') return;
    bgInput.focus({preventScroll:true});
  }
  window._gsRefocusIfActive = _gsRefocus;

  // Refocus automático al perder foco (mantiene el escáner activo)
  bgInput.addEventListener('blur', function() {
    clearTimeout(_gsFocusTimer);
    _gsFocusTimer = setTimeout(_gsRefocus, 80);
  });

  bgInput.addEventListener('change', function() { bgInput.dispatchEvent(new Event('input')); });
bgInput.addEventListener('keyup', function() { bgInput.dispatchEvent(new Event('input')); });
var _gsPollVal = '';
setInterval(function() {
  var v = bgInput.value;
  if (v && v !== _gsPollVal) { _gsPollVal = v; bgInput.dispatchEvent(new Event('input')); }
  else if (!v) { _gsPollVal = ''; }
}, 100);
bgInput.addEventListener('input', function() {
    var val = bgInput.value || "";
    bgInput.value = "";
    if (!val) return;
    if (!session || !can(['admin','secretaria','auxiliar','almacen'])) return;
    if (document.getElementById('modal-entrega-rapida')) return;
    if (document.getElementById('modal-scan-global'))   return;
    _gsBuf += val;
    clearTimeout(_gsTimer);
    _gsTimer = setTimeout(function() {
      if (_gsBuf.length >= 3) { var cod=_gsBuf; _gsBuf=''; openScanGlobalModal(cod); }
      else { _gsBuf=''; }
    }, 150);
  });

  bgInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === 'Tab') {
      e.preventDefault();
      if (!session || !can(['admin','secretaria','auxiliar','almacen'])) { _gsBuf=''; return; }
      if (document.getElementById('modal-entrega-rapida')) { _gsBuf=''; return; }
      if (document.getElementById('modal-scan-global'))   { _gsBuf=''; return; }
      if (_gsBuf.length >= 3) { var cod=_gsBuf; _gsBuf=''; clearTimeout(_gsTimer); openScanGlobalModal(cod); }
      else { _gsBuf=''; }
    }
  });

  // Fallback: keydown global (desktop)
  document.addEventListener('keydown', function(e) {
    if (document.getElementById('modal-entrega-rapida')) return;
    if (document.getElementById('modal-scan-global'))   return;
    const active = document.activeElement;
    const tag = active ? active.tagName.toLowerCase() : '';
    if (['input','textarea','select'].includes(tag) && active.id !== 'gs-bg-reader') return;
    if (e.key === 'Enter' || e.key === 'Tab') {
      if (_gsBuf.length >= 3) { var cod=_gsBuf; _gsBuf=''; clearTimeout(_gsTimer); openScanGlobalModal(cod); }
      return;
    }
    if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
      _gsBuf += e.key;
      clearTimeout(_gsTimer);
      _gsTimer = setTimeout(function() {
        if (_gsBuf.length >= 5) { var cod=_gsBuf; _gsBuf=''; openScanGlobalModal(cod); }
        else { _gsBuf=''; }
      }, 120);
    }
  });

  // Activar escáner en el PRIMER toque del usuario (no en carga — evita teclado al abrir app)
  document.addEventListener('touchstart', function _initScan() {
    document.removeEventListener('touchstart', _initScan, true);
    setTimeout(_gsRefocus, 300);
  }, {once: true, passive: true, capture: true});

  window._gsCleanup = function() { clearTimeout(_gsTimer); clearTimeout(_gsFocusTimer); };
}

