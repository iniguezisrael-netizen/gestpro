function saveEi(id) {
  if (!can(['admin','secretaria','auxiliar','almacen'])) { _info('Sin permiso.'); return; }
  const pedidoId    = parseInt(document.getElementById('ei-pedido-id')?.value||'0') || null;
  const folioPedido = document.getElementById('ei-pedido-folio')?.value  || '';
  const cliente     = document.getElementById('ei-pedido-cliente')?.value || '';
  const fecha       = (document.getElementById('ei-fecha')?.value||'').trim();
  const entregadoPor= (document.getElementById('ei-entregadoPor')?.value||'').trim();
  const notas       = (document.getElementById('ei-notas')?.value||'').trim();

  if (!pedidoId)  { _info('Selecciona un pedido.'); return; }
  if (!fecha)     { _info('Indica la fecha.'); return; }
  if (!_eiItems.length) { _info('Agrega al menos un material.'); return; }

  db.entregaInsumos = db.entregaInsumos || [];
  if (id) {
    const idx = db.entregaInsumos.findIndex(x => x.id === id);
    if (idx >= 0) {
      db.entregaInsumos[idx] = { ...db.entregaInsumos[idx], pedidoId, folioPedido, cliente, fecha, entregadoPor, notas, materiales: _eiItems };
    }
  } else {
    db.entregaInsumos.push({ id: sid(), pedidoId, folioPedido, cliente, fecha, entregadoPor, notas, materiales: _eiItems });
  }
  saveDb('entregaInsumos');
  closeModal();
  renderEntregaInsumos();
  showToast(id ? 'Entrega actualizada.' : 'Entrega registrada.', 'success');
}

function delEi(id) {
  if (!can(['admin'])) { _info('Sin permiso para eliminar.'); return; }
  _confirm('¿Eliminar este registro de entrega?', () => { db.entregaInsumos = (db.entregaInsumos||[]).filter(x => x.id !== id); saveDb('entregaInsumos'); renderEntregaInsumos(); showToast('Registro eliminado.', 'warning'); }, null, {ok:'Eliminar'});
}

// ── CONTADORES ANIMADOS EN DASHBOARD ──────────────────────────
function _animarContador(el, target, isMoney) {
  if (!el || isNaN(target)) return;
  const dur = 700;
  const startTime = performance.now();
  function step(now) {
    const elapsed = now - startTime;
    const progress = Math.min(elapsed / dur, 1);
    const ease = 1 - Math.pow(1 - progress, 3);
    const val = target * ease;
    el.textContent = isMoney
      ? '$' + (target % 1 !== 0 ? val.toFixed(2) : Math.round(val).toLocaleString('es-MX'))
      : Math.round(val).toLocaleString('es-MX');
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function _initDashboardAnimations() {
  document.querySelectorAll('.stat-value[data-val]').forEach(el => {
    const raw = parseFloat(el.dataset.val) || 0;
    const isMoney = el.dataset.money === '1';
    _animarContador(el, raw, isMoney);
  });
}

