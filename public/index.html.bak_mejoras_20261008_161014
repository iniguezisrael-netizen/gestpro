function _showVtEstadoDD(el) {
  document.querySelectorAll('.vt-est-dd').forEach(m => m.remove());
  const isAdmin = session.rol === 'admin';
  const estados = ['', 'Pendiente', 'En Proceso', 'Terminada', 'Entregado', 'Pagada'].concat(isAdmin ? ['Cancelada'] : []);
  const labels = {'':'Todos','Pendiente':'Pendiente','En Proceso':'En Proceso','Terminada':'Terminada','Entregado':'Entregado','Pagada':'Pagada','Cancelada':'Cancelada'};
  const current = window._ventasFiltroEstado || '';
  const rect = el.getBoundingClientRect();
  const menu = document.createElement('div');
  menu.className = 'vt-est-dd';
  menu.style.cssText = `position:fixed;top:${rect.bottom+4}px;left:${rect.left}px;background:var(--surface-2,#fff);border:0.5px solid var(--border,#e2e8f0);border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);z-index:9999;min-width:160px;padding:4px 0;`;
  estados.forEach(est => {
    const item = document.createElement('div');
    const active = est === current;
    item.style.cssText = `display:flex;align-items:center;gap:8px;padding:8px 14px;cursor:pointer;font-size:13px;color:${active?'var(--primary,#0ea5e9)':'var(--text-primary,#1e293b)'};font-weight:${active?600:400};`;
    item.textContent = (active ? '✓ ' : '') + (labels[est]||est);
    item.onmouseenter = () => item.style.background = 'var(--surface-1,#f8fafc)';
    item.onmouseleave = () => item.style.background = '';
    item.onclick = () => _pickVtEstadoDD(est);
    menu.appendChild(item);
  });
  document.body.appendChild(menu);
  setTimeout(() => document.addEventListener('click', function _closeVtEstDD(e) {
    if (!menu.contains(e.target) && e.target !== el) { menu.remove(); document.removeEventListener('click', _closeVtEstDD); }
  }), 10);
}
window['_showVtEstadoDD'] = _showVtEstadoDD;
function _pickVtEstadoDD(val) {
  window._ventasFiltroEstado = val;
