let _invDropActiveInput = null;
function _invDropShow(inputId, items, mapRef) {
  _invDropHide();
  const inp = document.getElementById(inputId);
  if (!inp || !items.length) return;
  const rect = inp.getBoundingClientRect();
  const drop = document.createElement('div');
  drop.id = '_inv-custom-drop';
  drop.style.cssText = `position:fixed;z-index:99999;background:#fff;border:1.5px solid #cbd5e1;border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.14);min-width:${Math.max(rect.width,260)}px;left:${rect.left}px;top:${rect.bottom+3}px;max-height:260px;overflow-y:auto`;
  const fm = n => '$' + Number(n||0).toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2});
  items.forEach(item => {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex;align-items:center;gap:10px;padding:8px 11px;cursor:pointer;border-bottom:1px solid #f1f5f9';
    row.onmouseenter = () => row.style.background = '#eff6ff';
    row.onmouseleave = () => row.style.background = '';
    const foto = (item.fotos && item.fotos[0]) || item.foto || '';
    const esConsig = !!item._folio;
    const tw = esConsig ? '52px' : '38px'; const th = esConsig ? '40px' : '38px';
    const thumb = foto
      ? `<img src="${foto}" style="width:${tw};height:${th};object-fit:cover;border-radius:6px;flex-shrink:0;border:1px solid #e2e8f0">`
      : `<div style="width:${tw};height:${th};border-radius:6px;background:#f1f5f9;border:1px solid #e2e8f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:${esConsig?'22':'18'}px">${esConsig?'🚐':'📦'}</div>`;
    const displayNombre = item._displayNombre || item.nombre || '';
    const precio = item.precioPublico||item.precio||0;
    const folioHtml = item._folio ? `<span style="font-size:10px;color:#94a3b8;font-family:monospace;background:#f1f5f9;padding:1px 5px;border-radius:4px;border:1px solid #e2e8f0;margin-right:4px">${esc(item._folio)}</span>` : '';
    row.innerHTML = `${thumb}<div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(displayNombre)}</div><div style="margin-top:2px">${folioHtml}<span style="font-size:11px;color:#0f6e56;font-weight:700">${fm(precio)}</span>${item.unidad?` <span style="font-size:10px;color:#64748b;margin-left:4px">${esc(item.unidad)}</span>`:''}</div></div>`;
    row.onmousedown = e => {
      e.preventDefault();
      inp.value = displayNombre;
      mapRef[displayNombre] = item;
      _invDropHide();
    };
    drop.appendChild(row);
  });
  document.body.appendChild(drop);
  _invDropActiveInput = inp;
  const _close = e => {
    if (e.target !== inp && !drop.contains(e.target)) { _invDropHide(); }
    else { document.addEventListener('mousedown', _close, { once:true }); }
  };
  document.addEventListener('mousedown', _close, { once:true });
}
function _invDropHide() {
  document.getElementById('_inv-custom-drop')?.remove();
  _invDropActiveInput = null;
}
window['_invDropHide'] = _invDropHide;

