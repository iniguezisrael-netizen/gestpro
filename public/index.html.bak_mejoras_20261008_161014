// ===================== AUTH =====================
async function doLogin() {
  const u = document.getElementById('login-user').value.trim().toLowerCase();
  const p = document.getElementById('login-pass').value;
  const btn = document.querySelector('#login-screen .btn-primary');
  btn.disabled = true;
  btn.textContent = 'Entrando…';
  btn.classList.add('btn-loading');
  document.getElementById('login-error').textContent = '';

  if (!FIREBASE_ENABLED || !auth || !firestore) {
    document.getElementById('login-error').textContent = 'Sin conexión. Verifica tu internet e intenta de nuevo.';
    btn.disabled = false; btn.textContent = 'Entrar'; btn.classList.remove('btn-loading');
    return;
  }
  // Si el email del admin aún no se cargó (race condition en carga inicial), esperarlo ahora.
  if (u === ADMIN_USERNAME && !_adminRealEmail) {
    await _loadAdminEmail();
  }

  try {
    const email = getLoginEmail(u);
    let firebaseUser;
    try {
      const cred = await auth.signInWithEmailAndPassword(email, p);
      firebaseUser = cred.user;
    } catch(authErr) {
      // Seguridad: no permitir bypass de auth offline — siempre se requiere verificar credenciales.
      throw authErr;
    }
    const uid = firebaseUser.uid;
    const roleDoc = await firestore.collection('roles').doc(uid).get();
    if (!roleDoc.exists) {
      await auth.signOut();
      document.getElementById('login-error').textContent = 'Esta cuenta no tiene un rol asignado. Contacta al administrador.';
      btn.disabled = false; btn.textContent = 'Entrar'; btn.classList.remove('btn-loading');
      return;
    }
    const rdata = roleDoc.data();
    // Formatear nombre: para roles no-admin agrega el rol entre paréntesis.
    // Ej: nombre="Adriana", rol="secretaria" → "Adriana (Secretaria)"
    const _rolLabel = ROL_LABELS[rdata.rol] || rdata.rol;
    const _nombreBase = rdata.nombre || u;
    const _nb = _nombreBase.toLowerCase(), _rl = _rolLabel.toLowerCase();
    const _nombreFmt = (rdata.rol !== 'admin' && !_nb.includes(_rl) && !_rl.includes(_nb))
      ? `${_nombreBase} (${_rolLabel})`
      : _nombreBase;
    session = Object.freeze({ uid, user: u, rol: rdata.rol, nombre: _nombreFmt });
    // Guardar sesión mínima en sessionStorage: sobrevive navegación QR en la misma pestaña
    try { sessionStorage.setItem("_qs", JSON.stringify({uid, user: u, rol: rdata.rol, nombre: _nombreFmt, exp: Date.now() + 300000})); } catch(_e) {}
    if (window._startIdleTimer) window._startIdleTimer();
    // Registro de acceso
    try {
      await firestore.collection('_logs').add({
        tipo: 'login', usuario: u, rol: rdata.rol, nombre: _nombreFmt,
        fecha: new Date().toISOString(), uid
      });
    } catch(_) {}
  } catch(e) {
    document.getElementById('login-error').textContent = 'Usuario o contraseña incorrectos';
    btn.disabled = false; btn.textContent = 'Entrar'; btn.classList.remove('btn-loading');
    return;
  }

  document.getElementById('login-screen').style.display = 'none';
  btn.disabled = false; btn.textContent = 'Entrar'; btn.classList.remove('btn-loading');
  // Si hay ?codigo= en URL y rol permitido → mostrar ficha interna QR
  if (window._mostrarFichaQR && ['admin','secretaria','auxiliar'].includes(session.rol) &&
      new URLSearchParams(window.location.search).get('codigo')) {
    // Primero cargar datos de Firebase para que la búsqueda encuentre el artículo
    await loadFromFirebase().catch(() => {});
    startRealtimeSync();
    window._mostrarFichaQR();
  } else if (window._mostrarFichaConsig && ['admin','secretaria','auxiliar'].includes(session.rol) &&
      new URLSearchParams(window.location.search).get('consig')) {
    await loadFromFirebase().catch(() => {});
    startRealtimeSync();
    window._mostrarFichaConsig();
  } else {
    document.getElementById('app').style.display = 'block';
    initApp();
    // Sync en tiempo real en background (no bloquea) -- ya autenticado, las reglas de Firestore lo permiten
    loadFromFirebase().catch(() => {});
    startRealtimeSync();
  }
  // Arrancar idle timer desde el momento de login
  if (window._resetIdleTimer) window._resetIdleTimer();
}

// ── Idle timer: pausar listeners Firestore tras 5 min de inactividad ──────────
(function() {
  const IDLE_MS = 5 * 60 * 1000;
  let _idleTimer = null;
  let _syncPaused = false;
  function _pauseSync() {
    if (_syncPaused || !FIREBASE_ENABLED || !firestore) return;
    _syncPaused = true;
    _syncUnsubscribers.forEach(u => u());
    _syncUnsubscribers = [];
    _listenersStarted.clear();
    console.log('[idle] Listeners Firestore pausados por inactividad (20 min)');
  }
  function _resumeSync() {
    if (!_syncPaused || !FIREBASE_ENABLED || !firestore) return;
    if (!session || !session.rol) return;
    _syncPaused = false;
    startRealtimeSync();
    if (currentPage && _PAGE_EXTRA_COLS[currentPage]) _ensureLazyCollections(_PAGE_EXTRA_COLS[currentPage]);
    console.log('[idle] Listeners Firestore reconectados');
  }
  function _resetIdleTimer() {
    clearTimeout(_idleTimer);
    if (_syncPaused) _resumeSync();
    _idleTimer = setTimeout(_pauseSync, IDLE_MS);
  }
  ['mousemove','mousedown','keydown','touchstart','scroll','click'].forEach(ev => {
    document.addEventListener(ev, _resetIdleTimer, { passive: true });
  });
  window._resetIdleTimer = _resetIdleTimer;
})();

// ── Page Visibility API: pausar listeners cuando la pestaña queda en segundo plano ─
(function() {
  let _visPaused = false;
  function _onVisChange() {
    if (document.visibilityState === 'hidden') {
      if (_visPaused || !FIREBASE_ENABLED || !firestore) return;
      _visPaused = true;
      _syncUnsubscribers.forEach(u => u());
      _syncUnsubscribers = [];
      _listenersStarted.clear();
      console.log('[vis] Listeners Firestore pausados (pestaña oculta)');
    } else {
      if (!_visPaused || !FIREBASE_ENABLED || !firestore) return;
      if (!session || !session.rol) return;
      _visPaused = false;
      startRealtimeSync();
      if (currentPage && _PAGE_EXTRA_COLS[currentPage]) _ensureLazyCollections(_PAGE_EXTRA_COLS[currentPage]);
      if (window._resetIdleTimer) window._resetIdleTimer();
      console.log('[vis] Listeners Firestore reconectados (pestaña visible)');
    }
  }
  document.addEventListener('visibilitychange', _onVisChange);
})();

// Seguridad: al cerrar la pestaña/ventana sin hacer logout, limpiar localStorage
// para que los datos no queden visibles en equipos compartidos.
window.addEventListener('beforeunload', (e) => {
  // Si hay datos capturados offline que aún no se han subido a la nube, advertir antes de salir
  if (_hasPendingSync || _modalConfirmClose) {
    const msg = _hasPendingSync
      ? 'Hay información capturada que aún no se ha sincronizado con la nube. Si cierras ahora podrías perder datos.'
      : 'Tienes un formulario abierto con cambios sin guardar. Si cierras perderás la información.';
    e.preventDefault();
    e.returnValue = msg;
    return msg;
  }
  if (session) {
    // Conservar claves de recordatorios: no son datos sensibles y deben sobrevivir un refresh
    const _kDisp = '_rec_dismissed_ids'; const _kSnz = '_rec_snooze';
    const _vDisp = localStorage.getItem(_kDisp); const _vSnz = localStorage.getItem(_kSnz);
    try { localStorage.clear(); } catch(e) {}
    try { if (_vDisp) localStorage.setItem(_kDisp, _vDisp); } catch(e) {}
    try { if (_vSnz) localStorage.setItem(_kSnz, _vSnz); } catch(e) {}
  }
});

// ── BLOQUEAR PULL-TO-REFRESH EN MÓVIL Y PEDIR CONFIRMACIÓN ──
// Nota: overscroll-behavior-y:contain en CSS ya bloquea el PTR nativo del navegador.
// Este bloque añade la confirmación "¿deseas actualizar?" y solo actúa cuando el
// gesto es lento e intencional (no un scroll rápido normal).
(function() {
  let _ptStartY = 0;
  let _ptStartTime = 0;
  let _ptPulling = false;
  let _ptBlocking = false; // true solo cuando bloqueamos activamente el evento
  let _ptBar = null;

  function _ptGetBar() {
    if (!_ptBar) {
      _ptBar = document.createElement('div');
      _ptBar.style.cssText = [
        'position:fixed','top:0','left:0','right:0','z-index:999999',
        'background:#1e293b','color:#f8fafc','text-align:center',
        'padding:10px 16px','font-size:0.88rem','font-weight:600',
        'transform:translateY(-100%)','transition:transform 0.15s',
        'pointer-events:none'
      ].join(';');
      document.body.appendChild(_ptBar);
    }
    return _ptBar;
  }

  document.addEventListener('touchstart', (e) => {
    _ptPulling = false;
    _ptBlocking = false;
    if (e.touches.length > 1) return; // ignorar pinch-zoom
    // Solo activar si la página está en el tope Y ningún padre tiene scroll propio
    if ((window.scrollY || window.pageYOffset || 0) > 0) return;
    let el = e.target;
    while (el && el !== document.body) {
      const st = el.scrollTop;
      const sh = el.scrollHeight;
      const ch = el.clientHeight;
      // Si el elemento es scrollable y tiene contenido, no activar PTR
      if (sh > ch && st > 0) return;
      // Si puede hacer scroll hacia abajo (no está al tope), tampoco activar
      if (sh > ch && st === 0) {
        // Está al tope de un contenedor scrollable — puede ser scroll, no PTR
        return;
      }
      el = el.parentElement;
    }
    _ptStartY = e.touches[0].pageY;
    _ptStartTime = Date.now();
    _ptPulling = true;
  }, { passive: true });

  document.addEventListener('touchmove', (e) => {
    if (!_ptPulling || e.touches.length > 1) { _ptPulling = false; return; }
    const dist = e.touches[0].pageY - _ptStartY;
    if (dist <= 0) { _ptPulling = false; return; }

    const elapsed = Date.now() - _ptStartTime;
    const velocity = dist / Math.max(elapsed, 1);

    if (dist > 30 && velocity < 0.8) {
      _ptBlocking = true;
      const pct = Math.min(100, dist * 1.0);
      const bar = _ptGetBar();
      bar.textContent = pct >= 80 ? '🔄 Suelta para actualizar' : '↓ Baja para actualizar';
      bar.style.transform = `translateY(${-100 + pct}%)`;
    }
  }, { passive: true });

  document.addEventListener('touchend', (e) => {
    if (!_ptPulling) return;
    _ptPulling = false;
    const wasBlocking = _ptBlocking;
    _ptBlocking = false;
    if (_ptBar) _ptBar.style.transform = 'translateY(-100%)';
    if (!wasBlocking) return;
    const dist = (e.changedTouches[0] ? e.changedTouches[0].pageY : _ptStartY) - _ptStartY;
    if (dist > 80) {
      setTimeout(() => {
        _confirm('Si actualizas la aplicación se perderá lo que llevas capturado.\n\n¿Deseas actualizar de todas formas?', () => location.reload(), null, {ok:'Actualizar'});
      }, 200);
    }
  }, { passive: true });
})();

// ── IndexedDB helpers (para guardar el handle de carpeta) ──
function _idbOpen() {
  return new Promise((res, rej) => {
    const r = indexedDB.open('gestpro-prefs', 1);
    r.onupgradeneeded = e => e.target.result.createObjectStore('prefs');
    r.onsuccess = e => res(e.target.result);
    r.onerror   = e => rej(e.target.error);
  });
}
async function _idbGet(key) {
  const db = await _idbOpen();
  return new Promise((res, rej) => {
    const req = db.transaction('prefs','readonly').objectStore('prefs').get(key);
    req.onsuccess = () => res(req.result);
    req.onerror   = () => rej(req.error);
  });
}
async function _idbSet(key, val) {
  const db = await _idbOpen();
  return new Promise((res, rej) => {
    const req = db.transaction('prefs','readwrite').objectStore('prefs').put(val, key);
    req.onsuccess = () => res();
    req.onerror   = () => rej(req.error);
  });
}

async function _getRespaldoDir() {
  let handle = await _idbGet('respaldo-dir-handle');
  if (handle) {
    try {
      let perm = await handle.queryPermission({ mode: 'readwrite' });
      if (perm !== 'granted') perm = await handle.requestPermission({ mode: 'readwrite' });
      if (perm === 'granted') return handle;
    } catch(e) { /* handle inválido, pedir de nuevo */ }
  }
  // Primera vez: pedir al usuario que seleccione la carpeta
  handle = await window.showDirectoryPicker({ mode: 'readwrite', startIn: 'documents' });
  await _idbSet('respaldo-dir-handle', handle);
  return handle;
}

async function descargarRespaldoNube() {
  try {
    // 1. Serializar los datos en memoria (siempre actualizados via Firestore)
    const exportData = {
      _exportedAt: new Date().toISOString(),
      _version: 1,
      clientes:            (db.clientes            || []),
      ventas:              (db.ventas              || []),
      cotizaciones:        (db.cotizaciones        || []),
      consignacion:        (db.consignacion        || []),
      materia:             (db.materia             || []),
      productos:           (db.productos           || []),
      cajas:               (db.cajas               || []),
      facturas:            (db.facturas            || []),
      vehiculos:           (db.vehiculos           || []),
      users:               (db.users               || []),
      catalogoMateriales:  (db.catalogoMateriales  || []),
      entregas:            (db.entregas            || []),
      reparaciones:        (db.reparaciones        || []),
      produccion:          (db.produccion          || []),
      bodegas:             (db.bodegas             || []),
      cobranza:            (db.cobranza            || []),
      clientesCredito:     (db.clientesCredito     || []),
    };
    const json = JSON.stringify(exportData, null, 2);
    const blob = new Blob([json], { type: 'application/json' });

    // 2. Obtener carpeta destino (guarda la selección para la próxima vez)
    const dir = await _getRespaldoDir();

    // 3. Guardar gestpro-latest.json (sobrescribe) + copia con fecha
    const fecha = new Date().toISOString().slice(0,16).replace('T','_').replace(/:/g,'-');
    for (const name of ['gestpro-latest.json', `gestpro-${fecha}.json`]) {
      const fh = await dir.getFileHandle(name, { create: true });
      const wr = await fh.createWritable();
      await wr.write(blob);
      await wr.close();
    }

    _info('✅ Respaldo guardado en tu carpeta local.');
  } catch(e) {
    if (e.name === 'AbortError') return; // usuario canceló el selector
    _info('❌ Error: ' + e.message);
  }
}
window['descargarRespaldoNube'] = descargarRespaldoNube;

