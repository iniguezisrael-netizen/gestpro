      const foto=mat&&mat.fotos&&mat.fotos[0]
        ?'<img src="'+esc(mat.fotos[0])+'" style="width:36px;height:36px;object-fit:cover;border-radius:6px;border:1px solid var(--border);flex-shrink:0">'
