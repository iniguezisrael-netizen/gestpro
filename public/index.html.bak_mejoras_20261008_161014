// Pool de IDs pre-reservados atómicamente — evita colisiones entre sesiones concurrentes sin hacer sid() async
let _idPool = [];
let _idPoolRefilling = false;
let _idPoolMax = 0; // mayor ID reservado para esta sesión

async function _refillIdPool(count) {
  count = count || 200;
  if (_idPoolRefilling || !firestore) return;
  _idPoolRefilling = true;
  try {
    const ref = firestore.collection('_meta').doc('nextid');
    let startId;
    await firestore.runTransaction(async (tx) => {
      const doc = await tx.get(ref);
      const serverVal = doc.exists ? (doc.data().val || 100) : 100;
      const base = Math.max(serverVal, nextId, _idPoolMax);
      startId = base + 1;
      tx.set(ref, { val: base + count });
    });
    for (let i = 0; i < count; i++) _idPool.push(startId + i);
    _idPoolMax = startId + count - 1;
    console.log('[sid-pool] Pool llenado: IDs', startId, '-', _idPoolMax);
  } catch(e) {
    console.warn('[sid-pool] Error llenando pool:', e);
  }
  _idPoolRefilling = false;
}

