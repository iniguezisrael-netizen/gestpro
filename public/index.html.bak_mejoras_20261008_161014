    <td style="white-space:nowrap;text-align:right">${vt.total!=null?(()=>{const _s=vt.saldo!=null?vt.saldo:vt.total;const _col=_s>0?'#991B1B':'#065F46';return`<span style="font-weight:600;color:${_col}">$${fmt(_s)}</span>`;})():'<span style="color:#cbd5e1">—</span>'}</td>
    <td>${vt.estado === 'Entregado'
