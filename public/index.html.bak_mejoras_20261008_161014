function _posponerRec(id, tipo) {
  const prefix = tipo === 'cotizacion' ? '_rec-snz-cot-' : '_rec-snz-cob-';
  const selEl = document.getElementById(prefix + id);
  if (!selEl) return;
  const val = selEl.value;
  if (val === 'fecha') {
    if (tipo === 'cotizacion') editarRecordatorio(id);
    else editarCobranzaRecordatorio(id);
    return;
  }
  const dias = parseInt(val);
  if (isNaN(dias)) return;
  const d = new Date(); d.setDate(d.getDate() + dias);
  const fechaStr = d.toISOString().slice(0, 10);
  if (tipo === 'cotizacion') {
    const c = findById(db.cotizaciones, id);
    if (!c) return;
    c.recFecha = fechaStr; c.recSnoozeHasta = null;
    saveDb('cotizaciones');
  } else {
    const c = (db.cobranza||[]).find(x => x.id === id);
    if (!c) return;
    c.recFecha = fechaStr;
    saveDb('cobranza');
  }
  renderDashboard();
}
