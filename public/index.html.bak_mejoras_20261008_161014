        // Borde exterior tabla
        doc.setDrawColor(45,55,72); doc.setLineWidth(0.25);
        doc.rect(M, bodyY-tblRowH*_czItems.length-tblHdrH, descColW, tblHdrH+tblRowH*_czItems.length);
      }

      // ── Fotos (columna derecha) ──
      if (_fotosArr.length) {
        doc.setFillColor(245,245,245); doc.rect(M+descColW,y+dhH,fotoColW,dbH,'F');
        const fxBase=M+descColW+fotoPad, fyBase=y+dhH+fotoPad;
        _fotosArr.slice(0,4).forEach((b64,i)=>{
          const col=i%fotoNCols, row=Math.floor(i/fotoNCols);
          const fyOffset=_rowHeights.slice(0,row).reduce((a,b)=>a+b+fotoGap,0);
          const fx=fxBase+col*(fotoW2+fotoGap), fy=fyBase+fyOffset;
          const fh=Math.round(fotoW2*(_ratios[i]||0.75));
          const _fmt=b64.startsWith('data:image/png')?'PNG':b64.startsWith('data:image/webp')?'WEBP':'JPEG';
          try{doc.addImage(b64,'JPEG',fx,fy,fotoW2,fh,'foto'+i,'FAST');}catch(e){console.warn('addImage err:',e);}
        });
      }

      // ── TOTAL + BANCO ──
      let totalBlockY = y + dhH + textH + 3;
      // Si hay IVA, mostrar desglose antes del total
      if (c.ivaMode === 'mas' && c.ivaAmount > 0) {
        const desgH = 5.5;
        doc.setFillColor(245,250,245); doc.rect(M, totalBlockY, tW, desgH*2, 'F');
        doc.setDrawColor(200,200,200); doc.setLineWidth(0.15);
        doc.rect(M, totalBlockY, tW, desgH*2);
        doc.line(M, totalBlockY+desgH, M+tW, totalBlockY+desgH);
        doc.setFont('helvetica','normal'); doc.setFontSize(7); doc.setTextColor(60,60,60);
        doc.text('Subtotal', M+3, totalBlockY+4);
        doc.setFont('helvetica','bold');
        doc.text('$'+fmt(c.subtotal||c.total-c.ivaAmount), M+tW-3, totalBlockY+4, {align:'right'});
        doc.setFont('helvetica','normal');
        doc.text('IVA (16%)', M+3, totalBlockY+desgH+4);
