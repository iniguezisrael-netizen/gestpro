  admin:     ['ventas'], // ventas inmediato (hub de deps cruzadas); resto lazy por _PAGE_EXTRA_COLS
  checador:  ['checadas','checadorConfig']
};

async function _procesarColecciones(cols, results) {
  const pendingUploads = [];
  cols.forEach((c, i) => {
    if (results[i] !== null) {
      // FS_ARRAY_COLS: items son strings, no objetos con .id — procesado directo
      if (FS_ARRAY_COLS.includes(c)) {
        db[c] = results[i];
        save('gp_' + c, db[c]);
        return;
      }
      // Filtrar tombstones: items borrados localmente no deben volver desde Firestore
      const _colTombstonesPC = _fsTombstones[c] || {};
      const serverItems = results[i].filter(x => x && x.id != null && !_colTombstonesPC[String(x.id)]);
      // Re-borrar de Firestore cualquier item que siga ahí con tombstone
      if (FIREBASE_ENABLED && firestore) {
        results[i].filter(x => x && x.id != null && _colTombstonesPC[String(x.id)]).forEach(x => {
          firestore.collection(c).doc(String(x.id)).delete().catch(e => console.warn('[tombstone] redelete error', c, x.id, e));
        });
      }
      const localItems = db[c] || [];
      // Baja overrides: si local dice baja:true pero Firestore no, respetar local y reparchear
      const _localById = {};
      localItems.forEach(x => { if (x && x.id != null) _localById[String(x.id)] = x; });
      const serverItemsMerged = serverItems.map(x => {
        const _loc = _localById[String(x.id)];
        if (_loc?.baja === true && !x.baja) {
          if (FIREBASE_ENABLED && firestore) {
            const _bf = { baja: true };
            if (_loc.bajaFecha) _bf.bajaFecha = _loc.bajaFecha;
            if (_loc.bajaMotivo) _bf.bajaMotivo = _loc.bajaMotivo;
            if (_loc.bajaUsuario) _bf.bajaUsuario = _loc.bajaUsuario;
            firestore.collection(c).doc(String(x.id)).update(_bf)
              .catch(e => console.warn('[baja override] re-patch', c, x.id, e));
          }
          return { ...x, baja: true, bajaFecha: _loc.bajaFecha, bajaMotivo: _loc.bajaMotivo, bajaUsuario: _loc.bajaUsuario };
        }
        return x;
      });
      const serverIds = new Set(serverItemsMerged.map(x => x && x.id).filter(Boolean));
      const soloLocales = localItems.filter(x => x && x.id && !serverIds.has(x.id) && !_colTombstonesPC[String(x.id)]);
      if (soloLocales.length > 0) {
        db[c] = [...serverItemsMerged, ...soloLocales];
        pendingUploads.push(c);
      } else {
        db[c] = serverItemsMerged;
      }
      save('gp_' + c, db[c]);
      if (!FS_ARRAY_COLS.includes(c)) {
        _firestoreKnownIds[c] = new Set((db[c] || []).map(x => String(x.id)));
      }
    }
  });
  if (pendingUploads.length > 0) {
    await Promise.all(pendingUploads.map(c => fsWriteCollection(c, db[c])));
  }
}

// Cargar tombstones desde Firestore y mezclar con los locales
async function _loadTombstonesFirestore() {
  if (!FIREBASE_ENABLED || !firestore) return;
  try {
    // Caché primero: los tombstones cambian poco, evitar lectura de servidor en cada login
    let doc;
    try { doc = await firestore.collection('_meta').doc('tombstones').get({ source: 'cache' }); } catch(_) {}
    if (!doc || !doc.exists) doc = await firestore.collection('_meta').doc('tombstones').get();
    if (!doc.exists) return;
    const data = doc.data() || {};
    let changed = false;
    Object.keys(data).forEach(col => {
      const colData = data[col];
      if (!colData || typeof colData !== 'object') return;
      if (!_fsTombstones[col]) _fsTombstones[col] = {};
      Object.keys(colData).forEach(id => {
        if (!_fsTombstones[col][id]) {
          const raw = colData[id];
          _fsTombstones[col][id] = (raw && typeof raw.toMillis === 'function') ? raw.toMillis() : (typeof raw === 'number' ? raw : Date.now());
          changed = true;
        }
      });
    });
    if (changed) try { localStorage.setItem(_FS_TOMBSTONES_KEY, JSON.stringify(_fsTombstones)); } catch(e) {}
  } catch(e) { console.warn('[tombstone] carga desde FS error:', e); }
}

// Cargar todos los datos desde Firestore al iniciar sesión
async function loadFromFirebase() {
  if (!FIREBASE_ENABLED || !firestore) return;
  setSyncStatus('syncing');
  try {
    // Primero cargar tombstones remotos para que el filtrado sea correcto en todos los dispositivos
    await _loadTombstonesFirestore();
    const rol = session && session.rol;
    const priority = (_FS_PRIORITY[rol] || []).filter(c => FS_COLLECTIONS.includes(c));
    const rest = priority.length ? FS_COLLECTIONS.filter(c => !priority.includes(c)) : [];
    const phase1 = priority.length ? priority : FS_COLLECTIONS;
    // Cambio 2: excluir cols con listener activo — su primer snapshot las carga, evita doble lectura al servidor
    const _listenerCols = new Set(priority);
    const phase1Load = phase1.filter(c => !_listenerCols.has(c));
    const restLoad   = rest.filter(c => !_listenerCols.has(c));

    // Fase 1: colecciones prioritarias sin listener activo (rápido)
    if (phase1Load.length) {
      const res1 = await Promise.all(phase1Load.map(c => fsReadCollection(c)));
      await _procesarColecciones(phase1Load, res1);
    }

    // Marcar como lista y refrescar UI con datos del rol ya disponibles
    _appReady = true;
    setSyncStatus('ok');
    // Migración: enlazar ventas sin cajaSesion a la caja abierta correspondiente
    setTimeout(() => _migrarVentasSinCaja(), 800);
    if (currentPage) renderPage(currentPage);
    if (session && session.rol === 'admin') _iniciarRespaldoAutomatico();
    // Disparar recordatorios en cuanto los datos están disponibles
    setTimeout(() => window._checkRecordatorios && window._checkRecordatorios(), 1500);

    // Fase 2: resto de colecciones en background sin listener activo (no bloquea UI)
    if (restLoad.length) {
      const res2 = await Promise.all(restLoad.map(c => fsReadCollection(c)));
      await _procesarColecciones(restLoad, res2);
    }

    const remoteNextId = await fsReadNextId();
    if (remoteNextId !== null && remoteNextId > nextId) {
      nextId = remoteNextId;
      save('gp_nextid', nextId);
    }
    _refillIdPool().catch(() => {});

    // Fotos offline pendientes
    const hayFotosBase64 = _COLS_CON_FOTOS.some(col =>
      (db[col] || []).some(item => (item.fotos || []).some(f => f && f.startsWith('data:')))
    );
    if (hayFotosBase64) await sincronizarFotosPendientes();

    console.log('Datos cargados desde Firebase ✓');
  } catch(e) {
    _appReady = true;
    console.error('Error cargando Firebase:', e);
    setSyncStatus('error');
    if (session && session.rol === 'admin') _iniciarRespaldoAutomatico();
  }
}

// ── RESPALDO AUTOMÁTICO CADA 6 HORAS ──
let _respaldoTimer = null;
function _iniciarRespaldoAutomatico() {
  if (_respaldoTimer) return; // ya corriendo
  const INTERVALO = 1 * 60 * 60 * 1000; // 1 hora en ms

  async function _hacerRespaldo() {
    try {
      const FS_COL_KEYS = ['materia','productos','consignacion','ventas','cotizaciones',
        'cajas','reparaciones','produccion','catalogoMateriales','cobranza','clientesCredito',
        'clientes','bodegas','entregas','facturas','vehiculos','herramientas','herramientasAsignadas','herramientasHistorial',
        'ordenesCompra','proveedores','checadas','checadorConfig','entregaInsumos','reportesEntrega','reportesProduccion','agenda'];
      const exportData = {};
      FS_COL_KEYS.forEach(k => { exportData[k] = db[k] || []; });
      exportData._exportadoEn = new Date().toISOString();
      const json = JSON.stringify(exportData);

      // Descarga local (al equipo del admin)
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      const ts = new Date().toISOString().slice(0,16).replace('T','_').replace(':','-');
      a.download = `gestpro-backup-${ts}.json`;
      a.click();
      URL.revokeObjectURL(url);
      console.log('[AutoBackup] Respaldo local generado:', a.download);
      // Nota: el backup en nube lo maneja la Cloud Function dailyBackup (una vez al día).
      // latest.json se actualiza en cada cambio vía _ejecutarRespaldo().
    } catch(e) { console.error('[AutoBackup] Error:', e); }
  }

  // Primera vez: a los 5 minutos de cargar (no molestar al inicio)
  setTimeout(() => {
    _hacerRespaldo();
    _respaldoTimer = setInterval(_hacerRespaldo, INTERVALO);
  }, 5 * 60 * 1000);
  console.log('[AutoBackup] Respaldo automático activado — cada hora');
}

// Listener en tiempo real — escucha cambios en documentos individuales {col}/{id}
// El primer snapshot carga el estado completo; los siguientes solo los cambios.
const _syncInitialized = {}; // colName → bool (primer snapshot ya procesado)
let _syncRenderTimer = null; // debounce para no re-renderizar en cada doc individual

// ── Lazy loading: inicia el listener de UNA colección ──────────────────────
function _startSingleCollectionListener(colName) {
  if (_listenersStarted.has(colName)) return; // ya activo
  if (!FIREBASE_ENABLED || !firestore) return;
  _listenersStarted.add(colName);
  _syncInitialized[colName] = false;

  // ── Colecciones estáticas: una sola lectura, sin listener permanente ────────
  if (FS_STATIC_COLS.includes(colName)) {
    firestore.collection(colName).get({ source: 'cache' }).then(snap => {
      if (snap.empty) return firestore.collection(colName).get();
      return snap;
    }).catch(() => firestore.collection(colName).get()).then(snap => {
      const items = snap.docs
        .filter(d => !d.id.startsWith('_'))
        .map(d => d.data())
        .filter(d => d && d.id != null);
      if (items.length) {
        db[colName] = items;
        save('gp_' + colName, db[colName]);
      }
      _syncInitialized[colName] = true;
    }).catch(err => {
      console.warn('[static] Error leyendo', colName, err);
      _listenersStarted.delete(colName);
    });
    return; // sin listener permanente, sin unsub que registrar
  }

  let unsub;

  if (FS_ARRAY_COLS.includes(colName)) {
    // ── Colecciones grandes: escuchar {col}/data (formato array, 1 doc) ──────
    unsub = firestore.collection(colName).doc('data').onSnapshot(snap => {
      if (!snap.exists) return;
      // Ignorar si es escritura propia (pendiente o dentro del guard de esta colección)
      if (snap.metadata.hasPendingWrites) return;
      if (Date.now() < (window._ownWriteUntilByCol?.[colName] || window._ownWriteUntil || 0)) return;
      const remote = snap.data();
      db[colName] = remote.items || [];
      save('gp_' + colName, db[colName]);
      const maxRemoteId = Math.max(0, ...db[colName].map(x => (typeof x.id === 'number' ? x.id : 0)));
      if (maxRemoteId >= nextId) { nextId = maxRemoteId + 1; save('gp_nextid', nextId); }
      clearTimeout(_syncRenderTimer);
      _syncRenderTimer = setTimeout(() => { if (currentPage) renderPage(currentPage); }, _RENDER_DEBOUNCE);
    }, err => { console.warn('Sync listener error:', colName, err); });

  } else {
    // ── Resto: escuchar colección entera, actualizaciones incrementales ──────
    unsub = firestore.collection(colName).onSnapshot(snapshot => {
      if (!_syncInitialized[colName]) {
        // Primer snapshot: cargar estado completo (siempre se procesa, es la carga inicial)
        _syncInitialized[colName] = true;
        const _colTombstonesInit = colName === 'consignacion' ? (_fsTombstones['consignacion'] || {}) : {};
        // Si un item de consignacion eliminado sigue en Firestore, volver a borrarlo
        if (colName === 'consignacion') {
          snapshot.docs.filter(d => _colTombstonesInit[d.id]).forEach(d => {
            if (FIREBASE_ENABLED && firestore) firestore.collection(colName).doc(d.id).delete().catch(() => {});
          });
        }
        const items = snapshot.docs
          .filter(d => !d.id.startsWith('_') && !_colTombstonesInit[d.id])
          .map(d => d.data())
          .filter(d => d && d.id != null);
        // Preservar items capturados offline que solo existen en localStorage.
        // Esto ocurre cuando:
        //   a) El snapshot viene del servidor (fromCache=false) y aún no incluyó las escrituras offline.
        //   b) El snapshot viene del caché IndexedDB (fromCache=true) pero sin las escrituras offline
        //      porque la pestaña secundaria no obtuvo el lock de persistencia IndexedDB.
        // En ambos casos, rescatamos los items que están en localStorage pero no en el snapshot.
        let merged = items;
        {
          const serverIds = new Set(items.map(x => String(x.id)));
          const colTombstones = _fsTombstones[colName] || {};
          const localOnly = (db[colName] || []).filter(x => x.id != null && !serverIds.has(String(x.id)) && !colTombstones[String(x.id)]);
          // Para items que existen en ambos lados: si local tiene fotos y servidor no, conservar fotos locales
          const localById = {};
          (db[colName] || []).forEach(x => { if (x.id != null) localById[String(x.id)] = x; });
          const mergedItems = items.map(srvItem => {
            const localItem = localById[String(srvItem.id)];
            let result = srvItem;
            if (localItem && localItem.fotos && localItem.fotos.length && (!result.fotos || !result.fotos.length)) {
              result = { ...result, fotos: localItem.fotos };
            }
            // Sticky recHecho: si está descartado en localStorage, no revertir aunque Firestore traiga recHecho:false
            if (localItem && localItem.recHecho === true && !result.recHecho) {
              result = { ...result, recHecho: true };
              if ((localItem.recSnoozeHasta || 0) > (result.recSnoozeHasta || 0)) result = { ...result, recSnoozeHasta: localItem.recSnoozeHasta };
            }
            return result;
          });
          const needsFotoSync = mergedItems.some((m, i) => m !== items[i]);
          if (localOnly.length) {
            merged = [...mergedItems, ...localOnly];
          } else {
            merged = mergedItems;
          }
          // Solo sincronizar items que existen ÚNICAMENTE en local (creados offline).
          // NO hacer saveDb por needsFotoSync: eso puede traer datos stale del caché de Firestore
          // y sobreescribir cambios recientes de otros dispositivos (ej: cantidad actualizada en tableta).
          if (localOnly.length) {
            setTimeout(() => {
              window._serverSnapshot = window._serverSnapshot || {};
              window._serverSnapshot[colName] = window._serverSnapshot[colName] || {};
              localOnly.forEach(x => {
                delete window._serverSnapshot[colName][String(x.id)];
              });
              saveDb([colName]);
              if (typeof showToast === 'function') {
                showToast(`✅ ${localOnly.length} registro(s) offline sincronizado(s)`);
              }
            }, 800);
          }
        }
        db[colName] = merged;
        _firestoreKnownIds[colName] = new Set(merged.map(x => String(x.id)));
        _saveKnownIds();
        save('gp_' + colName, db[colName]);
        // Guardar snapshot del servidor para calcular deltas al guardar inventario
        window._serverSnapshot = window._serverSnapshot || {};
        window._serverSnapshot[colName] = {};
        items.forEach(item => {
          if (item.id != null) window._serverSnapshot[colName][String(item.id)] = JSON.parse(JSON.stringify(item));
        });
      } else {
        // Snapshots posteriores: ignorar si es escritura propia de esta colección
        if (Date.now() < (window._ownWriteUntilByCol?.[colName] || window._ownWriteUntil || 0)) return;
        snapshot.docChanges().forEach(change => {
          if (change.doc.id.startsWith('_')) return;
          if (change.doc.metadata.hasPendingWrites) return; // escritura propia aún pendiente
          const data = change.doc.data();
          if (change.type === 'added' || change.type === 'modified') {
            // Si este ID tiene tombstone en consignacion, ignorarlo y re-borrarlo de Firestore
            if (colName === 'consignacion') {
              const _colTombstonesChange = _fsTombstones['consignacion'] || {};
              if (_colTombstonesChange[String(data.id)]) {
                if (FIREBASE_ENABLED && firestore) {
                  firestore.collection(colName).doc(String(data.id)).delete().catch(() => {});
                }
                return;
              }
            }
            const arr = db[colName] || [];
            const idx = arr.findIndex(x => String(x.id) === String(data.id));
            let finalData = data;
            // Fusionar arrays anidados con ID para TODAS las colecciones:
            // Si el servidor tiene una versión más nueva pero local tiene elementos
            // en arrays que el servidor no tiene, los conservamos.
            if (idx >= 0) {
              const localItem = arr[idx];
              let merged = { ...data };
              for (const key of Object.keys(localItem)) {
                const lArr = localItem[key];
                const rArr = data[key];
                if (!Array.isArray(lArr) || !Array.isArray(rArr)) continue;
                const remoteIds = new Set(rArr.map(x => x?.id).filter(Boolean));
                if (!remoteIds.size && !lArr.some(x => x?.id)) continue;
                const extra = lArr.filter(x => x?.id && !remoteIds.has(x.id));
                // Para movimientos: si el servidor tiene el item pero sin fecha, tomar la fecha local
                let baseArr = rArr;
                if (key === 'movimientos') {
                  const lById = new Map(lArr.filter(x => x?.id && x.fecha).map(x => [x.id, x.fecha]));
                  if (lById.size) {
                    const fixed = rArr.map(m => (m?.id && !m.fecha && lById.has(m.id)) ? { ...m, fecha: lById.get(m.id) } : m);
                    if (fixed.some((m, i) => m !== rArr[i])) baseArr = fixed;
                  }
                }
                if (extra.length) merged[key] = [...baseArr, ...extra];
                else if (baseArr !== rArr) merged[key] = baseArr;
              }
              // Fotos: si el servidor no tiene fotos pero local sí, conservar las locales
              // Esto protege contra el caso donde el write a Firestore falló (sin fotos en servidor)
              if (localItem.fotos && localItem.fotos.length && (!merged.fotos || !merged.fotos.length)) {
                merged.fotos = localItem.fotos;
                // Re-intentar subir a Firestore con las fotos locales
                setTimeout(() => { if (db[colName]) saveDb([colName]); }, 800);
              }
              // Sticky recHecho: si está descartado localmente, no revertir aunque Firestore mande recHecho:false
              if (localItem.recHecho === true && !merged.recHecho) {
                merged.recHecho = true;
                if ((localItem.recSnoozeHasta || 0) > (merged.recSnoozeHasta || 0)) merged.recSnoozeHasta = localItem.recSnoozeHasta;
              }
              finalData = merged;
            }
            if (idx >= 0) { arr[idx] = finalData; } else {
              arr.push(finalData);
              if (!_firestoreKnownIds[colName]) _firestoreKnownIds[colName] = new Set();
              _firestoreKnownIds[colName].add(String(data.id));
              _saveKnownIds();
            }
            // Actualizar snapshot del servidor con los datos externos más recientes
            window._serverSnapshot = window._serverSnapshot || {};
            window._serverSnapshot[colName] = window._serverSnapshot[colName] || {};
            try { window._serverSnapshot[colName][String(data.id)] = JSON.parse(JSON.stringify(finalData)); } catch(e) {}
            db[colName] = arr;
            // Toast si otra sesión modificó el item que tienes abierto
            const modalAbierto = document.getElementById('modal-overlay')?.classList.contains('open');
            if (modalAbierto && _modalEditingCol === colName && _modalEditingId && String(_modalEditingId) === String(data.id)) {
              _mostrarToastSync();
            }
          } else if (change.type === 'removed') {
            db[colName] = (db[colName] || []).filter(x => String(x.id) !== String(data.id));
            if (_firestoreKnownIds[colName]) _firestoreKnownIds[colName].delete(String(data.id));
          }
        });
        const maxRemoteId = Math.max(0, ...(db[colName] || []).map(x => (typeof x.id === 'number' ? x.id : 0)));
        if (maxRemoteId >= nextId) { nextId = maxRemoteId + 1; save('gp_nextid', nextId); }
        save('gp_' + colName, db[colName]);
      }
      clearTimeout(_syncRenderTimer);
      _syncRenderTimer = setTimeout(() => { if (currentPage) renderPage(currentPage); }, _RENDER_DEBOUNCE);
      if (colName === 'cotizaciones') { clearTimeout(window._recCheckTimer); window._recCheckTimer = setTimeout(() => window._checkRecordatorios && window._checkRecordatorios(), (_RENDER_DEBOUNCE||400)+200); }
    }, err => { console.warn('Sync listener error:', colName, err); });
  }

  _syncUnsubscribers.push(unsub);
}

function startRealtimeSync() {
  if (!FIREBASE_ENABLED || !firestore) return;
  // Desuscribir listeners anteriores
  _syncUnsubscribers.forEach(u => u());
  _syncUnsubscribers = [];
  _listenersStarted.clear();

  // Iniciar solo colecciones relevantes al rol (ahorro de listeners para roles limitados).
  // Admin usa FS_CRITICAL_COLS completo; checador solo sus 2 colecciones, etc.
  const _rol = session && session.rol;
  const _rolCols = (_FS_PRIORITY[_rol] && _FS_PRIORITY[_rol].length)
    ? _FS_PRIORITY[_rol]
    : FS_CRITICAL_COLS;
  _rolCols.forEach(colName => {
    _startSingleCollectionListener(colName);
  });
  console.log('Sync en tiempo real activo ✓ (' + _rolCols.length + ' cols para rol: ' + _rol + ')');
}

