let _ocItems = [];
function _ocMonedaChange() {
  const moneda = document.querySelector('input[name="oc-moneda"]:checked')?.value || 'MXN';
  const wrap = document.getElementById('oc-tc-wrap');
  if (wrap) wrap.style.display = moneda === 'USD' ? 'flex' : 'none';
  _ocUpdateTotal();
}
function _ocUpdateTotal() {
  const total = _ocItems.reduce((s,i) => s + (Number(i.cantidad||0) * Number(i.precioUnitario||0)), 0);
  const moneda = document.querySelector('input[name="oc-moneda"]:checked')?.value || 'MXN';
  const tc = moneda === 'USD' ? Number(document.getElementById('oc-tc')?.value||0) : 0;
  const el = document.getElementById('oc-total-preview');
  if (!el) return;
  const sym = moneda === 'USD' ? 'USD $' : '$';
  let txt = sym + fmt(total);
  if (moneda === 'USD' && tc > 0) txt += ` <span style="font-size:0.8rem;color:#94a3b8;font-weight:400">(≈ $${fmt(total*tc)} MXN)</span>`;
  el.innerHTML = txt;
}
function _ocAddItem() {
  const desc = (document.getElementById('oc-item-desc')?.value||'').trim();
  const cant = Number(document.getElementById('oc-item-cant')?.value||0);
  const precio = Number(document.getElementById('oc-item-precio')?.value||0);
  if (!desc) { _info('Escribe la descripción del artículo.'); return; }
  if (!cant) { _info('Escribe la cantidad.'); return; }
  _ocItems.push({ descripcion: desc, cantidad: cant, precioUnitario: precio });
  document.getElementById('oc-item-desc').value = '';
  document.getElementById('oc-item-cant').value = '';
  document.getElementById('oc-item-precio').value = '';
  _ocRenderItems();
}
function _ocRemoveItem(idx) {
  _ocItems.splice(idx, 1);
  _ocRenderItems();
}
function _ocRenderItems() {
  const cont = document.getElementById('oc-items-list');
  if (!cont) return;
  _ocUpdateTotal();
  if (!_ocItems.length) { cont.innerHTML = '<p style="color:#94a3b8;font-size:0.85rem;text-align:center;padding:8px">Sin artículos agregados.</p>'; return; }
  const _sym = (document.querySelector('input[name="oc-moneda"]:checked')?.value||'MXN') === 'USD' ? 'USD $' : '$';
  cont.innerHTML = `<table style="width:100%;font-size:0.85rem;border-collapse:collapse">
    <tr style="font-size:0.75rem;color:#64748b"><th style="text-align:left;padding:3px 4px">Descripción</th><th style="text-align:right;padding:3px 4px">Cant.</th><th style="text-align:right;padding:3px 4px">P.U.</th><th style="text-align:right;padding:3px 4px">Subtotal</th><th></th></tr>
    ${_ocItems.map((i,idx) => `<tr>
      <td style="padding:4px">${esc(i.descripcion)}</td>
      <td style="text-align:right;padding:4px">${i.cantidad}</td>
      <td style="text-align:right;padding:4px">${_sym}${fmt(i.precioUnitario)}</td>
      <td style="text-align:right;padding:4px;font-weight:600">${_sym}${fmt(i.cantidad*i.precioUnitario)}</td>
      <td style="padding:4px"><button class="btn btn-danger btn-sm" style="padding:2px 6px" onclick="_ocRemoveItem(${idx})">✕</button></td>
    </tr>`).join('')}
  </table>`;
}

function _ocToggleDatos() {
  const body = document.getElementById('oc-datos-body');
  const arr  = document.getElementById('oc-datos-arr');
  if (!body) return;
  const open = body.style.display !== 'none';
  body.style.display = open ? 'none' : '';
  if (arr) arr.textContent = open ? '▶' : '▼';
}

function _ocAutoFillProv() {
  const empresa = (document.getElementById('oc-proveedor')?.value||'').trim();
  if (!empresa) return;
  const prov = (db.proveedores||[]).find(p => (p.nombre||'').toLowerCase() === empresa.toLowerCase());
  if (!prov) return;
  const map = {
    'oc-pv-nombre':   prov.provNombre,
    'oc-pv-apellido': prov.provApellido,
    'oc-pv-ciudad':   prov.provCiudad,
    'oc-pv-estado':   prov.provEstado,
    'oc-pv-tel':      prov.provTelFijo,
    'oc-pv-wa':       prov.provWhatsApp || prov.whatsapp,
    'oc-pv-correo':   prov.provCorreo   || prov.correo,
    'oc-pv-dir':      prov.provDireccion,
    'oc-pv-colonia':  prov.provColonia,
    'oc-pv-cp':       prov.provCP,
    'oc-pv-rfc':      prov.provRFC,
  };
  Object.entries(map).forEach(([id, val]) => { const el=document.getElementById(id); if(el&&val) el.value=val; });
  const body = document.getElementById('oc-datos-body');
  const arr  = document.getElementById('oc-datos-arr');
  if (body && Object.values(map).some(v=>v)) { body.style.display=''; if(arr) arr.textContent='▼'; }
}

