<script>
// Auto-restaurar sesión al abrir con ?codigo= o ?consig= en la URL (ej: escaneo de QR ya logueado)
document.addEventListener('DOMContentLoaded', function() {
  try {
    var _qsCodigo = new URLSearchParams(window.location.search).get('codigo');
    var _qsConsig = new URLSearchParams(window.location.search).get('consig');
    if (!_qsCodigo && !_qsConsig) return;
    var _saved = JSON.parse(sessionStorage.getItem('_qs') || 'null');
    if (!_saved || !['admin','secretaria','auxiliar'].includes(_saved.rol)) return;
    if (!_saved.exp || Date.now() > _saved.exp) { try { sessionStorage.removeItem('_qs'); } catch(e) {} return; }
    try { sessionStorage.removeItem('_qs'); } catch(e) {} // usar una sola vez
    // Restaurar sesión y mostrar app sin pasar por el login
    session = Object.freeze(_saved);
    var _loginEl = document.getElementById('login-screen');
    if (_loginEl) _loginEl.style.display = 'none';
    loadFromFirebase().catch(function(){}).then(function() {
      startRealtimeSync();
      if (_qsCodigo && window._mostrarFichaQR) window._mostrarFichaQR();
      else if (_qsConsig && window._mostrarFichaConsig) window._mostrarFichaConsig();
    });
  } catch(_e) { console.error('QR auto-restore:', _e); }
});
</script>
