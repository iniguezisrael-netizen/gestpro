        while (sfs > 6.5 && doc.getTextWidth(valStr) > fW - 5) { sfs -= 0.5; doc.setFontSize(sfs); }
        doc.text(valStr, fx+2, y+shH+9.5);
      });
      y += shH+specH+4;

      // ── DESCRIPCIÓN + FOTOS (lado a lado: 2/3 desc | 1/3 fotos 2×2) ──
      const _fotosArr = fotosB64 && fotosB64.length ? fotosB64 : [];
      const descColW = _fotosArr.length ? Math.round(cW*3/5) : cW;
      const fotoColW = cW - descColW;

      // ── Helper: dimensiones reales de imagen desde bytes del header (síncrono) ──
      function _getB64Dims(b64) {
        try {
          const raw = atob(b64.replace(/^data:image\/[^;]+;base64,/,''));
          const b = s => raw.charCodeAt(s) & 0xFF;
          if (b(1)===80&&b(2)===78&&b(3)===71) // PNG
            return {w:(b(16)<<24)|(b(17)<<16)|(b(18)<<8)|b(19),h:(b(20)<<24)|(b(21)<<16)|(b(22)<<8)|b(23)};
          if (b(0)===0xFF&&b(1)===0xD8) { // JPEG — buscar marcador SOF
            let i=2;
            while(i<raw.length-4){
              if(b(i)!==0xFF) break;
              const mk=b(i+1);
              if(mk>=0xC0&&mk<=0xC3&&mk!==0xC4) return {w:(b(i+7)<<8)|b(i+8),h:(b(i+5)<<8)|b(i+6)};
              i+=2+((b(i+2)<<8)|b(i+3));
            }
          }
        } catch(e){}
        return null;
      }
      function _fotoRatio(b64) {
        const d = _getB64Dims(b64);
        return (d && d.w && d.h) ? d.h/d.w : 0.75;
      }

      const dhH=8;
      const fotoPad=3, fotoGap=2;
      const fotoNCols = (_fotosArr.length >= 3) ? 2 : 1;
