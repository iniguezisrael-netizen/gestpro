            window._serverSnapshot.ventas[String(id)].archivadoEn = now;
          }
          // Guardar local inmediatamente
          save('gp_ventas', db.ventas);
          // PATCH en Firestore (update solo modifica los campos indicados)
          if (firestore) {
            firestore.collection('ventas').doc(String(id))
              .update({ archivado: true, archivadoPor: vt.archivadoPor, archivadoEn: now })
              .catch(e => console.error('[archivar] FS error:', e));
          }
          // Auto-archivar cobranza vinculada si existe y saldo = 0
          const cobVinculada = (db.cobranza||[]).filter(c => c.ventaId === id && !c.archivado);
          if (cobVinculada.length) {
