function _invSearch(input, tipo) {
  if (!window._invSearchVal) window._invSearchVal = {};
  window._invSearchVal[tipo] = input.value;
  clearTimeout(window._invSearchTimers[tipo]);
  const val = input.value;
  window._invSearchTimers[tipo] = setTimeout(() => {
    const words = _normSearch(val).split(' ').filter(Boolean);
    const tabla = document.getElementById('tbl-' + tipo);
    const pgEl = document.getElementById('inv-pg-' + tipo);
    if (!tabla) return;
    if (words.length) {
      // Búsqueda: mostrar solo filas que coinciden, ocultar paginación
      tabla.querySelectorAll('tr[data-pg-idx]').forEach(row => {
        const haystack = _normSearch(row.dataset.search);
        row.style.display = words.every(w => haystack.includes(w)) ? '' : 'none';
      });
      if (pgEl) pgEl.style.display = 'none';
    } else {
      // Sin búsqueda: restaurar paginación visual
      if (pgEl) pgEl.style.display = '';
      _invPgGo(tipo, window._invPgPage[tipo] || 0, tabla);
    }
  }, _IS_TABLET ? 300 : 100);
}

function _invPgGo(tipo, page, tabla) {
  window._invPgPage[tipo] = page;
  if (!tabla) tabla = document.getElementById('tbl-' + tipo);
  if (!tabla) return;
  const start = page * 50, end = start + 50;
  tabla.querySelectorAll('tr[data-pg-idx]').forEach(row => {
    const idx = parseInt(row.dataset.pgIdx);
    row.style.display = (idx >= start && idx < end) ? '' : 'none';
  });
  // Actualizar controles de paginación
  const pgEl = document.getElementById('inv-pg-' + tipo);
  if (pgEl) {
    const total = tabla.querySelectorAll('tr[data-pg-idx]').length;
    const pages = Math.ceil(total / 50);
    pgEl.innerHTML = _invPgControls(tipo, page, total, pages);
  }
}

function _invPgControls(tipo, page, total, pages) {
  if (pages <= 1) return '';
  let html = `<div style="display:flex;align-items:center;justify-content:center;gap:6px;padding:12px;flex-wrap:wrap">`;
  html += `<span style="font-size:0.82rem;color:#64748b;margin-right:4px">${total} ítems</span>`;
  if (page > 0) html += `<button class="btn btn-sm btn-outline" onclick="_invPgGo('${tipo}',${page-1})" style="padding:4px 10px">‹ Ant</button>`;
  const start = Math.max(0, page - 2), end = Math.min(pages - 1, page + 2);
  for (let p = start; p <= end; p++) {
    html += `<button class="btn btn-sm ${p===page?'btn-primary':'btn-outline'}" onclick="_invPgGo('${tipo}',${p})" style="padding:4px 10px;min-width:34px">${p+1}</button>`;
  }
  if (page < pages - 1) html += `<button class="btn btn-sm btn-outline" onclick="_invPgGo('${tipo}',${page+1})" style="padding:4px 10px">Sig ›</button>`;
  html += `</div>`;
  return html;
}
window['_invPgGo'] = _invPgGo;

