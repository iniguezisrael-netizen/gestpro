      if (_fotosArr.length) { doc.setLineWidth(0.3); doc.line(M+descColW,y,M+descColW,y+dhH+dbH); }

      // ── Observaciones (texto libre) ──
      let bodyY = y+dhH+4;
      if (obsLines.length) {
        doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(30,30,30);
        obsLines.forEach((l,i)=>doc.text(l, M+4, bodyY+i*5));
        bodyY += obsLines.length*5+4;
      }

      // ── Tabla de ítems ──
      if (_czItems.length) {
        const c0W=Math.round(descColW*0.50), c1W=Math.round(descColW*0.12),
