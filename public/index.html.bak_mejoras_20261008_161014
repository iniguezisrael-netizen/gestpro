// ── Accesibilidad: aria-label en botones solo-icono ──────────────────────────
(function _setupA11y() {
  const MAP = {'🗑️':'Eliminar','✏️':'Editar','⋯':'Ver detalle','👁️':'Ver detalle',
    '✕':'Cerrar','✖':'Cerrar','➕':'Agregar','📄':'Ver PDF','📥':'Descargar',
    '🖨️':'Imprimir','📋':'Copiar','⬆️':'Subir','⬇️':'Bajar'};
  function tag(root) {
    (root || document).querySelectorAll('button:not([aria-label])').forEach(btn => {
      const t = btn.textContent.trim();
      if (/[a-zA-ZáéíóúÁÉÍÓÚñÑ]/.test(t)) return;
      const k = Object.keys(MAP).find(k => t.includes(k));
      if (k) btn.setAttribute('aria-label', MAP[k]);
    });
  }
  let _a11yTimer;
  const _a11yObserver = new MutationObserver(() => { clearTimeout(_a11yTimer); _a11yTimer = setTimeout(() => tag(), 200); });
  _a11yObserver.observe(document.body, { childList: true, subtree: true });
  window.addEventListener('beforeunload', () => _a11yObserver.disconnect(), { once: true });
})();

