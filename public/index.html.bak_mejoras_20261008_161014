// Se llama automáticamente al abrir la app con ?codigo=XXX en la URL.
// Muestra la ficha del producto correspondiente sin necesidad de navegar.
window._mostrarFichaQR = function() {
  try {
    const codigo = new URLSearchParams(window.location.search).get('codigo');
    // Siempre mostrar la app — si algo falla el usuario ve la pantalla normal
    const appEl = document.getElementById('app');
    if (appEl) appEl.style.display = 'block';
    initApp();
    if (!codigo) return;
    setTimeout(() => {
      try {
        const find = col => (db[col]||[]).find(i => String(i.codigo||i.barcode||i.id) === codigo);
        const c = find('consignacion');
        const p = find('productos');
        const m = find('materia');
        if (c) {
          navigate('consignacion');
          setTimeout(() => verDetalleConsig(c.id), 300);
        } else if (p) {
          navigate('productos');
          setTimeout(() => verDetalleProducto(p.id), 300);
        } else if (m) {
          navigate('inventario');
          setTimeout(() => verDetalleMateria(m.id), 300);
        }
      } catch(e) { console.error('_mostrarFichaQR inner:', e); }
    }, 1000);
  } catch(e) {
    console.error('_mostrarFichaQR:', e);
    // Fallback: iniciar app normalmente
    try { document.getElementById('app').style.display = 'block'; initApp(); } catch(_) {}
  }
};

