function epiInvAdd() {
  const nombre = document.getElementById('epi-inv-prod')?.value.trim();
  const qty = +(document.getElementById('epi-inv-qty')?.value||1);
  if (!nombre) { _info('Escribe o selecciona un producto'); return; }
  const item = _epiInvMap[nombre];
  const origen = document.getElementById('epi-inv-origen')?.value;
  const precio = item && typeof item === 'object' ? (item.precioPublico||item.precio||0) : (Number(item)||0);
  const _newItem = { producto:nombre, cantidad:qty, precio:precio, unidad: (item&&item.unidad)||'' };
  if (origen && item && item.id != null) {
    _newItem._tipo = origen;
    _newItem._itemId = item.id;
    if (origen === 'consignacion') _newItem._consigFolio = item.folio || undefined;
