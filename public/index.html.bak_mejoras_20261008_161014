        while (fs > 6.5 && doc.getTextWidth(valStr) > fW - 5) { fs -= 0.5; doc.setFontSize(fs); }
        // Si aún no cabe a mínimo de fuente, dividir en dos líneas
        if (doc.getTextWidth(valStr) > fW - 5) {
          const lines = doc.splitTextToSize(valStr, fW - 4);
          doc.text(lines.slice(0, 2), fx+2, fy+7, { lineHeightFactor: 1.35 });
        } else {
          doc.text(valStr, fx+2, fy+9.5);
        }
      };

      const row1 = [
        ['Nombre', (c.ctNombre||'')+(c.ctApellido?' '+c.ctApellido:'')||c.cliente],
        ['Teléfono', c.ctTelFijo],
        ['Celular', c.ctCelular],
        ['Correo', c.ctCorreo],
      ];
      row1.forEach(([l,v],i) => {
        const fx=M+i*fW;
