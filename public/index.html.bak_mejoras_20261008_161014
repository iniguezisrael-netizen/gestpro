function _cCatFilter(inp) {
  const dd = document.getElementById('c-cat-dd');
  if (!dd || !inp) return;
  const val = (inp.value || '').toLowerCase().trim();
  // Combinar catConsig + categorías ya usadas en artículos existentes
  const _catBase = (db.catConsig || []).map(x => x.nombre).filter(Boolean);
  const _catUsadas = (db.consignacion||[]).map(x=>x.categoria).filter(Boolean);
  let cats = Array.from(new Set([..._catBase, ..._catUsadas]));
  cats = cats.filter(c => !val || c.toLowerCase().includes(val)).sort();
  if (!cats.length) { dd.style.display = 'none'; return; }
  dd.innerHTML = cats.map(nombre => {
    const safe = nombre.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return `<div style="display:flex;align-items:center;padding:6px 10px;gap:6px;border-bottom:1px solid #f1f5f9">
      <span style="flex:1;cursor:pointer;font-size:14px" onmousedown="document.getElementById('c-categoria').value=this.textContent;document.getElementById('c-cat-dd').style.display='none'">${safe}</span>
      <button type="button" style="border:none;background:none;color:#ef4444;cursor:pointer;font-size:18px;padding:0 4px;line-height:1" title="Borrar categoría"
        onmousedown="event.stopPropagation();_cCatDelete(this.closest('div').querySelector('span').textContent)">×</button>
    </div>`;
  }).join('');
  dd.style.display = 'block';
}
async function _cCatDelete(nombre) {
  if (!confirm('¿Borrar la categoría "' + nombre + '" de las sugerencias?')) return;
  const idx = (db.catConsig||[]).findIndex(x=>x.nombre===nombre);
  if (idx !== -1) {
    const id = db.catConsig[idx].id;
    db.catConsig.splice(idx, 1);
    saveDb('catConsig');
    try { await firebase.firestore().collection('catConsig').doc(id).delete(); } catch(e) { console.warn('_cCatDelete:', e); }
  } else {
    // Era solo migración local: no hay que borrar de Firestore
  }
  _cCatFilter(document.getElementById('c-categoria'));
  if (typeof showToast === 'function') showToast('Categoría eliminada');
}
// ── Helpers producto terminado: stock apartado ───────────────
// Descuenta stock de productos en una venta (solo ventas con _nuevaLogicaProd)
function _descontarProdVenta(vtItems) {
  (vtItems||[]).forEach(it => {
    if (it._tipo === 'productos' && it._itemId != null) {
      const prod = (db.productos||[]).find(x => String(x.id) === String(it._itemId));
      if (prod && prod.cantidad != null) {
        prod.cantidad = Math.max(0, prod.cantidad - (it.cantidad||1));
        // Update directo a Firestore para evitar race condition con delta snapshot
        if (FIREBASE_ENABLED && firestore) {
          firestore.collection('productos').doc(String(prod.id))
            .update({ cantidad: prod.cantidad })
            .catch(e => console.warn('[stock] No se pudo actualizar cantidad:', prod.id, e));
        }
      }
    }
  });
}

// Corrige manualmente el stock de una venta ya pagada (uso admin)
function _corregirStockVenta(vtId) {
  if (!can(['admin'])) return;
  const vt = findById(db.ventas, vtId);
  if (!vt) return;
  const prodItems = (vt.items||[]).filter(it => it._tipo === 'productos' && it._itemId != null);
  if (!prodItems.length) { _info('Esta venta no tiene productos de inventario vinculados.'); return; }
  const lineas = prodItems.map(it => {
    const prod = (db.productos||[]).find(x => String(x.id) === String(it._itemId));
    return `• ${prod ? prod.nombre : 'ID '+it._itemId}: −${it.cantidad||1} unidad(es) (stock actual: ${prod?.cantidad ?? '?'})`;
  }).join('\n');
  _confirm(`¿Aplicar descuento de stock para esta venta?\n\n${lineas}`, () => {
    _descontarProdVenta(vt.items);
    saveDb(['productos']);
    showToast('✅ Stock corregido en Firestore');
    renderInventario('productos');
  }, null, { ok: 'Corregir stock' });
}
window['_corregirStockVenta'] = _corregirStockVenta;
// Suma unidades de un producto comprometidas en pedidos activos (no pagados, nueva lógica)
function _apartadosProd(productoId) {
  return (db.ventas||[])
    .filter(v => v._nuevaLogicaProd && v.estado !== 'Cancelada' && v.saldo > 0)
    .reduce((sum, vt) => sum + (vt.items||[])
      .filter(it => it._tipo === 'productos' && String(it._itemId) === String(productoId))
      .reduce((s, it) => s + (it.cantidad||1), 0), 0);
}
window['_apartadosProd'] = _apartadosProd;

function _toggleConsigMenu(id, btn) {
  const menu = document.getElementById('_cmenu-'+id);
  if (!menu) return;
  const isOpen = menu.style.display !== 'none';
  document.querySelectorAll('[id^="_cmenu-"]').forEach(m => m.style.display='none');
  if (!isOpen) {
    menu.style.display = 'block';
    setTimeout(() => document.addEventListener('click', function _close(e) {
      if (!menu.contains(e.target) && e.target !== btn) menu.style.display='none';
      document.removeEventListener('click', _close);
    }), 0);
  }
}
