function generarQRItem(tipo, id) {
  if (typeof QRCode === 'undefined') {
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
    script.integrity = 'sha384-3zSEDfvllQohrq0PHL1fOXJuC/jSOO34H46t6UQfobFOmxE5BpjjaIJY5F2/bMnU';
    script.crossOrigin = 'anonymous';
    script.onload = () => _mostrarQRItem(tipo, id);
    script.onerror = () => _info('No se pudo cargar el generador de códigos QR. Revisa tu conexión a internet.');
    document.head.appendChild(script);
  } else {
    _mostrarQRItem(tipo, id);
  }
}

function _qrTextoItem(tipo, item) {
  if (tipo === 'consignacion' && item.folio) {
    return window.location.origin + '/?consig=' + encodeURIComponent(item.folio);
  }
  if (tipo === 'productos' && item.codigo) {
    return window.location.origin + '/?codigo=' + encodeURIComponent(item.codigo);
  }
  return String(item.codigo || item.barcode || item.id);
}

function _qrInfoItem(tipo, item) {
  const nombre = tipo === 'consignacion' ? item.producto : item.nombre;
  if (tipo === 'consignacion') {
    return [
      'CAMPERS LA CUESTA',
      `Producto: ${nombre}`,
      item.folio ? `Folio: ${item.folio}` : '',
      item.desc  ? `Descripción: ${item.desc}` : '',
    ].filter(Boolean).join('\n');
  }
  return [
    'CAMPERS LA CUESTA',
    `Producto: ${nombre}`,
    item.codigo ? `Código: ${item.codigo}` : (item.barcode ? `Código: ${item.barcode}` : ''),
    item.categoria ? `Categoría: ${item.categoria}` : '',
    (item.especUnidad || item.especTipo) ? `Unidad: ${item.especUnidad||'-'}  ·  Tipo: ${item.especTipo||'-'}` : '',
    (item.especForro || item.especColor) ? `Forro ext.: ${item.especForro||'-'}  ·  Color: ${item.especColor||'-'}` : '',
    item.desc ? `Descripción: ${item.desc}` : '',
    item.especObservaciones ? `Observaciones: ${item.especObservaciones}` : ''
  ].filter(Boolean).join('\n');
}

let _qrItemActual = null;
function _mostrarQRItem(tipo, id) {
  const item = db[tipo].find(i => i.id === id);
  if (!item) return;
  const nombre = tipo === 'consignacion' ? item.producto : item.nombre;
  const texto = _qrTextoItem(tipo, item);
  const info = _qrInfoItem(tipo, item);
  _qrItemActual = { tipo, id, texto, nombre, info, folio: item.folio||'', desc: item.desc||'', codigo: item.codigo||item.barcode||'', obs: item.especObservaciones||'' };
  showModal(`🔲 Código QR — ${nombre}`, `
    <p style="font-size:0.82rem;color:#64748b;margin-bottom:10px">Este código solo funciona con el escáner interno del sistema. Escanearlo con un celular externo únicamente muestra el código del producto, sin acceso al sistema.</p>
    <div id="qr-canvas-area" style="display:flex;justify-content:center;padding:14px;background:white;border-radius:10px;border:1px solid var(--border)"></div>
    <pre style="font-size:0.72rem;background:var(--bg);border-radius:8px;padding:8px;margin-top:10px;white-space:pre-wrap;color:#334155">${esc(info)}</pre>
  `, [
    { label:'🖨️ Imprimir etiqueta', cls:'btn-primary', action: imprimirEtiquetaQR },
    { label:'Cerrar', cls:'btn-secondary', action:closeModal }
  ]);
