      <td style="padding:4px 6px"><input type="number" value="${i.precio}" min="0" step="0.01" style="width:90px;border:1px solid ${i.precio===0?'var(--danger)':'var(--border)'};border-radius:6px;padding:4px 6px;font-size:0.85rem;font-weight:600" onchange="ventaItems[${idx}].precio=+this.value;updateEditPedidoItems()" /></td>
      <td style="padding:4px 6px;font-weight:600">$${fmt(i.cantidad*i.precio)}</td>
      <td><button onclick="ventaItems.splice(${idx},1);updateEditPedidoItems()" style="background:none;border:none;cursor:pointer;color:var(--danger)">✕</button></td>
    </tr>`).join('')}
  </table>` : '<p style="color:#94a3b8;font-size:0.85rem">Sin items.</p>';
  const subtotal = ventaItems.reduce((s,i)=>s+i.cantidad*i.precio,0);
  const ivaEl = document.querySelector('input[name="ep-iva"]:checked');
  const ivaMode = ivaEl ? ivaEl.value : 'neto';
  const tv = document.getElementById('ep-total');
  if (tv) {
    if (!ventaItems.length) { tv.innerHTML = ''; return; }
    const ivaAmtEpUi = ivaMode === 'mas' ? round2(subtotal * 0.16) : 0;
    const totalEpUi = round2(ivaMode === 'mas' ? subtotal + ivaAmtEpUi : subtotal);
    const labelEp = ivaMode === 'mas'
      ? `<span style="font-size:0.8rem;color:#0f6e56;font-weight:600;margin-left:6px">+ IVA (16%)</span>`
      : ivaMode === 'incluido'
      ? `<span style="font-size:0.8rem;color:#7c3aed;font-weight:600;margin-left:6px">NETO con IVA</span>`
      : `<span style="font-size:0.8rem;color:#64748b;font-weight:600;margin-left:6px">NETO sin IVA</span>`;
    tv.innerHTML = ivaMode === 'mas'
      ? `<span style="font-weight:700;font-size:1.1rem;color:var(--primary)">Total: $${fmt(totalEpUi)}</span> <span style="font-size:0.8rem;color:#64748b">(base $${fmt(subtotal)} + IVA $${fmt(ivaAmtEpUi)})</span>`
      : `<span style="font-weight:700;font-size:1.1rem;color:var(--primary)">Total: $${fmt(totalEpUi)}</span>${labelEp}`;
  }
}

function guardarEditPedido(id) {
  if (!can(['admin','secretaria','auxiliar'])) { _info('Sin permiso para editar pedidos.'); return; }
  // Usa la referencia directa guardada al abrir el modal (evita buscar por ID con duplicados).
  const vt = _editingVentaRef || findById(db.ventas, id);
  if (!vt) return;
  // Si no hay items en el editor, conservar los originales del pedido
  if (!ventaItems.length) ventaItems = JSON.parse(JSON.stringify(vt.items || []));
  const anticipo = document.getElementById('ep-anticipo')?.value !== '' ? +document.getElementById('ep-anticipo').value : vt.anticipo;
  const subtotalEp = ventaItems.reduce((s,i)=>s+i.cantidad*i.precio,0);
  const ivaElEp = document.querySelector('input[name="ep-iva"]:checked');
  const ivaModeEp = ivaElEp ? ivaElEp.value : (vt.ivaMode || 'neto');
  const netoEp   = subtotalEp;
  const ivaAmtEp = ivaModeEp === 'mas' ? round2(subtotalEp * 0.16) : (ivaModeEp === 'incluido' ? round2(subtotalEp - subtotalEp / 1.16) : 0);
  const total    = round2(ivaModeEp === 'mas' ? subtotalEp + ivaAmtEp : subtotalEp);
  if (can(['admin'])) {
    const nuevoFolio = document.getElementById('ep-folio')?.value.trim();
    if (nuevoFolio && nuevoFolio !== vt.folioPedido) {
      if (db.ventas.find(x => x.folioPedido === nuevoFolio && x.id !== vt.id)) {
        _info('❌ Ya existe un pedido con ese número. Asigna uno diferente.');
        return;
      }
      vt.folioPedido = nuevoFolio;
    }
  }
  const epNombre   = document.getElementById('ep-nombre')?.value.trim()   || '';
  const epApellido = document.getElementById('ep-apellido')?.value.trim() || '';
  vt.ctNombre    = epNombre;
  vt.ctApellido  = epApellido;
  vt.cliente     = [epNombre, epApellido].filter(Boolean).join(' ') || vt.cliente;
  vt.fecha       = document.getElementById('ep-fecha')?.value           || vt.fecha;
  vt.ctCelular   = document.getElementById('ep-celular')?.value.trim()  || '';
  vt.celular     = vt.ctCelular;
  vt.ctTelFijo   = document.getElementById('ep-telfijo')?.value.trim()  || '';
  vt.telfijo     = vt.ctTelFijo;
  vt.ctCorreo    = document.getElementById('ep-email')?.value.trim()    || '';
  vt.email       = vt.ctCorreo;
  vt.ctEmpresa   = document.getElementById('ep-empresa')?.value.trim()  || vt.ctEmpresa || '';
  vt.ctCiudad    = document.getElementById('ep-ciudad')?.value.trim()   || vt.ctCiudad  || '';
  vt.ciudad      = vt.ctCiudad;
  vt.ctEstado    = document.getElementById('ep-estado-ct')?.value.trim()|| vt.ctEstado  || '';
  vt.ctDireccion = document.getElementById('ep-direccion')?.value.trim()|| vt.ctDireccion || '';
  vt.ctColonia   = document.getElementById('ep-colonia')?.value.trim()  || vt.ctColonia || '';
  vt.ctCp        = document.getElementById('ep-cp')?.value.trim()       || vt.ctCp      || '';
  vt.ctRfc       = document.getElementById('ep-rfc')?.value.trim()      || vt.ctRfc     || '';
  vt.rfc         = vt.ctRfc;
  vt.fechaEntrega = document.getElementById('ep-fecha-entrega')?.value  || vt.fechaEntrega || '';
  vt.estado      = document.getElementById('ep-estado')?.value          || vt.estado;
  vt.unidad      = document.getElementById('ep-unidad')?.value.trim()   || '';
  vt.tipo        = document.getElementById('ep-tipo')?.value.trim()     || '';
  vt.forro       = document.getElementById('ep-forro')?.value.trim()    || '';
  vt.color       = document.getElementById('ep-color')?.value.trim()    || '';
  vt.observaciones = document.getElementById('ep-obs')?.value           || '';
  vt.tiempoFabricacion = document.getElementById('ep-tiempo-fabricacion')?.value.trim() || vt.tiempoFabricacion || '';
  if (can(['admin','secretaria','auxiliar'])) { const _epFact = document.getElementById('ep-factura')?.value.trim(); vt.numFactura = _epFact || undefined; }
  vt.notas       = document.getElementById('ep-notas')?.value           || '';
  vt.fotos = [..._tempFotosEp];
  vt.items = ventaItems;
  vt.total = total;
  vt.iva = ivaModeEp !== 'neto';
  vt.ivaMode = ivaModeEp;
  vt.subtotal = netoEp;
  vt.ivaAmount = ivaAmtEp;
  vt.anticipo = anticipo != null ? anticipo : 0;
  vt.saldo = Math.max(0, total - vt.anticipo);
  // Si el total subió y ya estaba pagada, reflejar que hay saldo pendiente
  if (vt.saldo > 0 && vt.estado === 'Pagada') vt.estado = 'Pendiente';
  // Si quedó en saldo cero y no está cancelada, marcar como pagada
  if (vt.saldo === 0 && total > 0 && vt.estado !== 'Cancelada') vt.estado = 'Pagada';
  // Sincronizar estado de consignación vinculada
  (db.consignacion||[]).filter(c => String(c.ventaId) === String(vt.id))
    .forEach(c => { c.estado = vt.saldo === 0 ? 'Vendido' : 'Apartado'; });
  // Recuperar flag de nueva lógica si el pedido tiene productos con saldo pendiente (fix pedidos viejos)
  if (!vt._nuevaLogicaProd && vt.saldo > 0 && (vt.items||[]).some(i => i._tipo === 'productos')) vt._nuevaLogicaProd = true;
  // Descontar productos si se llega a saldo cero con nueva lógica
  if (vt._nuevaLogicaProd && vt.saldo === 0) { _descontarProdVenta(vt.items); vt._nuevaLogicaProd = false; }
  if (ventaItems.length && total > 0) vt.pendienteCotizar = undefined;
  // Sincronizar total y numFactura en cobranza si el pedido está vinculado
  if (vt.cobranzaId) {
    const cobIdx = (db.cobranza || []).findIndex(x => x.id === vt.cobranzaId);
    if (cobIdx >= 0) {
      if (total > 0) db.cobranza[cobIdx].total = total;
      db.cobranza[cobIdx].factura = vt.numFactura || '';
    }
  }
  // Garantizar que el objeto editado está en db.ventas aunque onSnapshot lo haya reemplazado
  const _dbIdx = (db.ventas || []).findIndex(x => String(x.id) === String(vt.id));
  if (_dbIdx >= 0) db.ventas[_dbIdx] = vt; else db.ventas.push(vt);
  saveDb(['ventas','cobranza','consignacion','productos']); closeModal(); renderVentas();
}

