        bodyY += tblHdrH;
        // Filas
        _czItems.forEach((it,ri)=>{
          const bg=ri%2===0?[255,255,255]:[247,249,252];
          doc.setFillColor(...bg); doc.rect(M,bodyY,descColW,tblRowH,'F');
          doc.setDrawColor(226,232,240); doc.setLineWidth(0.1);
          doc.line(M,bodyY,M+descColW,bodyY);
          cXs.slice(1).forEach(cx=>doc.line(cx,bodyY,cx,bodyY+tblRowH));
          const vals=[it.producto||it.concepto||'—',String(it.cantidad||1),'$'+fmt(it.precio||0),'$'+fmt((it.cantidad||1)*(it.precio||0))];
          vals.forEach((v,i)=>{
            const al=cAligns[i];
            if(i===0){
              doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(30,30,30);
