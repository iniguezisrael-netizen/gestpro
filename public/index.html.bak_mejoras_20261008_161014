function _cargarLogoYAbrirFormatoCotiz(c) {
  const folioBarcode = String(c.folio || c.id || '');
  const _conBarcode = (logoB64) => {
    _cargarLibJsBarcode(() => {
      let bcB64 = '';
      try {
        const canvas = document.createElement('canvas');
        JsBarcode(canvas, folioBarcode, { format:'CODE128', width:1.6, height:40, fontSize:12, margin:4, displayValue:true });
        bcB64 = canvas.toDataURL('image/png');
      } catch(e) { console.warn('[Barcode cotiz] no se pudo generar', e); }
      _abrirFormatoCotizHTML(c, logoB64, bcB64);
    });
  };
  // Caché de logo: evita convertir la imagen en cada PDF
  if (window._logoB64Cache) { _conBarcode(window._logoB64Cache); return; }
  const logoEl = document.querySelector('#login-logo, .sidebar-logo, img[alt="Campers La Cuesta"]');
  const logoSrcRaw = logoEl ? logoEl.src : '';
  if (logoSrcRaw.startsWith('data:image/')) { window._logoB64Cache = logoSrcRaw; _conBarcode(logoSrcRaw); return; }
  const img = new Image();
  img.crossOrigin = 'anonymous';
  img.onload = function() {
    const canvas = document.createElement('canvas');
    canvas.width = img.width; canvas.height = img.height;
    canvas.getContext('2d').drawImage(img, 0, 0);
    try { const b64 = canvas.toDataURL('image/png'); window._logoB64Cache = b64; _conBarcode(b64); } catch(e) { _conBarcode(''); }
  };
  img.onerror = () => _conBarcode('');
  img.src = logoSrcRaw || '/logo.png';
}
