function _mostrarVentasHoy(periodo) {
  periodo = periodo || window._vtHoyPeriodo || 'hoy';
  window._vtHoyPeriodo = periodo;

  // --- rangos de fecha ---
  const _hoy = today();
  function _semanaInicio() {
    var d = new Date(_hoy + 'T00:00:00');
    var dia = d.getDay();
    var diff = dia === 0 ? -6 : 1 - dia;
    d.setDate(d.getDate() + diff);
    return d.toISOString().substring(0,10);
  }
  function _mesInicio(offset) {
    var d = new Date(_hoy + 'T00:00:00');
    d.setDate(1);
    d.setMonth(d.getMonth() + (offset||0));
    return d.toISOString().substring(0,10);
  }
  function _mesFin(offset) {
    var d = new Date(_hoy + 'T00:00:00');
    d.setDate(1);
    d.setMonth(d.getMonth() + (offset||0) + 1);
    d.setDate(d.getDate() - 1);
    return d.toISOString().substring(0,10);
  }

  var desde, hasta;
  if      (periodo === 'hoy')    { desde = _hoy;           hasta = _hoy; }
  else if (periodo === 'semana') { desde = _semanaInicio(); hasta = _hoy; }
  else if (periodo === 'mes')    { desde = _mesInicio(0);   hasta = _hoy; }
  else                           { desde = _mesInicio(-1);  hasta = _mesFin(-1); }

  const lista = (db.ventas||[])
    .filter(v => v.fecha >= desde && v.fecha <= hasta && v.estado !== 'Cancelada' && !v.usoInterno)
    .sort((a,b) => (b.folio||0)-(a.folio||0));

  // Filtros de período
  const filtrosHtml =
    '<div style="display:flex;gap:6px;flex-wrap:wrap;padding:10px 12px 10px;border-bottom:1px solid var(--border)">' +
    [['hoy','Hoy'],['semana','Esta semana'],['mes','Este mes'],['mesant','Mes pasado']].map(function(p){
      var act = p[0] === periodo;
      return '<button onclick="_mostrarVentasHoy(\'' + p[0] + '\')" style="font-family:inherit;font-size:0.75rem;font-weight:600;padding:4px 13px;border-radius:20px;border:1.5px solid ' +
        (act ? 'var(--primary)' : 'var(--border)') + ';background:' +
        (act ? 'var(--primary)' : 'transparent') + ';color:' +
        (act ? '#fff' : 'var(--text-light)') + ';cursor:pointer">' + p[1] + '</button>';
    }).join('') +
    '</div>';

  if (!lista.length) {
    var emptyBody = filtrosHtml + '<p style="padding:20px;color:#94a3b8;text-align:center">Sin ventas en este período.</p>';
    showModal('📅 Ventas Hoy', emptyBody, [
      {label:'Ver todas', cls:'btn-primary', action:function(){closeModal();navigate('ventas');}},
      {label:'Cerrar', cls:'btn-outline', action:closeModal}
    ]);
    return;
  }

  // Mapa global para pasar folioPedido al onclick sin problemas de comillas
  window._vtHoyFolios = {};
  lista.forEach(function(v){ window._vtHoyFolios[v.id] = v.folioPedido || null; });
  const filas = lista.map(function(v) {
    var estadoColor = v.estado==='Pagada'?'#16a34a':v.estado==='Pendiente'?'#d97706':'#64748b';
    return '<tr style="border-bottom:1px solid var(--border)">' +
      '<td style="padding:8px 10px;font-weight:600;color:var(--primary)">#' + (v.folio||'') + '</td>' +
      '<td style="padding:8px 10px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(v.cliente||'—') + '</td>' +
      '<td style="padding:8px 10px;text-align:right;font-variant-numeric:tabular-nums">$' + fmt(v.total||0) + '</td>' +
      '<td style="padding:8px 10px"><span style="font-size:0.75rem;font-weight:600;color:' + estadoColor + ';background:' + estadoColor + '18;padding:2px 8px;border-radius:12px">' + esc(v.estado||'') + '</span></td>' +
      '<td style="padding:8px 6px;text-align:center"><button class="btn btn-sm btn-outline" style="padding:3px 8px;font-size:0.78rem" onclick="closeModal();setTimeout(function(){verVenta(' + v.id + ',window._vtHoyFolios[' + v.id + '])},150)">Ver</button></td>' +
      '</tr>';
  }).join('');
  const total = lista.reduce(function(s,v){return s+(v.total||0);},0);
  const body = filtrosHtml +
    '<div style="overflow-x:auto">' +
    '<table style="width:100%;border-collapse:collapse;font-size:0.88rem">' +
    '<thead><tr style="background:var(--bg-secondary,#f8fafc)">' +
    '<th style="padding:8px 10px;text-align:left;font-size:0.78rem;color:#64748b">Folio</th>' +
    '<th style="padding:8px 10px;text-align:left;font-size:0.78rem;color:#64748b">Cliente</th>' +
    '<th style="padding:8px 10px;text-align:right;font-size:0.78rem;color:#64748b">Monto</th>' +
    '<th style="padding:8px 10px;text-align:left;font-size:0.78rem;color:#64748b">Estado</th>' +
    '<th style="padding:8px 10px"></th>' +
    '</tr></thead>' +
    '<tbody>' + filas + '</tbody>' +
    '<tfoot><tr style="border-top:2px solid var(--border)">' +
    '<td colspan="2" style="padding:10px;font-weight:700;font-size:0.85rem">' + lista.length + ' venta' + (lista.length!==1?'s':'') + '</td>' +
    '<td style="padding:10px;text-align:right;font-weight:700;color:var(--primary);font-variant-numeric:tabular-nums">$' + fmt(total) + '</td>' +
    '<td colspan="2"></td>' +
    '</tr></tfoot>' +
    '</table></div>';
  showModal('📅 Ventas Hoy', body, [
    {label:'Ver todas', cls:'btn-primary', action:function(){closeModal();navigate('ventas');}},
    {label:'Cerrar', cls:'btn-outline', action:closeModal}
  ]);
}


function _mostrarCaja() {
  // Períodos disponibles
  const _hoy = today();
  function _semanaInicio() {
    var d = new Date(_hoy + 'T00:00:00');
    var dia = d.getDay();
    var diff = dia === 0 ? -6 : 1 - dia;
    d.setDate(d.getDate() + diff);
    return d.toISOString().slice(0,10);
  }
  function _mesInicio(offset) {
    var d = new Date(_hoy + 'T00:00:00');
    d.setMonth(d.getMonth() + (offset||0), 1);
    return d.toISOString().slice(0,10).slice(0,8) + '01';
  }
  function _mesFin(offset) {
    var d = new Date(_hoy + 'T00:00:00');
    d.setMonth(d.getMonth() + (offset||0) + 1, 0);
    return d.toISOString().slice(0,10);
  }

  function _buildBody() {
    var periodo = document.getElementById('caja-periodo')?.value || 'dia';
    var usuFiltro = document.getElementById('caja-usuario')?.value || '';
    var desde, hasta;
    if (periodo === 'dia')         { desde = _hoy;            hasta = _hoy; }
    else if (periodo === 'semana') { desde = _semanaInicio(); hasta = _hoy; }
    else if (periodo === 'mes')    { desde = _mesInicio(0);   hasta = _hoy; }
    else                           { desde = _mesInicio(-1);  hasta = _mesFin(-1); }

    var filas = [];
    (db.ventas||[]).forEach(function(vt) {
      (vt.pagos||[]).forEach(function(p) {
        if (!p.fecha || p.fecha < desde || p.fecha > hasta) return;
        if (usuFiltro && (p.recibidoPor||'') !== usuFiltro) return;
        filas.push({
          hora:      p.hora || '',
          quien:     p.recibidoPor || '—',
          cliente:   vt.cliente || '—',
          folio:     vt.folio || vt.id,
          vtId:      vt.id,
          archivado: !!vt.archivado,
