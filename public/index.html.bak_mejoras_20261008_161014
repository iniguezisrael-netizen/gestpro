function _cambiarEstadoVtInline(id, nuevoEstado) {
  if (!can(['admin','secretaria','auxiliar'])) return;
  const vt = (db.ventas||[]).find(v => v.id === id);
  if (!vt) return;
  if (vt.estado === 'Entregado') return; // Estado bloqueado — solo archivar
  // Secretaria/auxiliar no pueden poner Pagada si hay saldo pendiente
  if (nuevoEstado === 'Pagada' && session.rol !== 'admin') {
    const _saldoPend = vt.saldo != null ? vt.saldo : vt.total;
    if (_saldoPend > 0) {
      showToast('⛔ Saldo pendiente');
      renderVentas();
      return;
    }
  }
  const estadoAnterior = vt.estado;
  vt.estado = nuevoEstado;
  // Si pasan a Pagada y tenía saldo, limpiar el saldo (el usuario confirma que ya cobró)
  if (nuevoEstado === 'Pagada' && vt.saldo > 0) {
    _confirm(`El pedido tiene un saldo de $${fmt(vt.saldo)}. ¿Ya se cobró? Esto marcará el saldo en $0.`,
      () => {
        vt.saldo = 0;
        vt.anticipo = vt.total || vt.anticipo;
        (db.consignacion||[]).filter(c => String(c.ventaId) === String(vt.id))
          .forEach(c => { c.estado = 'Vendido'; });
        if (vt._nuevaLogicaProd) { _descontarProdVenta(vt.items); vt._nuevaLogicaProd = false; }
        saveDb(['ventas','consignacion','productos']);
        showToast(`✅ ${vt.folioPedido||('#'+vt.id)} → ${nuevoEstado}`);
        renderVentas();
      },
      () => { vt.estado = estadoAnterior; renderVentas(); },
      {ok:'Sí, ya está pagado'}
    );
    return;
  }
  // Validación al marcar Entregado: debe estar pagado o tener crédito autorizado
  if (nuevoEstado === 'Entregado' && !vtCreditoAutorizado(vt)) {
    const _saldoEnt = vt.saldo != null ? vt.saldo : Math.max(0, (vt.total||0) - (vt.anticipo||0));
    if (_saldoEnt > 0.01) {
      if (session.rol === 'admin') {
        vt.estado = estadoAnterior;
