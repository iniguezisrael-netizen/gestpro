function _rpFotoUpload(event) {
  const files = Array.from(event.target.files || []);
  event.target.value = '';
  const disponibles = MAX_FOTOS - _rpFotos.length;
  if (disponibles <= 0) { _info(`Límite de ${MAX_FOTOS} fotos por reporte.`); return; }
  const ses = _rpFotoSession;
  files.slice(0, disponibles).forEach(file => {
    _rpFotosSubiendo++;
    _rpRenderFotos();
    comprimirImagen(file, dataUrl => {
      if (ses !== _rpFotoSession) return;
      subirFotoAStorage(dataUrl, 'reportesProduccion', url => {
        if (ses !== _rpFotoSession) return;
        _rpFotos.push(url);
        _rpFotosSubiendo--;
        _rpRenderFotos();
      });
    });
  });
}
