function _descPreview(totalActual) {
  const tipo = document.getElementById('desc-tipo')?.value || 'monto';
  const val = +document.getElementById('desc-valor')?.value || 0;
  const preview = document.getElementById('desc-preview');
  if (!preview) return;
  if (!val || val <= 0) { preview.style.display = 'none'; return; }
  const monto = tipo === 'pct' ? Math.round(totalActual * val / 100 * 100) / 100 : val;
  if (monto >= totalActual) { preview.textContent = '⚠️ El descuento no puede ser mayor o igual al total'; preview.style.color='#dc2626'; preview.style.display='block'; return; }
  const totalNuevo = Math.max(0, totalActual - monto);
  preview.style.color = '#16a34a';
  preview.textContent = `Descuento de $${fmt(monto)} → Nuevo total: $${fmt(totalNuevo)}`;
