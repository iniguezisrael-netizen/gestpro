function _reAutoGuardarFotos() {
  // Guarda el campo "fotos" inmediatamente después de cada carga — sin esperar a que el usuario presione Guardar.
  // Si el reporte aún no existe en db (nuevo), crea un registro provisional para no perder las URLs de R2.
  if (!_reVtId) return;
  const vt = findById(db.ventas, _reVtId);
  if (!vt) return;
  db.reportesEntrega = db.reportesEntrega || [];
  let rep = db.reportesEntrega.find(r => r.pedidoId === vt.id || r.folioPedido === vt.folioPedido);
  if (!rep) {
    // Reporte nuevo: crear entrada provisional con fotos para no perder URLs de R2
    rep = { id: sid(), pedidoId: vt.id, folioPedido: vt.folioPedido || '',
            cliente: vt.cliente, fecha: today(), revisadoPor: (typeof session !== 'undefined' ? session.nombre : ''),
            items: [], fotos: [], notas: '' };
    db.reportesEntrega.push(rep);
  }
  rep.fotos = [..._reFotos];
  saveDb(['reportesEntrega']);
}

