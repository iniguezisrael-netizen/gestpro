// Carga el logo una sola vez y pre-carga JsBarcode en background para que
// cuando el usuario genere un PDF no haya espera de red ni conversión de imagen.
function _prewarmPDFAssets() {
  // Pre-cargar JsBarcode
  _cargarLibJsBarcode(() => { /* cargado */ });
  // Pre-cargar jsPDF en background
  if (typeof window.jspdf === 'undefined' && typeof window.jsPDF === 'undefined') {
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
    s.async = true;
    document.head.appendChild(s);
  }
  // Pre-cargar fuentes Poppins en background (evita espera de red al abrir PDF)
  const _ttfToB64 = buf => { const b=new Uint8Array(buf); let s=''; for(let i=0;i<b.byteLength;i++) s+=String.fromCharCode(b[i]); return btoa(s); };
  if (!window._poppinsBoldB64) {
    fetch('https://cdn.jsdelivr.net/gh/google/fonts/ofl/poppins/Poppins-Bold.ttf')
      .then(r=>r.arrayBuffer()).then(buf=>{ window._poppinsBoldB64=_ttfToB64(buf); }).catch(()=>{});
  }
  if (!window._poppinsBlackB64) {
    fetch('https://cdn.jsdelivr.net/gh/google/fonts/ofl/poppins/Poppins-Black.ttf')
      .then(r=>r.arrayBuffer()).then(buf=>{ window._poppinsBlackB64=_ttfToB64(buf); }).catch(()=>{});
  }
  // Si ya tenemos el logo cacheado, no hacer nada más
  if (window._logoB64Cache) return;
  const logoEl = document.querySelector('#login-logo, .sidebar-logo, img[alt="Campers La Cuesta"]');
  const logoSrc = logoEl ? logoEl.src : '/logo.png';
  if (logoSrc.startsWith('data:image/')) { window._logoB64Cache = logoSrc; return; }
  const img = new Image();
  img.crossOrigin = 'anonymous';
  img.onload = function() {
    try {
      const c = document.createElement('canvas');
      c.width = img.width; c.height = img.height;
      c.getContext('2d').drawImage(img, 0, 0);
      window._logoB64Cache = c.toDataURL('image/png');
    } catch(e) { /* CORS o canvas tainted — se cargará al momento del PDF */ }
  };
  img.src = logoSrc || '/logo.png';
}

