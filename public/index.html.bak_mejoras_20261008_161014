  }
  const isAdmin = can(['admin']);
  const pendientes = (db.ventas||[]).filter(v => v.estado !== 'Cancelada' && v.estado !== 'Entregado' && !v.archivado).slice().reverse();
  const entregados = (db.ventas||[]).filter(v => v.estado === 'Entregado' && !v.archivado).slice().reverse();

  function filaVenta(v, esEntregado) {
    const empresa = (v.ctEmpresa && v.ctEmpresa !== 'No aplica') ? v.ctEmpresa : '';
    const clienteTxt = esc(v.cliente||'—') + (empresa ? `<br><span style="font-size:0.78rem;color:#64748b">${esc(empresa)}</span>` : '');
    const srch = esc(((v.folioPedido||'')+' '+(v.cliente||'')+' '+empresa).toLowerCase());
    const btnAccion = esEntregado
      ? `<button class="btn btn-outline btn-sm" onclick="openEntregaRapidaModal(${v.id},true)" style="white-space:nowrap">🔄 Devolver</button>`
      : `<button class="btn btn-primary btn-sm" onclick="openEntregaRapidaModal(${v.id},false)" style="display:flex;flex-direction:column;align-items:center;padding:5px 12px;line-height:1.2;white-space:nowrap"><span style="font-size:0.85rem;font-weight:700">📦 Entregar</span><span style="font-size:0.68rem;opacity:0.85">o devolver</span></button>`;
    return `<tr data-search="${srch}">
      <td><strong style="color:var(--primary);white-space:nowrap">${esc(v.folioPedido||`#${v.id}`)}</strong></td>
      <td>${clienteTxt}</td>
      <td><div style="display:flex;gap:4px;align-items:center;justify-content:flex-end">
        ${btnAccion}
        <button class="btn btn-outline btn-sm" onclick="openEiHistorial(${v.id})" title="Ver historial de entregas">✏️</button>
        ${isAdmin && !esEntregado ? `<button class="btn btn-outline btn-sm" onclick="_eiMarcarEntregado(${v.id})" title="Marcar entregado sin escanear" style="color:#16a34a;border-color:#16a34a">✓</button>` : ''}
      </div></td>
    </tr>`;
  }

  el.innerHTML = `
    <div class="card">
      <div class="card-header">
        <span class="card-title">📤 Entregas de Insumos</span>
        <button class="btn btn-primary btn-sm" onclick="openEiModal()">+ Entrega manual</button>
      </div>
      <div class="search-bar"><input type="text" placeholder="Buscar por pedido o cliente..." oninput="filterTable(this,'tbl-ei-p');filterTable(this,'tbl-ei-e')" /></div>

      <div style="padding:0 16px 6px">
        <div style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:10px 0;border-bottom:2px solid var(--border);user-select:none" onclick="_eiToggleSec('pendientes')">
          <span style="font-weight:700;font-size:0.95rem">📋 Pendientes</span>
          <span class="badge badge-red" style="margin-left:4px">${pendientes.length}</span>
          <span id="ei-arr-p" style="margin-left:auto;transition:transform 0.2s">▼</span>
        </div>
        <div id="ei-sec-pendientes">
          <div class="table-wrap"><table id="tbl-ei-p">
            <tr><th style="white-space:nowrap"># Pedido</th><th>Cliente / Empresa</th><th></th></tr>
            ${pendientes.length ? pendientes.map(v => filaVenta(v,false)).join('') : '<tr><td colspan="3" class="td-empty">✅ Sin pedidos pendientes.</td></tr>'}
          </table></div>
        </div>
      </div>

      <div style="padding:0 16px 12px">
        <div style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:10px 0;border-bottom:2px solid var(--border);user-select:none" onclick="_eiToggleSec('entregados')">
          <span style="font-weight:700;font-size:0.95rem">✅ Entregados</span>
          <span class="badge" style="margin-left:4px;background:#e2e8f0;color:#475569">${entregados.length}</span>
          <span id="ei-arr-e" style="margin-left:auto;transform:rotate(-90deg);transition:transform 0.2s">▼</span>
        </div>
        <div id="ei-sec-entregados" style="display:none">
          <div class="table-wrap"><table id="tbl-ei-e">
            <tr><th style="white-space:nowrap"># Pedido</th><th>Cliente / Empresa</th><th></th></tr>
            ${entregados.length ? entregados.map(v => filaVenta(v,true)).join('') : '<tr><td colspan="3" class="td-empty">Sin entregas registradas.</td></tr>'}
          </table></div>
        </div>
      </div>
    </div>`;
}

function _eiToggleSec(sec) {
  const div = document.getElementById('ei-sec-'+sec);
  const arr = document.getElementById('ei-arr-'+sec.charAt(0));
  if (!div) return;
  const open = div.style.display !== 'none';
  div.style.display = open ? 'none' : '';
  if (arr) arr.style.transform = open ? 'rotate(-90deg)' : 'rotate(0deg)';
}

function _eiMarcarEntregado(ventaId) {
  _confirm('¿Marcar este pedido como entregado sin registrar materiales?', () => {
    const v = (db.ventas||[]).find(x => x.id === ventaId);
    if (!v) return;
    v.insumosEntregados = true;
    saveDb('ventas');
    renderEntregaInsumos();
    showToast('Pedido marcado como entregado.','success');
  }, null, {ok:'Marcar entregado'});
}

function openEiHistorial(ventaId) {
  const v = (db.ventas||[]).find(x => x.id === ventaId);
  if (!v) return;
  const registros = (db.entregaInsumos||[]).filter(ei => ei.pedidoId === ventaId);
  const filas = registros.length ? registros.slice().reverse().map(ei => {
    const mats = (ei.materiales||[]).map(m => `<li style="margin:2px 0">${esc(m.cantidad+' '+(m.unidad||'')+' '+m.descripcion)}</li>`).join('');
    const tipo = ei.esDevolucion ? '<span style="color:#f59e0b;font-weight:600">🔄 Devolución</span>' : '<span style="color:#16a34a;font-weight:600">📦 Entrega</span>';
    return `<div style="border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        ${tipo}
        <span style="font-size:0.82rem;color:#64748b">${fechaCorta(ei.fecha)} &nbsp;·&nbsp; ${esc(ei.entregadoPor||'—')}</span>
      </div>
      <ul style="margin:0;padding-left:18px;font-size:0.85rem">${mats||'<li>Sin detalle</li>'}</ul>
      ${ei.notas ? `<div style="font-size:0.78rem;color:#64748b;margin-top:6px">📝 ${esc(ei.notas)}</div>` : ''}
    </div>`;
  }).join('') : '<p style="color:#94a3b8;text-align:center;padding:20px">Sin registros de entrega para este pedido.</p>';
  const empresa = (v.ctEmpresa && v.ctEmpresa !== 'No aplica') ? ` — ${v.ctEmpresa}` : '';
  showModal(`✏️ Historial — ${esc(v.folioPedido||'#'+v.id)} ${esc(v.cliente||'')}${esc(empresa)}`,
    `<div style="max-height:60vh;overflow-y:auto;padding-right:4px">${filas}</div>`,
    [{ label: '✕ Cerrar', cls: 'btn-secondary btn-sm', action: closeModal }]);
}

function openEntregaRapidaModal(ventaId, soloDevolucion) {
  const v = (db.ventas||[]).find(x => x.id === ventaId);
  if (!v) return;
  window._erVentaId = ventaId;
  window._erItems = [];
  window._erDevolucion = !!soloDevolucion;
  const empresa = (v.ctEmpresa && v.ctEmpresa !== 'No aplica') ? v.ctEmpresa : '';
  showModal(`📦 ${soloDevolucion ? 'Devolución' : 'Entrega'} — ${esc(v.folioPedido||'#'+v.id)}`,
    `<div style="margin-bottom:10px;font-size:0.9rem;color:#475569">${esc(v.cliente||'')}${empresa ? ' · '+esc(empresa) : ''}</div>
    <div style="display:flex;gap:6px;margin-bottom:14px">
      <button id="er-btn-ent" onclick="_erSetTipo(false)" class="btn btn-sm" style="flex:1;font-weight:700;background:${soloDevolucion?'var(--border)':'var(--primary)'};color:${soloDevolucion?'var(--text)':'#fff'}">📦 Entrega</button>
      <button id="er-btn-dev" onclick="_erSetTipo(true)"  class="btn btn-sm" style="flex:1;font-weight:700;background:${soloDevolucion?'#f59e0b':'var(--border)'};color:${soloDevolucion?'#fff':'var(--text)'}">🔄 Devolución</button>
      <button onclick="closeModal();recibirConBarcode()" class="btn btn-sm"
        style="flex:1;font-weight:700;background:#0f766e;color:#fff">
        📦 Recibir con código
      </button>
    </div>
    <div style="margin-bottom:8px">
      <label style="font-size:0.8rem;color:#64748b;display:block;margin-bottom:4px">Escanear o escribir código / nombre</label>
      <div style="display:flex;gap:6px">
        <input type="text" id="er-scan" placeholder="Escanear aquí…" autocomplete="off" autofocus inputmode="none"
          style="flex:1;padding:10px 12px;border:2px solid var(--primary);border-radius:8px;font-size:1rem;background:var(--bg)"
          onkeydown="if(event.key==='Enter'){event.preventDefault();_erScanAdd();}"
          oninput="_erScanHint(this.value)">
        <button class="btn btn-outline btn-sm" title="Escanear con cámara" onclick="abrirEscanerCamara(t=>{const s=document.getElementById('er-scan');if(s){s.value=t;_erScanHint(t);setTimeout(()=>_erScanAdd(),80);}}, 'barras')" style="padding:10px 14px;font-size:1.1rem">📷</button>
        <button class="btn btn-outline btn-sm" onclick="_erScanAdd()" style="padding:10px 14px;font-size:1.1rem">➕</button>
      </div>
      <div id="er-scan-hint" style="font-size:0.78rem;color:#64748b;margin-top:4px;min-height:18px">&nbsp;</div>
    </div>
    <div style="margin-bottom:8px;display:grid;grid-template-columns:80px 80px 1fr;gap:6px;align-items:end">
      <div><label style="font-size:0.75rem;color:#64748b">Cantidad</label>
        <input type="number" id="er-qty" value="1" min="0.01" step="any" style="width:100%;padding:6px 8px;border:1.5px solid var(--border);border-radius:6px"
          onkeydown="if(event.key==='Enter'){event.preventDefault();_erScanAdd();}"></div>
      <div><label style="font-size:0.75rem;color:#64748b">Unidad</label>
        <input type="text" id="er-uni" placeholder="pzas" style="width:100%;padding:6px 8px;border:1.5px solid var(--border);border-radius:6px"></div>
      <div style="padding-bottom:1px"><button class="btn btn-primary btn-sm" style="width:100%" onclick="_erScanAdd()">+ Agregar</button></div>
    </div>
    <div id="er-lista" style="margin-bottom:10px;max-height:180px;overflow-y:auto"></div>
    <div class="form-group" style="margin-bottom:0">
      <label style="font-size:0.8rem;color:#64748b">Entregado por</label>
      <input type="text" id="er-quien" readonly style="width:100%;padding:8px;border:1.5px solid var(--border);border-radius:8px;background:var(--bg-alt);color:#64748b;cursor:default">
    </div>`,
    [{ label: '💾 Confirmar', cls: 'btn-primary', action: () => _erGuardar() },
     { label: '✕ Cancelar', cls: 'btn-secondary btn-sm', action: () => { if(typeof window._erCleanupHID==='function'){window._erCleanupHID();window._erCleanupHID=null;} closeModal(); } }]);
  setTimeout(() => {
    const s = document.getElementById('er-scan');
    if(s) { s.focus(); s.scrollIntoView({behavior:'smooth',block:'center'}); }
    const q = document.getElementById('er-quien'); if(q && session && session.nombre) q.value = session.nombre;
    // ── Capturador global para lector HID (scanner hardware) ──────────────
    let _erHIDBuf = '', _erHIDTimer = null;
    const _erHIDHandler = (e) => {
      const scanEl = document.getElementById('er-scan');
      if (!scanEl) { document.removeEventListener('keydown', _erHIDHandler); return; } // modal cerrado
      if (document.activeElement === scanEl) return; // ya tiene foco, el input lo maneja
      if (e.key === 'Enter' || e.key === 'Tab') {
        if (_erHIDBuf.length >= 3) {
          scanEl.value = _erHIDBuf;
          _erScanHint(_erHIDBuf);
          clearTimeout(_erHIDTimer);
          _erHIDBuf = '';
          setTimeout(() => _erScanAdd(), 60);
        }
        return;
      }
      if (e.key.length === 1) {
        _erHIDBuf += e.key;
        clearTimeout(_erHIDTimer);
        _erHIDTimer = setTimeout(() => {
          if (_erHIDBuf.length >= 5) { // suficiente largo para ser un código
            scanEl.value = _erHIDBuf;
            _erScanHint(_erHIDBuf);
            setTimeout(() => _erScanAdd(), 60);
          }
          _erHIDBuf = '';
        }, 120);
      }
    };
    document.addEventListener('keydown', _erHIDHandler);

    // ── Refoco agresivo: el campo er-scan recupera foco si lo pierde ──────
    const _erAllowedOthers = ['er-qty', 'er-uni'];
    const _erBlurHandler = () => {
      setTimeout(() => {
        const el = document.getElementById('er-scan');
        if (!el) return;
        const active = document.activeElement;
        if (!active || !_erAllowedOthers.includes(active.id)) el.focus();
      }, 80);
    };
    const erScanEl = document.getElementById('er-scan');
    if (erScanEl) erScanEl.addEventListener('blur', _erBlurHandler);

    // ── Listener paste: scanners Munbyn en modo portapapeles ─────────────
    const _erPasteHandler = (e) => {
      const el = document.getElementById('er-scan');
      if (!el) { document.removeEventListener('paste', _erPasteHandler); return; }
      const txt = (e.clipboardData || window.clipboardData).getData('text').trim();
      if (txt && txt.length >= 3) {
        e.preventDefault();
        el.value = txt;
        _erScanHint(txt);
        setTimeout(() => _erScanAdd(), 60);
      }
    };
    document.addEventListener('paste', _erPasteHandler);

    // ── Prevenir F5 y teclas de trigger que pueden interrumpir ───────────
    const _erKeyBlocker = (e) => {
      const el = document.getElementById('er-scan');
      if (!el) { document.removeEventListener('keydown', _erKeyBlocker); return; }
      if (['F5','F11','F12'].includes(e.key)) e.preventDefault();
    };
    document.addEventListener('keydown', _erKeyBlocker);

    window._erCleanupHID = () => {
      document.removeEventListener('keydown', _erHIDHandler);
      document.removeEventListener('keydown', _erKeyBlocker);
      document.removeEventListener('paste', _erPasteHandler);
      const el = document.getElementById('er-scan');
      if (el) el.removeEventListener('blur', _erBlurHandler);
      clearTimeout(_erHIDTimer);
    };
  }, 300);
  _erRenderLista();
}

function _erSetTipo(devolucion) {
  window._erDevolucion = devolucion;
  const be = document.getElementById('er-btn-ent');
  const bd = document.getElementById('er-btn-dev');
  if (be) { be.style.background = devolucion ? 'var(--border)' : 'var(--primary)'; be.style.color = devolucion ? 'var(--text)' : '#fff'; }
  if (bd) { bd.style.background = devolucion ? '#f59e0b' : 'var(--border)'; bd.style.color = devolucion ? '#fff' : 'var(--text)'; }
}

function _erScanHint(val) {
  const hint = document.getElementById('er-scan-hint');
  if (!hint || !val.trim()) { if(hint) hint.innerHTML = '&nbsp;'; return; }
  const item = (db.materia||[]).find(i =>
    (i.barcode && i.barcode.trim().toLowerCase() === val.trim().toLowerCase()) ||
    (i.codigo  && i.codigo.trim().toLowerCase()  === val.trim().toLowerCase()) ||
    (i.nombre  && i.nombre.trim().toLowerCase()  === val.trim().toLowerCase()));
  if (item) {
    const u = document.getElementById('er-uni');
    if (u && !u.value) u.value = item.unidad || '';
    const _hFoto = item.fotos && item.fotos[0]
      ? `<img src="${esc(item.fotos[0])}" style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid var(--border);margin-right:8px;vertical-align:middle;flex-shrink:0">`
      : '';
    hint.style.display = 'flex'; hint.style.alignItems = 'center';
    hint.innerHTML = `${_hFoto}<span>✅ <strong>${esc(item.nombre)}</strong> — stock: ${item.cantidad} ${esc(item.unidad||'')}</span>`;
  } else { hint.style.display = ''; hint.innerHTML = '&nbsp;'; }
}

function _erScanAdd() {
  const desc = (document.getElementById('er-scan')?.value||'').trim();
  const qty  = parseFloat(document.getElementById('er-qty')?.value)||1;
  const uni  = (document.getElementById('er-uni')?.value||'').trim();
  if (!desc) { _info('Escribe o escanea un material.'); return; }
  const item = (db.materia||[]).find(i =>
    (i.barcode && i.barcode.trim().toLowerCase() === desc.toLowerCase()) ||
    (i.codigo  && i.codigo.trim().toLowerCase()  === desc.toLowerCase()) ||
    (i.nombre  && i.nombre.trim().toLowerCase()  === desc.toLowerCase()));
  window._erItems.push({ descripcion: item ? item.nombre : desc, cantidad: qty, unidad: item ? (item.unidad||uni) : uni, _materiaId: item ? item.id : null });
  const s = document.getElementById('er-scan');
  if (s) { s.value = ''; s.focus(); }
  const u = document.getElementById('er-uni'); if (u) u.value = '';
  const h = document.getElementById('er-scan-hint'); if (h) h.innerHTML = '&nbsp;';
  document.getElementById('er-qty').value = 1;
  _erRenderLista();
}

function _erRenderLista() {
  const wrap = document.getElementById('er-lista');
  if (!wrap) return;
  if (!window._erItems.length) { wrap.innerHTML = '<p style="color:#94a3b8;font-size:0.82rem;text-align:center;padding:8px">Sin materiales agregados.</p>'; return; }
  wrap.innerHTML = window._erItems.map((it,i) => {
    const _mat = it._materiaId ? (db.materia||[]).find(m => m.id === it._materiaId) : null;
    const _foto = _mat && _mat.fotos && _mat.fotos[0]
      ? `<img src="${esc(_mat.fotos[0])}" style="width:42px;height:42px;object-fit:cover;border-radius:6px;border:1px solid var(--border);flex-shrink:0">`
      : `<div style="width:42px;height:42px;border-radius:6px;background:var(--border);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0">📦</div>`;
    return `<div style="display:flex;align-items:center;gap:8px;padding:6px 8px;background:var(--bg-alt);border-radius:6px;margin-bottom:4px">
      ${_foto}
      <span style="flex:1;font-size:0.85rem">${esc(it.cantidad+' '+(it.unidad||'')+' '+it.descripcion)}</span>
      <button class="btn btn-danger btn-sm" style="padding:2px 8px" onclick="window._erItems.splice(${i},1);_erRenderLista()">✕</button>
    </div>`;
  }).join('');
}

function _erGuardar() {
  if (!window._erItems.length) { _info('Agrega al menos un material.'); return; }
  const ventaId = window._erVentaId;
  const dev = window._erDevolucion;
  const quien = (document.getElementById('er-quien')?.value||'').trim();
  const hoy = today();
  // Ajustar stock
  (window._erItems||[]).forEach(it => {
    if (!it._materiaId) return;
    const mat = (db.materia||[]).find(m => m.id === it._materiaId);
    if (!mat) return;
    if (dev) { mat.cantidad = (mat.cantidad||0) + (it.cantidad||1); }
    else      { mat.cantidad = Math.max(0, (mat.cantidad||0) - (it.cantidad||1)); }
  });
  if ((window._erItems||[]).some(it => it._materiaId)) saveDb('materia');
  // Guardar registro
  const v = (db.ventas||[]).find(x => x.id === ventaId);
  db.entregaInsumos = db.entregaInsumos || [];
  db.entregaInsumos.push({ id: sid(), pedidoId: ventaId, folioPedido: v ? (v.folioPedido||('#'+ventaId)) : ('#'+ventaId), cliente: v ? (v.cliente||'') : '', fecha: hoy, entregadoPor: quien, notas: '', materiales: window._erItems, esDevolucion: dev });
  saveDb('entregaInsumos');
  // insumosEntregados lo maneja el estado "Entregado" en Ventas/Pedidos
  if (typeof window._erCleanupHID === 'function') { window._erCleanupHID(); window._erCleanupHID = null; }
  closeModal();
  renderEntregaInsumos();
  showToast(dev ? 'Devolución registrada.' : 'Entrega registrada.', 'success');
}

