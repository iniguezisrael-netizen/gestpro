      const fotoW2 = _fotosArr.length ? Math.floor((fotoColW-fotoPad*2-(fotoNCols-1)*fotoGap)/fotoNCols) : 0;
      const _ratios = _fotosArr.slice(0,4).map(_fotoRatio);
      const _rowH = (row) => {
        const idxs = _fotosArr.slice(0,4).map((_,i)=>i).filter(i=>Math.floor(i/fotoNCols)===row);
        return idxs.length ? Math.round(fotoW2 * Math.max(...idxs.map(i=>_ratios[i]||0.75))) : 0;
      };
      const _rowHeights = Array.from({length: fotoNRows}, (_,r) => _rowH(r));
      const minFotoBodyH = _fotosArr.length ? fotoPad+_rowHeights.reduce((a,b)=>a+b,0)+(fotoNRows-1)*fotoGap+fotoPad : 0;

      // ── Calcular contenido columna izquierda ──
      doc.setFont('helvetica','normal'); doc.setFontSize(9);
      const obsLines = c.observaciones ? doc.splitTextToSize(c.observaciones, descColW-6) : [];
      const obsH = obsLines.length ? obsLines.length*5+6 : 0;
      const _czItems = (c.items||[]).filter(it=>it.precio!=null||it.concepto||it.producto);
      const tblHdrH=7, tblRowH=9;
      const tableH = _czItems.length ? tblHdrH+_czItems.length*tblRowH : 0;
      const descContentH = obsH + tableH;

      const bkRH=10, bkTotalH=bkRH*3, tLightH=bkTotalH-11;
      // Cuando hay fotos, el banco y el total deben quedarse dentro de la columna de descripción
      const _totalAvailW = _fotosArr.length ? descColW : cW;
      const tW=_totalAvailW*0.56, bkW=_totalAvailW*0.40, gap=_totalAvailW-tW-bkW;
      const textH = Math.max(14, 4+descContentH);
      const leftNeedH = textH + 4 + bkTotalH;
      const dbH = Math.max(leftNeedH, minFotoBodyH);

      // ── Encabezado negro ──
