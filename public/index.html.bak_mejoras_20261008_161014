function _enviarOCWhatsApp(id) {
  const oc = (db.ordenesCompra||[]).find(o => o.id === id);
  if (!oc) return;
  const total = oc.total || (oc.items||[]).reduce((s,i)=>s+(i.cantidad*i.precioUnitario),0) || 0;
  const linea = '——————————————————————————';
  const itemsLines = (oc.items||[]).map(i=>`• ${i.descripcion}  x${i.cantidad} — $${fmt(i.cantidad*i.precioUnitario)}`).join('\n');
  const msg = encodeURIComponent(
    `*ORDEN DE COMPRA ${_ocFolio(oc)}*\n` +
    `*Campers La Cuesta*\n` +
    `${linea}\n` +
    `*Proveedor:* ${oc.proveedor||'—'}\n` +
    `*Fecha:* ${fechaLarga(oc.fecha)}\n` +
    (oc.fechaEntrega ? `*Entrega estimada:* ${fechaLarga(oc.fechaEntrega)}\n` : '') +
    `*Estado:* ${oc.estado||'Borrador'}\n` +
    `${linea}\n` +
    `*ARTÍCULOS*\n` +
    `${itemsLines}\n` +
    `${linea}\n` +
    `*TOTAL: $${fmt(total)}*\n` +
    (oc.notas ? `\n_Notas: ${oc.notas}_\n` : '') +
    `\n${linea}\n` +
    `*Campers La Cuesta*\n` +
    `Crucero Arandas #900, Col. el Crucero de Arandas\n` +
    `Tepatitlán, Jalisco, México\n` +
    `Tel: 378-70-100-90  ·  WhatsApp: 378-710-5467`
  );
  const _abrirWA = (telFinal) => {
    const url = telFinal ? `https://wa.me/${telFinal}?text=${msg}` : `https://wa.me/?text=${msg}`;
    window.open(url, '_blank');
  };
  // Buscar contacto: primero en el OC, luego en db.proveedores
  const _provOCNombre = (oc.proveedor||'').toLowerCase();
  const provObj = (db.proveedores||[]).find(p => (p.nombre||'').toLowerCase() === _provOCNombre);
  const telGuardado = _limpiarTel(oc.provWhatsApp || provObj?.whatsapp || '');
  const telConLada = telGuardado.length === 10 ? '52' + telGuardado : telGuardado;
  if (telConLada.length >= 10) {
    // Tiene número guardado → abrir directo
    _abrirWA(telConLada);
  } else {
    // Sin número → pedir igual que cotizaciones
    window._ocWAProvNombre = oc.proveedor || '';
    showModal('📱 WhatsApp del proveedor', `
      <p style="color:#64748b;margin-bottom:12px">El proveedor <strong>${esc(oc.proveedor||'—')}</strong> no tiene número registrado.</p>
      <div class="form-group">
        <label>Número de WhatsApp</label>
        <input id="oc-wa-tel" type="tel" placeholder="Ej. 3781234567"
          style="font-size:1.1rem;letter-spacing:2px"
          oninput="this.value=this.value.replace(/[^0-9]/g,'')"
          maxlength="10" />
        <small style="color:#94a3b8">10 dígitos sin lada de país. Se agrega México (+52) automáticamente.</small>
      </div>
      <label style="display:flex;align-items:center;gap:8px;margin-top:8px;font-size:0.85rem;cursor:pointer">
        <input type="checkbox" id="oc-wa-guardar" checked /> Guardar para este proveedor
      </label>
    `, [
      { label: '💬 Abrir WhatsApp', cls: 'btn-primary', action: () => {
        const numLimpio = _limpiarTel(document.getElementById('oc-wa-tel')?.value || '');
        const numFinal = numLimpio.length === 10 ? '52' + numLimpio : numLimpio;
        const guardar = document.getElementById('oc-wa-guardar')?.checked;
        if (guardar && numLimpio) {
          const nLow = window._ocWAProvNombre.toLowerCase();
          const existing = (db.proveedores||[]).find(p => (p.nombre||'').toLowerCase() === nLow);
          if (existing) { existing.whatsapp = numLimpio; }
          else { db.proveedores = db.proveedores||[]; db.proveedores.push({ id:sid(), nombre:window._ocWAProvNombre, whatsapp:numLimpio }); }
          saveDb('proveedores');
        }
