  const t = document.createElement('div');
  const isOk = !color || color === '#16a34a';
  const isWarn = color === '#d97706' || color === '#92400e';
  const isErr = color === '#dc2626';
  t.className = 'gp-toast' + (isOk ? ' ok' : isWarn ? ' warn' : isErr ? ' error' : '');
  if (!isOk && !isWarn && !isErr && color) t.style.background = color;
  t.innerHTML = `<span style="flex:1">${esc(String(msg))}</span><button class="gp-toast-close" onclick="this.closest('.gp-toast').remove()">✕</button>`;
