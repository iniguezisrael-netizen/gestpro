function _aplicarDescuento(id, autorizadoPor) {
  const vt = findById(db.ventas, id);
  if (!vt) return;
  const tipo = document.getElementById('desc-tipo')?.value || 'monto';
  const val = +document.getElementById('desc-valor')?.value || 0;
  const motivo = document.getElementById('desc-motivo')?.value?.trim() || '';
  if (!val || val <= 0) { _info('Ingresa un monto o porcentaje válido'); return; }
  const totalActual = vt.total || 0;
  const monto = tipo === 'pct' ? Math.round(totalActual * val / 100 * 100) / 100 : val;
  if (monto >= totalActual) { _info('El descuento no puede ser igual o mayor al total actual'); return; }

  // Guardar totalOriginal en el primer descuento
  if (!vt.totalOriginal) vt.totalOriginal = totalActual;

  const ahora = new Date();
  if (!vt.descuentos) vt.descuentos = [];
  vt.descuentos.push({
    monto,
    tipo,
    ...(tipo === 'pct' ? { porcentaje: val } : {}),
    motivo,
    fecha: ahora.toISOString().slice(0, 10),
    hora: ahora.toTimeString().slice(0, 5),
    autorizadoPor,
    aplicadoPor: session.nombre
  });

  // Recalcular total con todos los descuentos acumulados
  vt.total = Math.max(0, vt.totalOriginal - vt.descuentos.reduce((s, d) => s + d.monto, 0));

  // Recalcular saldo pendiente (anticipo ya es la suma acumulada de pagos)
  vt.saldo = Math.max(0, vt.total - (vt.anticipo || 0));
  if (vt.saldo <= 0 && vt.estado !== 'Cancelada') vt.estado = 'Pagada';

  saveDb('ventas');
  closeModal();
  renderVentas();
  _ok(`✅ Descuento de $${fmt(monto)} aplicado. Nuevo total: $${fmt(vt.total)}`);
}
window['_aplicarDescuento'] = _aplicarDescuento;

function _aplicarCredito(id) {
  const vt = findById(db.ventas, id);
  if (!vt) return;
  // Evitar duplicados: verificar que no exista ya un registro de cobranza para esta venta
  if (vt.cobranzaId || (db.cobranza||[]).some(c => String(c.ventaId) === String(id))) {
    closeModal();
    showToast('⚠️ Este pedido ya tiene un registro en Cobranza');
    renderVentas();
    return;
  }
  const saldo = vt.saldo != null ? vt.saldo : Math.max(0, vt.total - (vt.anticipo||0));
  const yaPagado = Math.max(0, vt.total - saldo);
  const credito = document.getElementById('oc-credito')?.value.trim() || '';
  const encargado = document.getElementById('oc-encargado')?.value.trim() || '';
  const tel = document.getElementById('oc-tel')?.value.trim() || '';
  const folioDefault = vt.folioPedido || 'PED-' + String(vt.id).padStart(5,'0');
  const pedido = document.getElementById('oc-pedido')?.value.trim() || folioDefault;

  const cobId = sid();
  db.cobranza.push({
    id: cobId,
    cliente: vt.cliente,
    encargado: encargado || vt.usuario || session.nombre,
    tel,
    pedido,
    folioPedido: vt.folioPedido || '',
    ventaId: vt.id,
    fecha: today(),
    total: vt.total,
    credito,
    estado: 'Pendiente',
    recFecha: '',
    recNota: '',
    recHecho: false,
    abonos: yaPagado > 0 ? [{ monto: yaPagado, fecha: today(), nota: 'Anticipo del pedido (previo a cobranza)' }] : [],
    usuario: session.nombre
  });
  vt.cobranzaId = cobId;
  vt.estado = 'Entregado';
  autorizarCreditoCliente(_vtNombreCredito(vt));
  save('gp_clientesCredito', db.clientesCredito);
  fsWriteCollection('clientesCredito', db.clientesCredito).catch(e => console.warn('[credito] Error Firestore:', e));
  saveDb(['ventas','cobranza']); closeModal(); renderVentas();
  _info('✅ Crédito otorgado. El pedido ' + pedido + ' se marcó como Entregado y se envió a Cobranza.');
}
window['_aplicarCredito'] = _aplicarCredito;


